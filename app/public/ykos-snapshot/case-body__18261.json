color: #fff; background: #102169; }\n.case-role-value { padding: 5px 9px; color: #102169; background: #f3f6ff; }\n.case-summary-table { width: 100%; border-collapse: collapse; table-layout: fixed; font-size: 15px; }\n.case-summary-label, .case-summary-value { border-top: 1px solid #e5eaf3; padding: 11px 0; vertical-align: top; text-align: left; }\n.case-summary-row-first { border-top: 0; }\n.case-summary-label { width: 118px; color: #1a2744; font-weight: 800; }\n.case-summary-value { color: #374151; font-weight: 600; }\n.toc { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: 24px 32px; margin-bottom: 20px; }\n.toc-title { font-size: 11px; font-weight: 700; letter-spacing: 2px; color: #9ca3af; text-transform: uppercase; margin-bottom: 14px; }\n.toc-list { list-style: none; padding: 0; margin: 0; }\n.toc-item { margin-bottom: 8px; font-size: 16px; }\n.toc-link { color: #102169; font-weight: 600; text-decoration: none; }\n.toc .toc-sub { margin: 4px 0 0 18px; }\n.toc .toc-sub .toc-link { color: #4b5563; font-size: 15px; font-weight: 400; }\n.section { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: 36px 40px; margin-bottom: 20px; }\n.section-title { color: #1a2744; font-size: 22px; font-weight: 700; line-height: 1.4; margin: 0 0 18px; }\n.subsection-title { color: #2d4a8a; font-size: 18px; font-weight: 700; line-height: 1.4; margin: 24px 0 10px; }\n.case-text { color: #374151; font-size: 17px; margin: 0 0 14px; }\n.case-list { list-style-type: disc; padding-left: 1.5rem; margin: 10px 0 14px; }\n.case-list-item { color: #374151; margin-bottom: 6px; font-weight: 800; }\n.assistance-highlight { background: linear-gradient(transparent 58%, #fde68a 58%); padding: 0 2px; font-weight: 800; color: #1f2937; }\n.public-text-issue { background: #fee2e2; color: #991b1b; border: 1px solid #ef4444; border-radius: 4px; box-shadow: 0 0 0 2px rgba(239, 68, 68, 0.16); padding: 0 3px; font-weight: 900; }\n.ref-box, .def-box, .qna-box, .order-box { background: #f9fafb; border-left: 4px solid #102169; border-radius: 4px; padding: 16px 20px; margin: 16px 0; font-size: 15px; }\n.case-table { width: 100%; border-collapse: collapse; margin: 16px 0 20px; font-size: 15px; table-layout: fixed; }\n.case-table-head, .case-table-cell { border: 1px solid #dbe1ee; padding: 10px 12px; vertical-align: top; word-break: keep-all; }\n.case-table-head { background: #f3f6fb; color: #1a2744; font-weight: 700; }\n.assistance-image { margin: 24px 0 4px; aspect-ratio: 16 / 9; overflow: hidden; border-radius: 8px; border: 1px solid #e5e7eb; }\n.assistance-image-img { display: block; width: 100%; height: 100%; object-fit: cover; border: 0; }\n.result-cta { background: #15266f; border-radius: 8px; padding: 28px 36px; margin-top: 28px; margin-bottom: 0; color: #fff; }\n.result-cta-text { color: #fff; font-size: 16px; font-weight: 700; line-height: 1.65; margin: 0 0 20px; }\n.result-cta-button { display: inline-block; background: #fff; color: #15266f; text-decoration: none; font-size: 15px; font-weight: 800; padding: 12px 22px; border-radius: 7px; }\n.result-cta + .tags { margin-top: 40px; }\n.footer-note { text-align: center; font-size: 14px; color: #9ca3af; padding: 20px 24px 40px; margin: 0; }\n@page { margin: 12mm; }\n/* 모바일만: 좌우 여백을 살짝 줄여 본문 폭 확보. PC 레이아웃은 유지. */\n@media (max-width: 720px) {\n  .preview-header { padding: 28px 18px; }\n  .preview-container { padding: 20px 12px 56px; }\n  .section { padding: 26px 16px; }\n  .section-title { font-size: 20px; }\n  .subsection-title { font-size: 17px; }\n  .case-text { font-size: 16px; }\n  .toc { padding: 18px 16px; }\n  .case-summary-card { padding: 18px 16px; }\n  .case-summary-table { font-size: 14px; }\n  .case-summary-label { width: 96px; }\n  .ref-box, .def-box, .qna-box, .order-box { padding: 14px 14px; }\n  .result-cta { padding: 22px 18px; }\n}\n@media (max-width: 768px) {\n  .preview-header .preview-lead { font-size: 22px; line-height: 1.4; }\n}\n@media print {\n  .preview-result, .preview-result { background: #f8fafc !important; }\n  .preview-header, .result-cta, .case-role-label, .case-table-head, .tag, .case-role-value, .ref-box, .def-box, .qna-box, .order-box {\n    -webkit-print-color-adjust: exact !important;\n    print-color-adjust: exact !important;\n  }\n  .preview-container { padding-bottom: 40px; }\n  .section, .toc, .case-summary-card, .result-cta { break-inside: avoid; page-break-inside: avoid; }\n  .result-cta + .tags { margin-top: 42px; }\n}\n}</style><div data-embedded-case-html-root=\"\" class=\"\" style=\"display:block;width:100%;min-width:0;box-sizing:border-box;\">\n\n<article class=\"preview-result\">\n  <header class=\"preview-header\">\n    <div class=\"label\">YK SUCCESS CASE</div>\n    <p class=\"preview-lead\">의뢰인은 음주운전으로 벌금형을 받은 지 약 1년 만에 면허 없이 혈중알코올농도 수치 0.047% 상태로 약 17km를 운전해 음주운전과 무면허운전 혐의로 재판을 받았습니다.</p>\n  </header>\n  <main class=\"preview-container\">\n    <div class=\"lead\" id=\"section-overview\">\n<p class=\"case-text\">YK 담당 변호사는 의뢰인의 범행 인정과 반성, 혈중알코올농도 수치 등 양형에 고려될 사정을 중심으로 대응했으며, 의뢰인은 집행유예를 선고받았습니다.</p></div>\n    <section class=\"case-summary-card\" aria-label=\"사건 결과 요약\"><div class=\"case-summary-title\"><span>사건 결과 요약</span><span class=\"case-role-badges\"><span class=\"case-role-badge case-role-badge-client\"><span class=\"case-role-label\">의뢰인</span><span class=\"case-role-value\">피고인</span></span></span></div><table class=\"case-summary-table\"><tbody><tr><th class=\"case-summary-label case-summary-row-first\" scope=\"row\">사건 유형</th><td class=\"case-summary-value case-summary-row-first\">음주운전</td></tr><tr><th class=\"case-summary-label\" scope=\"row\">쟁점</th><td class=\"case-summary-value\">음주·무면허운전 재범에 따른 양형, 범행 인정과 반성의 참작, 혈중알코올농도 수치의 고려, 체류 관련 행정소송 진행 사정의 참작</td></tr><tr><th class=\"case-summary-label\" scope=\"row\">결과</th><td class=\"case-summary-value\">집행유예</td></tr><tr><th class=\"case-summary-label\" scope=\"row\">대응 포인트</th><td class=\"case-summary-value\">범행 인정과 반성, 혈중알코올농도 수치 및 진행 중인 소송 등 개별 양형 사유 소명</td></tr></tbody></table></section><div data-case-cta-slot=\"top\"></div>\n    <nav class=\"toc\"><div class=\"toc-title\">CONTENTS</div><ul class=\"toc-list\"><li class=\"toc-item\"><a class=\"toc-link\">무면허 상태에서 다시 적발된 음주운전</a></li><li class=\"toc-item\"><a class=\"toc-link\">음주운전 재범 처벌 수위와 양형요소</a><ul class=\"toc-list toc-sub\"><li class=\"toc-item\"><a class=\"toc-link\">처벌 수위와 적용 법령</a></li><li class=\"toc-item\"><a class=\"toc-link\">양형기준과 감경·가중요소</a></li></ul></li><li class=\"toc-item\"><a class=\"toc-link\">음주운전 재범 집행유예를 위한 YK 담당 변호사의 조력</a><ul class=\"toc-list toc-sub\"><li class=\"toc-item\"><a class=\"toc-link\">범행 인정과 반성의 태도를 선처 사유로 소명</a></li><li class=\"toc-item\"><a class=\"toc-link\">진행 중인 체류 관련 행정소송을 양형 사유로 정리</a></li></ul></li><li class=\"toc-item\"><a class=\"toc-link\">음주운전 사건 결과 : 집행유예</a></li></ul></nav>\n    <section class=\"section\" id=\"section-background\"><h2 class=\"section-title\">무면허 상태에서 다시 적발된 음주운전</h2><p class=\"case-text\">의뢰인은 음주운전으로 벌금형을 받은 지 약 1년 만에 다시 음주운전으로 적발되었습니다.</p>\n<p class=\"case-text\">당시 자동차운전면허가 없는 상태에서 혈중알코올농도 수치 0.047%로 약 17km를 운전했습니다.</p>\n<p class=\"case-text\">이번에는 <strong>음주운전 재범과 무면허운전이 함께 문제</strong> 되면서 재판을 받게 되었습니다.</p>\n<p class=\"case-text\">앞선 처벌 이력과 면허 없이 운전한 사실까지 고려해야 하는 상황이었습니다.</p>\n<p class=\"case-text\">의뢰인은 재판에서 사건 경위와 양형에 고려될 사정을 설명하고 법적 조력을 받기 위해 YK 담당 변호사를 찾았습니다.</p><figure class=\"assistance-image\"><img class=\"assistance-image-img\" src=\"https://www.yklawfirm.co.kr/ai_case/18261/508da4d540c6505f.webp\" alt=\"음주운전 재범과 무면허운전으로 집행유예 대응이 필요했던 의뢰인\"></figure></section><section class=\"section\" id=\"section-info-1\"><h2 class=\"section-title\">음주운전 재범 처벌 수위와 양형요소</h2><section id=\"section-info-1-sub-1\"><h3 class=\"subsection-title\">처벌 수위와 적용 법령</h3><p class=\"case-text\">음주운전으로 벌금 이상의 형을 받고 그 형이 확정된 날부터 <strong>10년 안에 다시 음주운전을 하면 재범 가중처벌 대상</strong>이 됩니다. 도로교통법 제148조의2 제1항에 따라 혈중알코올농도 수치에 맞는 처벌 규정이 적용됩니다.</p>\n<table class=\"case-table\"><thead><tr><th class=\"case-table-head\">재범 혈중알코올농도 수치</th><th class=\"case-table-head\">처벌 수위</th></tr></thead><tbody><tr><td class=\"case-table-cell\">0.2% 이상</td><td class=\"case-table-cell\">2년 이상 6년 이하 징역 또는 1천만 원 이상 3천만 원 이하 벌금</td></tr><tr><td class=\"case-table-cell\">0.03% 이상 0.2% 미만</td><td class=\"case-table-cell\">1년 이상 5년 이하 징역 또는 500만 원 이상 2천만 원 이하 벌금</td></tr></tbody></table>\n<div class=\"ref-box\"><span class=\"ref-title\">관련 쟁점은 <strong><a rel=\"noopener noreferrer\">음주운전 2회 처벌 기준｜초범과 달라지는 형량·행정처분 가이드</a></strong>에서 확인하실 수 있습니다.</span><span class=\"ref-body\"></span></div>\n<p class=\"case-text\">이 사건의 혈중알코올농도 수치는 0.047%였습니다. 앞선 음주운전 벌금형이 확정된 뒤 약 1년 만에 다시 적발되어, 0.03% 이상 0.2% 미만 구간이 적용되었습니다.</p>\n<p class=\"case-text\">무면허운전에는 도로교통법 제43조와 제152조 제1호도 적용되었습니다. 한 번의 운전이 두 범죄에 동시에 해당하므로, 형법 제40조와 제50조에 따라 더 무거운 죄의 형으로 처벌하는 방식이 적용되었습니다.</p></section><section id=\"section-info-1-sub-2\"><h3 class=\"subsection-title\">양형기준과 감경·가중요소</h3><p class=\"case-text\">재범 사건에서는 혈중알코올농도 수치만으로 형량을 판단하지 않습니다. <strong>이전 처벌 이후 재범까지의 기간과 음주운전 이력</strong>이 중요합니다. 범행 경위와 운전으로 발생한 위험, 범행 후 태도도 함께 살핍니다.</p>\n<table class=\"case-table\"><thead><tr><th class=\"case-table-head\">구분</th><th class=\"case-table-head\">감경요소</th><th class=\"case-table-head\">가중요소</th></tr></thead><tbody><tr><td class=\"case-table-cell\">행위</td><td class=\"case-table-cell\">참작할 범행 경위, 낮은 도로교통상 위험</td><td class=\"case-table-cell\">높은 도로교통상 위험</td></tr><tr><td class=\"case-table-cell\">행위자·기타</td><td class=\"case-table-cell\">진지한 반성</td><td class=\"case-table-cell\">음주운전 이력, 증거은폐 또는 시도</td></tr></tbody></table>\n<p class=\"case-text\">이 사건에서는 음주운전으로 벌금형을 받고 약 1년 만에 다시 범행한 점이 불리하게 고려되어 징역형이 선택되었습니다.</p>\n<p class=\"case-text\">반면 범행을 인정하고 반성한 태도와 혈중알코올농도 수치가 매우 높지는 않았던 점은 유리한 사정으로 고려되었습니다. 이는 음주운전의 위험성이 없다는 뜻은 아닙니다. 법원은 의뢰인의 연령과 생활환경, 범행 경위와 이후 정황 등을 함께 살펴 형량과 집행유예 여부를 판단했습니다.</p></section></section><section class=\"section\" id=\"section-assistance\"><h2 class=\"section-title\">음주운전 재범 집행유예를 위한 YK 담당 변호사의 조력</h2><section id=\"section-assistance-sub-1\"><h3 class=\"subsection-title\">범행 인정과 반성의 태도를 선처 사유로 소명</h3><p class=\"case-text\">YK 담당 변호사는 벌금형을 받은 지 약 1년 만에 무면허 상태로 음주운전을 한 점을 불리한 사정으로 짚고, 의뢰인이 법정에서 범행을 인정하고 반성하는 태도를 보인 점을 선처 사유로 주장했습니다. 음주운전 단속결과에 나타난 혈중알코올농도 수치 0.047%도 함께 제시하며, <mark class=\"assistance-highlight\"><strong>재범 사실뿐 아니라 범행 후 태도와 혈중알코올농도 수치도 형량 결정에 고려되도록</strong></mark> 조력했습니다.</p></section><section id=\"section-assistance-sub-2\"><h3 class=\"subsection-title\">진행 중인 체류 관련 행정소송을 양형 사유로 정리</h3><p class=\"case-text\">YK 담당 변호사는 의뢰인의 체류 관련 행정소송이 진행 중이라는 점을 확인하고, 이를 의뢰인의 처지와 환경을 보여주는 양형 사유로 주장했습니다. 난민으로 인정하지 않은 처분을 다투는 소송 자체가 음주운전의 책임을 줄이는 것은 아니지만, <mark class=\"assistance-highlight\"><strong>형량을 정할 때 함께 살펴야 할 개인적 사정</strong></mark>으로 참작을 구했습니다. 범행의 책임을 판단하는 문제와 의뢰인의 현재 상황을 고려하는 문제를 구분해 전달하는 데 중점을 두었습니다.</p></section></section><section class=\"section\" id=\"section-result\"><h2 class=\"section-title\">음주운전 사건 결과 : 집행유예</h2><p class=\"case-text\">법원은 다음 사정을 참작해 의뢰인에게 <strong>징역 10개월에 집행유예 2년을 선고했습니다.</strong></p>\n<div class=\"circled-result\"><p class=\"case-text\">① <strong>의뢰인이 범행을 인정하고 반성하는 모습을 보인 점</strong></p><p class=\"case-text\">② <strong>혈중알코올농도 수치가 0.047%로 매우 높지는 않았던 점</strong></p><p class=\"case-text\">③ <strong>체류 관련 행정소송이 진행 중이었던 점</strong></p></div>\n<p class=\"case-text\">법원은 같은 범죄로 처벌받은 뒤 1년 남짓 지나 재범한 점을 불리하게 보면서도, 형을 정하는 과정에서 범행 인정과 반성의 태도, 진행 중인 소송 등 개별 사정을 함께 고려했습니다.</p>\n<p class=\"case-text\"></p></section>\n    \n    <div class=\"tags\"><span class=\"tag\">음주운전</span><span class=\"tag\">무면허운전</span><span class=\"tag\">음주운전재범</span><span class=\"tag\">집행유예</span><span class=\"tag\">형사</span></div>\n  </main>\n</article>\n\n\n  \n\n</div>"}