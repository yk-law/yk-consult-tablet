olor: #fff; background: #102169; }\n.case-role-value { padding: 5px 9px; color: #102169; background: #f3f6ff; }\n.case-summary-table { width: 100%; border-collapse: collapse; table-layout: fixed; font-size: 15px; }\n.case-summary-label, .case-summary-value { border-top: 1px solid #e5eaf3; padding: 11px 0; vertical-align: top; text-align: left; }\n.case-summary-row-first { border-top: 0; }\n.case-summary-label { width: 118px; color: #1a2744; font-weight: 800; }\n.case-summary-value { color: #374151; font-weight: 600; }\n.toc { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: 24px 32px; margin-bottom: 20px; }\n.toc-title { font-size: 11px; font-weight: 700; letter-spacing: 2px; color: #9ca3af; text-transform: uppercase; margin-bottom: 14px; }\n.toc-list { list-style: none; padding: 0; margin: 0; }\n.toc-item { margin-bottom: 8px; font-size: 16px; }\n.toc-link { color: #102169; font-weight: 600; text-decoration: none; }\n.toc .toc-sub { margin: 4px 0 0 18px; }\n.toc .toc-sub .toc-link { color: #4b5563; font-size: 15px; font-weight: 400; }\n.section { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: 36px 40px; margin-bottom: 20px; }\n.section-title { color: #1a2744; font-size: 22px; font-weight: 700; line-height: 1.4; margin: 0 0 18px; }\n.subsection-title { color: #2d4a8a; font-size: 18px; font-weight: 700; line-height: 1.4; margin: 24px 0 10px; }\n.case-text { color: #374151; font-size: 17px; margin: 0 0 14px; }\n.case-list { list-style-type: disc; padding-left: 1.5rem; margin: 10px 0 14px; }\n.case-list-item { color: #374151; margin-bottom: 6px; font-weight: 800; }\n.assistance-highlight { background: linear-gradient(transparent 58%, #fde68a 58%); padding: 0 2px; font-weight: 800; color: #1f2937; }\n.public-text-issue { background: #fee2e2; color: #991b1b; border: 1px solid #ef4444; border-radius: 4px; box-shadow: 0 0 0 2px rgba(239, 68, 68, 0.16); padding: 0 3px; font-weight: 900; }\n.ref-box, .def-box, .qna-box, .order-box { background: #f9fafb; border-left: 4px solid #102169; border-radius: 4px; padding: 16px 20px; margin: 16px 0; font-size: 15px; }\n.case-table { width: 100%; border-collapse: collapse; margin: 16px 0 20px; font-size: 15px; table-layout: fixed; }\n.case-table-head, .case-table-cell { border: 1px solid #dbe1ee; padding: 10px 12px; vertical-align: top; word-break: keep-all; }\n.case-table-head { background: #f3f6fb; color: #1a2744; font-weight: 700; }\n.assistance-image { margin: 24px 0 4px; aspect-ratio: 16 / 9; overflow: hidden; border-radius: 8px; border: 1px solid #e5e7eb; }\n.assistance-image-img { display: block; width: 100%; height: 100%; object-fit: cover; border: 0; }\n.result-cta { background: #15266f; border-radius: 8px; padding: 28px 36px; margin-top: 28px; margin-bottom: 0; color: #fff; }\n.result-cta-text { color: #fff; font-size: 16px; font-weight: 700; line-height: 1.65; margin: 0 0 20px; }\n.result-cta-button { display: inline-block; background: #fff; color: #15266f; text-decoration: none; font-size: 15px; font-weight: 800; padding: 12px 22px; border-radius: 7px; }\n.result-cta + .tags { margin-top: 40px; }\n.footer-note { text-align: center; font-size: 14px; color: #9ca3af; padding: 20px 24px 40px; margin: 0; }\n@page { margin: 12mm; }\n/* 모바일만: 좌우 여백을 살짝 줄여 본문 폭 확보. PC 레이아웃은 유지. */\n@media (max-width: 720px) {\n  .preview-header { padding: 28px 18px; }\n  .preview-container { padding: 20px 12px 56px; }\n  .section { padding: 26px 16px; }\n  .section-title { font-size: 20px; }\n  .subsection-title { font-size: 17px; }\n  .case-text { font-size: 16px; }\n  .toc { padding: 18px 16px; }\n  .case-summary-card { padding: 18px 16px; }\n  .case-summary-table { font-size: 14px; }\n  .case-summary-label { width: 96px; }\n  .ref-box, .def-box, .qna-box, .order-box { padding: 14px 14px; }\n  .result-cta { padding: 22px 18px; }\n}\n@media (max-width: 768px) {\n  .preview-header .preview-lead { font-size: 22px; line-height: 1.4; }\n}\n@media print {\n  .preview-result, .preview-result { background: #f8fafc !important; }\n  .preview-header, .result-cta, .case-role-label, .case-table-head, .tag, .case-role-value, .ref-box, .def-box, .qna-box, .order-box {\n    -webkit-print-color-adjust: exact !important;\n    print-color-adjust: exact !important;\n  }\n  .preview-container { padding-bottom: 40px; }\n  .section, .toc, .case-summary-card, .result-cta { break-inside: avoid; page-break-inside: avoid; }\n  .result-cta + .tags { margin-top: 42px; }\n}\n}</style><div data-embedded-case-html-root=\"\" class=\"\" style=\"display:block;width:100%;min-width:0;box-sizing:border-box;\">\n\n<article class=\"preview-result\">\n  <header class=\"preview-header\">\n    <div class=\"label\">YK SUCCESS CASE</div>\n    <p class=\"preview-lead\">임대인은 의뢰인이 임차 건물에 무단공사를 해 하자가 발생했다며 손해배상을 청구했습니다. YK 담당 변호사는 무단공사와 하자 발생 사실을 뒷받침할 증거가 부족하다는 점을 다투었고, 법원은 원고의 청구를 모두 기각했습니다.</p>\n  </header>\n  <main class=\"preview-container\">\n    <section class=\"case-summary-card\" aria-label=\"사건 결과 요약\"><div class=\"case-summary-title\"><span>사건 결과 요약</span><span class=\"case-role-badges\"><span class=\"case-role-badge case-role-badge-client\"><span class=\"case-role-label\">의뢰인</span><span class=\"case-role-value\">피고</span></span></span></div><table class=\"case-summary-table\"><tbody><tr><th class=\"case-summary-label case-summary-row-first\" scope=\"row\">사건 유형</th><td class=\"case-summary-value case-summary-row-first\">손해배상</td></tr><tr><th class=\"case-summary-label\" scope=\"row\">쟁점</th><td class=\"case-summary-value\">무단공사 여부, 건물 하자 발생 여부, 무단공사 하자 손해배상 청구의 증명 부족</td></tr><tr><th class=\"case-summary-label\" scope=\"row\">결과</th><td class=\"case-summary-value\">(전부)승소</td></tr><tr><th class=\"case-summary-label\" scope=\"row\">대응 포인트</th><td class=\"case-summary-value\">무단공사와 하자 발생에 관한 원고 측 증거 부족을 집중 반박</td></tr></tbody></table></section><div data-case-cta-slot=\"top\"></div>\n    <nav class=\"toc\"><div class=\"toc-title\">CONTENTS</div><ul class=\"toc-list\"><li class=\"toc-item\"><a class=\"toc-link\">무단공사와 하자 발생을 이유로 한 무단공사 하자 손해배상 청구</a></li><li class=\"toc-item\"><a class=\"toc-link\">무단공사 하자 손해배상 청구에서 공사·하자 사실 입증의 중요성</a><ul class=\"toc-list toc-sub\"><li class=\"toc-item\"><a class=\"toc-link\">임차인의 공사·훼손 책임과 인과관계, 무단공사와 하자 발생의 입증 자료</a></li></ul></li><li class=\"toc-item\"><a class=\"toc-link\">무단공사 하자 손해배상 청구 기각을 이끈 YK 담당 변호사의 대응</a><ul class=\"toc-list toc-sub\"><li class=\"toc-item\"><a class=\"toc-link\">무단공사와 하자 발생 주장 반박</a></li><li class=\"toc-item\"><a class=\"toc-link\">원고 제출 증거의 부족함 지적</a></li></ul></li><li class=\"toc-item\"><a class=\"toc-link\">손해배상 사건 결과 : (전부)승소</a></li></ul></nav>\n    <section class=\"section\" id=\"section-background\"><h2 class=\"section-title\">무단공사와 하자 발생을 이유로 한 무단공사 하자 손해배상 청구</h2><p class=\"case-text\">의뢰인은 임차해 사용하던 건물과 관련해 임대인으로부터 무단공사 하자 손해배상 청구를 받았습니다.</p>\n<p class=\"case-text\">임대인은 의뢰인이 건물에 허가 없이 공사를 진행했고, 그로 인해 하자가 생겼다고 주장했습니다.</p>\n<p class=\"case-text\">이어 하자로 인한 손해를 배상하라는 소송을 제기했습니다.</p>\n<p class=\"case-text\">의뢰인은 무단공사와 하자 발생 주장을 그대로 받아들이기 어려웠습니다.</p>\n<p class=\"case-text\">청구가 인정되면 금전 지급 책임을 부담할 수 있는 상황이었기에, 소송에서 사실관계를 분명히 밝힐 필요가 있었습니다.</p>\n<p class=\"case-text\">이에 의뢰인은 청구 내용과 상대방이 제출한 자료를 검토받기 위해 YK 담당 변호사를 찾았습니다.</p><figure class=\"assistance-image\"><img class=\"assistance-image-img\" src=\"https://www.yklawfirm.co.kr/ai_case/15384/5dac2beb6aa06a60.webp\" alt=\"무단공사 하자 주장으로 무단공사 하자 손해배상 청구를 받은 민사 대응\"></figure></section><section class=\"section\" id=\"section-info-1\"><h2 class=\"section-title\">무단공사 하자 손해배상 청구에서 공사·하자 사실 입증의 중요성</h2><section id=\"section-info-1-sub-1\"><h3 class=\"subsection-title\">임차인의 공사·훼손 책임과 인과관계, 무단공사와 하자 발생의 입증 자료</h3><p class=\"case-text\">임차인의 공사나 훼손으로 임차 건물에 손해가 발생하면 임차인에게 손해배상 책임이 문제될 수 있습니다. 이때는 공사나 훼손 행위, 실제 손해의 발생, 그 행위와 손해 사이의 인과관계를 살펴야 합니다.</p>\n<div class=\"ref-box\"><span class=\"ref-title\">이 사건과 구별되는 도급계약상 대금 청구에 관한 안내는 <strong><a rel=\"noopener noreferrer\">공사대금 못 받았을 때 해결 방법 총정리 (절차·비용·기간)</a></strong>에서 확인하실 수 있습니다.</span><span class=\"ref-body\"></span></div>\n<p class=\"case-text\">손해배상을 청구하려면, 상대방에게 배상 책임이 발생했다는 사실이 먼저 확인되어야 합니다. 공사의 내용과 범위, 누가 공사를 했는지, 계약 또는 허가 없이 진행됐는지, 공사로 실제 하자가 생겼는지가 핵심입니다.</p>\n<p class=\"case-text\">임대인이 임차인을 상대로 무단공사로 인한 하자의 손해배상을 청구하는 경우에도 마찬가지입니다. 단순히 건물에 문제가 발생했다는 주장만으로는 부족합니다. 임차인이 무단으로 공사했고, 그 공사 때문에 특정 하자가 발생했다는 점이 뒷받침되어야 합니다.</p>\n<p class=\"case-text\">이 사건에서 법원은 임대인이 낸 자료만으로는 <strong>의뢰인이 무단공사를 했거나 그로 인해 건물 하자가 발생했다는 사실을 인정하기 어렵다</strong>고 판단했습니다. 결국 공사와 하자의 연결관계가 충분히 입증되지 않아, 금전 지급을 구한 청구는 받아들여지지 않았습니다.</p></section></section><section class=\"section\" id=\"section-assistance\"><h2 class=\"section-title\">무단공사 하자 손해배상 청구 기각을 이끈 YK 담당 변호사의 대응</h2><section id=\"section-assistance-sub-1\"><h3 class=\"subsection-title\">무단공사와 하자 발생 주장 반박</h3><p class=\"case-text\">YK 담당 변호사는 상대방이 주장한 <mark class=\"assistance-highlight\"><strong>무단공사와 건물 하자 발생 사실이 실제로 인정될 수 있는지</strong></mark>에 초점을 맞췄습니다. 상대방이 낸 자료만으로는 의뢰인이 허가 없이 공사했고, 그 공사 때문에 건물에 하자가 생겼다고 보기 어렵다는 점을 다퉜습니다.</p></section><section id=\"section-assistance-sub-2\"><h3 class=\"subsection-title\">원고 제출 증거의 부족함 지적</h3><p class=\"case-text\">또한 손해배상을 청구하려면 청구의 근거가 되는 사실이 확인되어야 한다고 강조했습니다. <mark class=\"assistance-highlight\"><strong>상대방 자료의 증명 부족을 지적해, 의뢰인에게 손해배상 책임이 인정되는 것을 막는 데 주력했습니다.</strong></mark></p></section></section><section class=\"section\" id=\"section-result\"><h2 class=\"section-title\">손해배상 사건 결과 : (전부)승소</h2><p class=\"case-text\">법원은 상대방의 무단공사 하자 손해배상 청구를 <strong>전부 기각</strong>했습니다.</p>\n<div class=\"circled-result\"><p class=\"case-text\">① <strong>상대방이 제출한 자료만으로는 의뢰인이 임차 건물에 무단공사를 했다고 인정하기 어려운 점</strong></p><p class=\"case-text\">② <strong>해당 공사로 건물에 하자가 발생했다는 사실도 확인하기 어려운 점</strong></p></div>\n<p class=\"case-text\">그 결과 의뢰인은 상대방이 청구한 손해배상금을 지급하지 않게 되었고, <strong>소송비용도 상대방이 부담</strong>하게 됐습니다. 이번 사건은 무단공사와 하자 발생을 주장하는 측이 그 사실을 뒷받침할 자료를 제시하지 못하면 그에 따른 손해배상 청구가 받아들여지기 어렵다는 점을 보여줍니다.</p>\n<p class=\"case-text\"></p></section>\n    \n    <div class=\"tags\"><span class=\"tag\">공사대금</span><span class=\"tag\">손해배상소송</span><span class=\"tag\">무단공사</span><span class=\"tag\">청구기각</span><span class=\"tag\">민사</span><span class=\"tag\">손해배상</span></div>\n  </main>\n</article>\n\n\n  \n\n</div>"}