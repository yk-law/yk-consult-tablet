5px 7px; color: #fff; background: #102169; }\n.case-role-value { padding: 5px 9px; color: #102169; background: #f3f6ff; }\n.case-summary-table { width: 100%; border-collapse: collapse; table-layout: fixed; font-size: 15px; }\n.case-summary-label, .case-summary-value { border-top: 1px solid #e5eaf3; padding: 11px 0; vertical-align: top; text-align: left; }\n.case-summary-row-first { border-top: 0; }\n.case-summary-label { width: 118px; color: #1a2744; font-weight: 800; }\n.case-summary-value { color: #374151; font-weight: 600; }\n.toc { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: 24px 32px; margin-bottom: 20px; }\n.toc-title { font-size: 11px; font-weight: 700; letter-spacing: 2px; color: #9ca3af; text-transform: uppercase; margin-bottom: 14px; }\n.toc-list { list-style: none; padding: 0; margin: 0; }\n.toc-item { margin-bottom: 8px; font-size: 16px; }\n.toc-link { color: #102169; font-weight: 600; text-decoration: none; }\n.toc .toc-sub { margin: 4px 0 0 18px; }\n.toc .toc-sub .toc-link { color: #4b5563; font-size: 15px; font-weight: 400; }\n.section { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: 36px 40px; margin-bottom: 20px; }\n.section-title { color: #1a2744; font-size: 22px; font-weight: 700; line-height: 1.4; margin: 0 0 18px; }\n.subsection-title { color: #2d4a8a; font-size: 18px; font-weight: 700; line-height: 1.4; margin: 24px 0 10px; }\n.case-text { color: #374151; font-size: 17px; margin: 0 0 14px; }\n.case-list { list-style-type: disc; padding-left: 1.5rem; margin: 10px 0 14px; }\n.case-list-item { color: #374151; margin-bottom: 6px; font-weight: 800; }\n.assistance-highlight { background: linear-gradient(transparent 58%, #fde68a 58%); padding: 0 2px; font-weight: 800; color: #1f2937; }\n.public-text-issue { background: #fee2e2; color: #991b1b; border: 1px solid #ef4444; border-radius: 4px; box-shadow: 0 0 0 2px rgba(239, 68, 68, 0.16); padding: 0 3px; font-weight: 900; }\n.ref-box, .def-box, .qna-box, .order-box { background: #f9fafb; border-left: 4px solid #102169; border-radius: 4px; padding: 16px 20px; margin: 16px 0; font-size: 15px; }\n.case-table { width: 100%; border-collapse: collapse; margin: 16px 0 20px; font-size: 15px; table-layout: fixed; }\n.case-table-head, .case-table-cell { border: 1px solid #dbe1ee; padding: 10px 12px; vertical-align: top; word-break: keep-all; }\n.case-table-head { background: #f3f6fb; color: #1a2744; font-weight: 700; }\n.assistance-image { margin: 24px 0 4px; aspect-ratio: 16 / 9; overflow: hidden; border-radius: 8px; border: 1px solid #e5e7eb; }\n.assistance-image-img { display: block; width: 100%; height: 100%; object-fit: cover; border: 0; }\n.result-cta { background: #15266f; border-radius: 8px; padding: 28px 36px; margin-top: 28px; margin-bottom: 0; color: #fff; }\n.result-cta-text { color: #fff; font-size: 16px; font-weight: 700; line-height: 1.65; margin: 0 0 20px; }\n.result-cta-button { display: inline-block; background: #fff; color: #15266f; text-decoration: none; font-size: 15px; font-weight: 800; padding: 12px 22px; border-radius: 7px; }\n.result-cta + .tags { margin-top: 40px; }\n.footer-note { text-align: center; font-size: 14px; color: #9ca3af; padding: 20px 24px 40px; margin: 0; }\n@page { margin: 12mm; }\n/* 모바일만: 좌우 여백을 살짝 줄여 본문 폭 확보. PC 레이아웃은 유지. */\n@media (max-width: 720px) {\n  .preview-header { padding: 28px 18px; }\n  .preview-container { padding: 20px 12px 56px; }\n  .section { padding: 26px 16px; }\n  .section-title { font-size: 20px; }\n  .subsection-title { font-size: 17px; }\n  .case-text { font-size: 16px; }\n  .toc { padding: 18px 16px; }\n  .case-summary-card { padding: 18px 16px; }\n  .case-summary-table { font-size: 14px; }\n  .case-summary-label { width: 96px; }\n  .ref-box, .def-box, .qna-box, .order-box { padding: 14px 14px; }\n  .result-cta { padding: 22px 18px; }\n}\n@media (max-width: 768px) {\n  .preview-header .preview-lead { font-size: 22px; line-height: 1.4; }\n}\n@media print {\n  .preview-result, .preview-result { background: #f8fafc !important; }\n  .preview-header, .result-cta, .case-role-label, .case-table-head, .tag, .case-role-value, .ref-box, .def-box, .qna-box, .order-box {\n    -webkit-print-color-adjust: exact !important;\n    print-color-adjust: exact !important;\n  }\n  .preview-container { padding-bottom: 40px; }\n  .section, .toc, .case-summary-card, .result-cta { break-inside: avoid; page-break-inside: avoid; }\n  .result-cta + .tags { margin-top: 42px; }\n}\n}</style><div data-embedded-case-html-root=\"\" class=\"\" style=\"display:block;width:100%;min-width:0;box-sizing:border-box;\">\n\n<article class=\"preview-result\">\n  <header class=\"preview-header\">\n    <div class=\"label\">YK SUCCESS CASE</div>\n    <p class=\"preview-lead\">회사원인 의뢰인은 묵시적으로 갱신된 주택 임대차계약의 해지를 통보했으나, 공동임대인들이 반환 약속을 지키지 않고 연락마저 원활하지 않아 보증금 약 1억 6,000만원을 돌려받지 못했습니다.</p>\n  </header>\n  <main class=\"preview-container\">\n    <div class=\"lead\" id=\"section-overview\">\n<p class=\"case-text\">YK 담당 변호사는 공동임대인들을 상대로 보증금 반환 소송을 진행해, 주택 인도와 동시에 보증금 전액을 공동으로 지급하고 인도 다음 날부터 지연손해금도 지급하도록 하는 전부승소 판결을 신속하게 받았습니다.</p></div>\n    <section class=\"case-summary-card\" aria-label=\"사건 결과 요약\"><div class=\"case-summary-title\"><span>사건 결과 요약</span><span class=\"case-role-badges\"><span class=\"case-role-badge case-role-badge-client\"><span class=\"case-role-label\">의뢰인</span><span class=\"case-role-value\">원고</span></span></span></div><table class=\"case-summary-table\"><tbody><tr><th class=\"case-summary-label case-summary-row-first\" scope=\"row\">사건 유형</th><td class=\"case-summary-value case-summary-row-first\">보증금</td></tr><tr><th class=\"case-summary-label\" scope=\"row\">쟁점</th><td class=\"case-summary-value\">묵시적 갱신 후 해지 통보에 따른 계약 종료, 공동임대인 모두의 보증금 반환의무, 장래 지연손해금 청구 필요성</td></tr><tr><th class=\"case-summary-label\" scope=\"row\">결과</th><td class=\"case-summary-value\">(전부)승소</td></tr><tr><th class=\"case-summary-label\" scope=\"row\">대응 포인트</th><td class=\"case-summary-value\">해지 통보에 따른 계약 종료와 공동임대인의 반환의무를 근거로 보증금 전액 및 지연손해금 청구</td></tr></tbody></table></section><div data-case-cta-slot=\"top\"></div>\n    <nav class=\"toc\"><div class=\"toc-title\">CONTENTS</div><ul class=\"toc-list\"><li class=\"toc-item\"><a class=\"toc-link\">해지 통보 후에도 돌려받지 못한 임대차보증금</a></li><li class=\"toc-item\"><a class=\"toc-link\">임대차보증금 반환을 위한 묵시적 갱신과 해지 기준</a><ul class=\"toc-list toc-sub\"><li class=\"toc-item\"><a class=\"toc-link\">계약 만료 후 묵시적 갱신은 언제 성립할까요?</a></li><li class=\"toc-item\"><a class=\"toc-link\">묵시적으로 갱신된 계약은 어떻게 해지하나요?</a></li></ul></li><li class=\"toc-item\"><a class=\"toc-link\">임대차보증금 전액 반환 판결을 이끌어 낸 YK 담당 변호사의 조력</a><ul class=\"toc-list toc-sub\"><li class=\"toc-item\"><a class=\"toc-link\">묵시적 갱신 후 해지 통보에 따른 계약 종료 주장</a></li><li class=\"toc-item\"><a class=\"toc-link\">공동임대인 모두의 보증금 반환의무 주장</a></li><li class=\"toc-item\"><a class=\"toc-link\">보증금 반환 지연에 대비한 장래 지연손해금 청구 근거 정리</a></li></ul></li><li class=\"toc-item\"><a class=\"toc-link\">보증금 사건 결과 : (전부)승소</a></li></ul></nav>\n    <section class=\"section\" id=\"section-background\"><h2 class=\"section-title\">해지 통보 후에도 돌려받지 못한 임대차보증금</h2><p class=\"case-text\">의뢰인은 공동임대인들과 보증금 약 1억 6,000만 원에 주택 임대차계약을 맺었습니다.</p>\n<p class=\"case-text\">계약기간이 지난 뒤에도 별도의 갱신 합의 없이 임대차가 이어졌고, 의뢰인은 2024년 봄 계약 해지를 통보했습니다.</p>\n<p class=\"case-text\">공동임대인 중 한 명은 2024년 여름까지 보증금을 돌려주겠다고 약속했습니다.</p>\n<p class=\"case-text\">그러나 약속은 지켜지지 않았습니다.</p>\n<p class=\"case-text\">주택에 설정된 담보 금액이 커 새로운 임차인을 구하기 어렵다는 설명만 이어졌습니다.</p>\n<p class=\"case-text\">해지 통보 후 약 3개월이 지나 계약이 종료됐지만, <strong>보증금 약 1억 6,000만 원은 반환되지 않았습니다.</strong> 2024년 가을부터는 연락마저 원활하지 않았습니다.</p>\n<p class=\"case-text\">의뢰인은 반환 약속을 기다리는 것만으로는 해결이 어렵다고 보고, 공동임대인들을 상대로 보증금 반환 소송을 진행하기 위해 YK 담당 변호사를 찾았습니다.</p><figure class=\"assistance-image\"><img class=\"assistance-image-img\" src=\"https://www.yklawfirm.co.kr/ai_case/18662/dcbc3a2001fc3846.webp\" alt=\"임대차 해지 후 공동임대인의 반환 약속 불이행으로 보증금 반환 소송을 진행한 사례\"></figure></section><section class=\"section\" id=\"section-info-1\"><h2 class=\"section-title\">임대차보증금 반환을 위한 묵시적 갱신과 해지 기준</h2><section id=\"section-info-1-sub-1\"><h3 class=\"subsection-title\">계약 만료 후 묵시적 갱신은 언제 성립할까요?</h3><p class=\"case-text\">주택 임대차는 일정한 기간 안에 갱신 거절 등의 통지가 없으면, 기존 계약과 같은 조건으로 다시 이어질 수 있습니다. 이를 <strong>묵시적 갱신</strong>이라고 합니다. 이때 임대차기간은 2년으로 봅니다.</p>\n<div class=\"def-box\"><span class=\"def-title\">묵시적 갱신과 해지 기준은 <strong><a rel=\"noopener noreferrer\">묵시적갱신이란? 전세·월세 계약의 연장 조건과 해지 방법</a></strong>에서 확인해 보세요.</span><span class=\"def-body\"></span></div>\n<p class=\"case-text\">임대인은 계약 만료 6개월 전부터 2개월 전까지 갱신 거절이나 계약조건 변경을 통지해야 합니다. 임차인도 만료 2개월 전까지 갱신하지 않겠다는 의사를 알리지 않으면 묵시적 갱신이 성립할 수 있습니다. 다만 임차인이 두 차례분의 월세에 해당하는 금액을 연체하는 등 의무를 현저히 위반한 경우에는 예외가 적용됩니다.</p>\n<p class=\"case-text\">이 사건에서는 계약기간이 지난 뒤 임대차가 묵시적으로 갱신됐습니다. 따라서 최초 계약의 만료 시점이 아니라, 갱신된 계약을 언제 해지했는지가 보증금 반환의 핵심 기준이 됐습니다.</p></section><section id=\"section-info-1-sub-2\"><h3 class=\"subsection-title\">묵시적으로 갱신된 계약은 어떻게 해지하나요?</h3><p class=\"case-text\">주택임대차보호법 제6조의2에 따라 임차인은 묵시적으로 갱신된 계약을 언제든지 해지할 수 있습니다. 새로 정해진 2년을 모두 채워야 하는 것은 아닙니다. 다만 <strong>임대인이 해지 통지를 받은 날부터 3개월이 지나야 해지 효력이 발생합니다.</strong></p>\n<p class=\"case-text\">따라서 해지 의사를 보냈다는 사실뿐 아니라, 임대인에게 통지가 도달한 시점을 확인하는 것이 중요합니다. 계약 종료 시점을 분명히 하려면 통지 내용과 도달 여부를 확인할 수 있도록 기록을 남겨두는 것이 좋습니다.</p>\n<p class=\"case-text\">이 사건에서도 의뢰인의 해지 통보 후 3개월이 지난 시점을 계약 종료 시점으로 삼았습니다. 보증금 반환은 주택을 넘겨주는 것과 동시에 이행하는 관계입니다. 새로운 임차인을 구하기 어렵다는 사정만으로 임대인의 반환의무가 없어지는 것은 아닙니다.</p></section></section><section class=\"section\" id=\"section-assistance\"><h2 class=\"section-title\">임대차보증금 전액 반환 판결을 이끌어 낸 YK 담당 변호사의 조력</h2><section id=\"section-assistance-sub-1\"><h3 class=\"subsection-title\">묵시적 갱신 후 해지 통보에 따른 계약 종료 주장</h3><p class=\"case-text\">YK 담당 변호사는 <mark class=\"assistance-highlight\"><strong>묵시적으로 갱신된 계약과 의뢰인의 해지 통보를 근거로</strong></mark>, 통보 후 3개월이 지나 임대차가 종료됐다고 주장했습니다. 계약기간이 다시 이어졌다는 이유로 보증금 반환을 미룰 수 없다는 점을 분명히 했습니다.</p></section><section id=\"section-assistance-sub-2\"><h3 class=\"subsection-title\">공동임대인 모두의 보증금 반환의무 주장</h3><p class=\"case-text\">YK 담당 변호사는 <mark class=\"assistance-highlight\"><strong>공동임대인들이 함께 주택을 임대하고 보증금을 받은 사실을 근거로</strong></mark>, 임대인 모두에게 약 1억 6,000만원의 반환을 청구했습니다. 보증금 반환은 각자의 몫으로 나눠 이행할 수 없는 의무라는 점에서, 특정 임대인에게만 반환 책임이 한정되지 않도록 했습니다.</p></section><section id=\"section-assistance-sub-3\"><h3 class=\"subsection-title\">보증금 반환 지연에 대비한 장래 지연손해금 청구 근거 정리</h3><p class=\"case-text\">YK 담당 변호사는 큰 규모의 근저당권 설정, 반환 약속의 반복적 연기와 연락 회피를 근거로 향후에도 지급이 지연될 가능성을 제시했습니다. 이에 <mark class=\"assistance-highlight\"><strong>주택 인도와 동시에 보증금 전액을 지급</strong></mark>하고, 인도 다음 날부터 전액을 갚을 때까지 <strong>연 5%의 지연손해금</strong>도 지급하도록 청구했습니다. 반환 지연에 따른 부담까지 청구 범위에 포함했고, 신속하게 판결을 받아 의뢰인이 집행에 나설 수 있는 근거를 마련했습니다.</p></section></section><section class=\"section\" id=\"section-result\"><h2 class=\"section-title\">보증금 사건 결과 : (전부)승소</h2><p class=\"case-text\">법원은 의뢰인의 <strong>보증금 반환 청구를 전부 받아들였습니다</strong>.</p>\n<div class=\"circled-result\"><p class=\"case-text\">① <strong>묵시적으로 갱신된 임대차가 해지 통보 후 법정 기간이 지나 종료된 점</strong></p><p class=\"case-text\">② <strong>주택을 공동으로 임대한 임대인들 모두에게 보증금 반환의무가 있는 점</strong></p><p class=\"case-text\">③ <strong>반환 약속이 지켜지지 않아 주택 인도 이후의 지연손해금도 미리 청구할 필요가 있었던 점</strong></p></div>\n<p class=\"case-text\">그 결과 공동임대인들은 <strong>주택을 인도받음과 동시에 보증금 약 1억 6,000만원 전액을 공동으로 지급</strong>하고, 인도 다음 날부터 전액 지급할 때까지 연 5%의 지연손해금을 지급하도록 판결받았습니다. 소송비용도 공동임대인들이 부담하도록 했습니다. 의뢰인은 보증금 전액과 지연손해금 지급을 명하는 전부승소 판결을 신속하게 확보했습니다. 계약 종료와 공동임대인의 반환의무를 분명히 해 보증금 회수를 위한 법적 근거를 마련했다는 데 의미가 있습니다.</p>\n<p class=\"case-text\"></p></section>\n    \n    <div class=\"tags\"><span class=\"tag\">임대차보증금반환</span><span class=\"tag\">공동임대인</span><span class=\"tag\">묵시적갱신</span><span class=\"tag\">임대차계약해지</span><span class=\"tag\">민사</span><span class=\"tag\">보증금</span></div>\n  </main>\n</article>\n\n\n  \n\n</div>"}