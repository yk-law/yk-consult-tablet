7px; color: #fff; background: #102169; }\n.case-role-value { padding: 5px 9px; color: #102169; background: #f3f6ff; }\n.case-summary-table { width: 100%; border-collapse: collapse; table-layout: fixed; font-size: 15px; }\n.case-summary-label, .case-summary-value { border-top: 1px solid #e5eaf3; padding: 11px 0; vertical-align: top; text-align: left; }\n.case-summary-row-first { border-top: 0; }\n.case-summary-label { width: 118px; color: #1a2744; font-weight: 800; }\n.case-summary-value { color: #374151; font-weight: 600; }\n.toc { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: 24px 32px; margin-bottom: 20px; }\n.toc-title { font-size: 11px; font-weight: 700; letter-spacing: 2px; color: #9ca3af; text-transform: uppercase; margin-bottom: 14px; }\n.toc-list { list-style: none; padding: 0; margin: 0; }\n.toc-item { margin-bottom: 8px; font-size: 16px; }\n.toc-link { color: #102169; font-weight: 600; text-decoration: none; }\n.toc .toc-sub { margin: 4px 0 0 18px; }\n.toc .toc-sub .toc-link { color: #4b5563; font-size: 15px; font-weight: 400; }\n.section { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: 36px 40px; margin-bottom: 20px; }\n.section-title { color: #1a2744; font-size: 22px; font-weight: 700; line-height: 1.4; margin: 0 0 18px; }\n.subsection-title { color: #2d4a8a; font-size: 18px; font-weight: 700; line-height: 1.4; margin: 24px 0 10px; }\n.case-text { color: #374151; font-size: 17px; margin: 0 0 14px; }\n.case-list { list-style-type: disc; padding-left: 1.5rem; margin: 10px 0 14px; }\n.case-list-item { color: #374151; margin-bottom: 6px; font-weight: 800; }\n.assistance-highlight { background: linear-gradient(transparent 58%, #fde68a 58%); padding: 0 2px; font-weight: 800; color: #1f2937; }\n.public-text-issue { background: #fee2e2; color: #991b1b; border: 1px solid #ef4444; border-radius: 4px; box-shadow: 0 0 0 2px rgba(239, 68, 68, 0.16); padding: 0 3px; font-weight: 900; }\n.ref-box, .def-box, .qna-box, .order-box { background: #f9fafb; border-left: 4px solid #102169; border-radius: 4px; padding: 16px 20px; margin: 16px 0; font-size: 15px; }\n.case-table { width: 100%; border-collapse: collapse; margin: 16px 0 20px; font-size: 15px; table-layout: fixed; }\n.case-table-head, .case-table-cell { border: 1px solid #dbe1ee; padding: 10px 12px; vertical-align: top; word-break: keep-all; }\n.case-table-head { background: #f3f6fb; color: #1a2744; font-weight: 700; }\n.assistance-image { margin: 24px 0 4px; aspect-ratio: 16 / 9; overflow: hidden; border-radius: 8px; border: 1px solid #e5e7eb; }\n.assistance-image-img { display: block; width: 100%; height: 100%; object-fit: cover; border: 0; }\n.result-cta { background: #15266f; border-radius: 8px; padding: 28px 36px; margin-top: 28px; margin-bottom: 0; color: #fff; }\n.result-cta-text { color: #fff; font-size: 16px; font-weight: 700; line-height: 1.65; margin: 0 0 20px; }\n.result-cta-button { display: inline-block; background: #fff; color: #15266f; text-decoration: none; font-size: 15px; font-weight: 800; padding: 12px 22px; border-radius: 7px; }\n.result-cta + .tags { margin-top: 40px; }\n.footer-note { text-align: center; font-size: 14px; color: #9ca3af; padding: 20px 24px 40px; margin: 0; }\n@page { margin: 12mm; }\n/* 모바일만: 좌우 여백을 살짝 줄여 본문 폭 확보. PC 레이아웃은 유지. */\n@media (max-width: 720px) {\n  .preview-header { padding: 28px 18px; }\n  .preview-container { padding: 20px 12px 56px; }\n  .section { padding: 26px 16px; }\n  .section-title { font-size: 20px; }\n  .subsection-title { font-size: 17px; }\n  .case-text { font-size: 16px; }\n  .toc { padding: 18px 16px; }\n  .case-summary-card { padding: 18px 16px; }\n  .case-summary-table { font-size: 14px; }\n  .case-summary-label { width: 96px; }\n  .ref-box, .def-box, .qna-box, .order-box { padding: 14px 14px; }\n  .result-cta { padding: 22px 18px; }\n}\n@media (max-width: 768px) {\n  .preview-header .preview-lead { font-size: 22px; line-height: 1.4; }\n}\n@media print {\n  .preview-result, .preview-result { background: #f8fafc !important; }\n  .preview-header, .result-cta, .case-role-label, .case-table-head, .tag, .case-role-value, .ref-box, .def-box, .qna-box, .order-box {\n    -webkit-print-color-adjust: exact !important;\n    print-color-adjust: exact !important;\n  }\n  .preview-container { padding-bottom: 40px; }\n  .section, .toc, .case-summary-card, .result-cta { break-inside: avoid; page-break-inside: avoid; }\n  .result-cta + .tags { margin-top: 42px; }\n}\n}</style><div data-embedded-case-html-root=\"\" class=\"\" style=\"display:block;width:100%;min-width:0;box-sizing:border-box;\">\n\n<article class=\"preview-result\">\n  <header class=\"preview-header\">\n    <div class=\"label\">YK SUCCESS CASE</div>\n    <p class=\"preview-lead\">의뢰인은 실제 사업을 운영할 의사 없이 대출모집인의 안내에 따라 사업자등록을 하고 허위 자금사용계획서 등을 제출해 저축은행에서 약 2억 1,000만원을 대출받은 혐의로 재판을 받았습니다.</p>\n  </header>\n  <main class=\"preview-container\">\n    <div class=\"lead\" id=\"section-overview\">\n<p class=\"case-text\">YK 담당 변호사는 의뢰인에게 사기의 고의가 없었다고 주장했으나 받아들여지지 않았으며, 법원은 수동적인 가담 경위와 연체 없는 이자 납부, 형사처벌 이력이 없는 점을 참작해 <strong>집행유예</strong>를 선고했습니다.</p></div>\n    <section class=\"case-summary-card\" aria-label=\"사건 결과 요약\"><div class=\"case-summary-title\"><span>사건 결과 요약</span><span class=\"case-role-badges\"><span class=\"case-role-badge case-role-badge-client\"><span class=\"case-role-label\">의뢰인</span><span class=\"case-role-value\">피고인</span></span></span></div><table class=\"case-summary-table\"><tbody><tr><th class=\"case-summary-label case-summary-row-first\" scope=\"row\">사건 유형</th><td class=\"case-summary-value case-summary-row-first\">일반사기</td></tr><tr><th class=\"case-summary-label\" scope=\"row\">쟁점</th><td class=\"case-summary-value\">사기 고의 및 공모 여부, 수동적 가담 경위, 성실한 이자 납부와 초범 사정의 양형 반영</td></tr><tr><th class=\"case-summary-label\" scope=\"row\">결과</th><td class=\"case-summary-value\">집행유예</td></tr><tr><th class=\"case-summary-label\" scope=\"row\">대응 포인트</th><td class=\"case-summary-value\">고의·공모 부인 및 수동적 가담과 성실한 이자 납부·초범 사정을 통한 선처 주장</td></tr></tbody></table></section><div data-case-cta-slot=\"top\"></div>\n    <nav class=\"toc\"><div class=\"toc-title\">CONTENTS</div><ul class=\"toc-list\"><li class=\"toc-item\"><a class=\"toc-link\">사업자대출 사기로 재판을 받게 된 경위</a></li><li class=\"toc-item\"><a class=\"toc-link\">일반사기 초범 처벌 수위와 양형요소</a><ul class=\"toc-list toc-sub\"><li class=\"toc-item\"><a class=\"toc-link\">처벌 수위와 적용 법령</a></li><li class=\"toc-item\"><a class=\"toc-link\">양형기준과 감경·가중요소</a></li></ul></li><li class=\"toc-item\"><a class=\"toc-link\">사업자대출 사기 집행유예를 위한 YK 담당 변호사의 조력</a><ul class=\"toc-list toc-sub\"><li class=\"toc-item\"><a class=\"toc-link\">관련자 지시에 따른 수동적 가담 경위 소명</a></li><li class=\"toc-item\"><a class=\"toc-link\">성실한 대출이자 납부를 선처 요소로 정리</a></li></ul></li><li class=\"toc-item\"><a class=\"toc-link\">일반사기 사건 결과 : 집행유예</a></li></ul></nav>\n    <section class=\"section\" id=\"section-background\"><h2 class=\"section-title\">사업자대출 사기로 재판을 받게 된 경위</h2><p class=\"case-text\">의뢰인은 실제 사업을 운영할 계획이 없는 상태에서 대출모집인의 안내에 따라 사업자등록을 했습니다.</p>\n<p class=\"case-text\">이후 허위 자금사용계획서 등을 작성·제출해 저축은행에서 <strong>사업자대출금 약 2억 원</strong>을 받았습니다.</p>\n<p class=\"case-text\">대출금은 기존 주택담보대출 상환 비용과 수수료 등에 사용하고, 나머지는 개인적인 용도로 쓸 생각이었습니다.</p>\n<p class=\"case-text\">사업자대출을 신청하며 밝힌 자금 사용 목적과 실제 사용 계획이 달랐던 것입니다.</p>\n<p class=\"case-text\">이 일로 의뢰인은 대출모집인 등과 함께 금융기관을 속여 대출받았다는 사기 혐의로 재판을 받게 되었습니다.</p>\n<p class=\"case-text\">대출모집인의 안내를 따랐다는 사정뿐 아니라, 직접 사업자등록을 하고 허위 서류를 제출한 경위도 쟁점이 됐습니다.</p>\n<p class=\"case-text\">의뢰인은 자신의 관여 과정과 사기 의도 여부를 설명하고 재판에 대응하기 위해 YK 담당 변호사의 조력을 받게 되었습니다.</p><figure class=\"assistance-image\"><img class=\"assistance-image-img\" src=\"https://www.yklawfirm.co.kr/ai_case/18851/1930276387b460aa.webp\" alt=\"허위 사업자대출 서류 제출로 사기 혐의를 받아 집행유예 대응이 필요했던 사례\"></figure></section><section class=\"section\" id=\"section-info-1\"><h2 class=\"section-title\">일반사기 초범 처벌 수위와 양형요소</h2><section id=\"section-info-1-sub-1\"><h3 class=\"subsection-title\">처벌 수위와 적용 법령</h3><p class=\"case-text\">사기죄는 사람을 속여 재물이나 재산상 이익을 얻었을 때 성립합니다. 이 사건에는 행위 당시의 구 형법 제347조 제1항이 적용됩니다. 당시 법정형은 <strong>10년 이하의 징역 또는 2천만 원 이하의 벌금</strong>입니다. 이후 개정된 현행 법정형과는 구분해야 합니다.</p>\n<div class=\"ref-box\"><span class=\"ref-title\">이득액에 따른 특경법 적용 기준은 <strong><a rel=\"noopener noreferrer\">특정경제범죄(특경법) 뜻, 가중 처벌 기준 및 대응방법</a></strong>에서 확인하세요.</span><span class=\"ref-body\"></span></div>\n<p class=\"case-text\">사업자대출 사기에서는 실제 사업 의사, 제출 서류의 진실성, 대출금 사용 계획 등이 판단의 핵심입니다. 대출모집인의 안내를 따랐더라도, 허위 내용임을 알면서 서류를 작성·제출했다면 사기죄가 인정될 수 있습니다.</p>\n<p class=\"case-text\">이 사건에서도 의뢰인은 사기의 고의가 없었다고 주장했습니다. 그러나 법원은 실제 사업 계획 없이 사업자등록을 하고 허위 자금사용계획서를 직접 작성·제출한 점을 근거로 이를 받아들이지 않았습니다.</p></section><section id=\"section-info-1-sub-2\"><h3 class=\"subsection-title\">양형기준과 감경·가중요소</h3><table class=\"case-table\"><thead><tr><th class=\"case-table-head\">구분</th><th class=\"case-table-head\">감경요소</th><th class=\"case-table-head\">가중요소</th></tr></thead><tbody><tr><td class=\"case-table-cell\">행위</td><td class=\"case-table-cell\">참작할 만한 범행 경위, 피해나 위험이 낮은 사정</td><td class=\"case-table-cell\">위험성이나 피해가 큰 사정</td></tr><tr><td class=\"case-table-cell\">행위자·기타</td><td class=\"case-table-cell\">반성, 피해 회복, 재범 방지 노력</td><td class=\"case-table-cell\">재범, 증거은폐, 범행 후 정황이 불리한 사정</td></tr></tbody></table>\n<p class=\"case-text\">양형기준은 법원이 구체적인 형량을 정할 때 참고하는 기준입니다. 일반사기는 이득액에 따라 유형을 나누며, 이 사건의 대출금 2억 800만 원은 ‘1억 원 이상 5억 원 미만’ 구간에 해당합니다. 이 구간의 기본 권고 형량은 징역 1년부터 3년입니다. 다만 가담 정도와 피해 발생 위험 등에 따라 감경 여부가 달라집니다.</p>\n<p class=\"case-text\"><strong>초범이라는 이유만으로 집행유예가 보장되지는 않습니다.</strong> 형사처벌 이력이 없다는 점은 유리한 사정이지만, 편취금액과 범행 수단 등도 함께 살핍니다. 이 사건에서는 금액이 적지 않고 허위 서류를 제출하는 적극적인 기망수단을 사용한 점이 불리하게 고려됐습니다.</p>\n<p class=\"case-text\">반면 관련자들의 지시에 따라 수동적으로 가담한 점, 대출금 이자를 연체 없이 납부한 것으로 보이는 점, 초범이라는 점은 유리하게 평가됐습니다. 특히 법원은 ‘손해발생의 위험이 크게 현실화되지 아니한 경우’와 ‘단순 가담’을 특별감경요소로 반영했습니다. 이는 범죄 성립을 부정한 것이 아니라, 책임의 정도와 실제 손해 발생 위험을 형량 판단에 반영했습니다.</p></section></section><section class=\"section\" id=\"section-assistance\"><h2 class=\"section-title\">사업자대출 사기 집행유예를 위한 YK 담당 변호사의 조력</h2><section id=\"section-assistance-sub-1\"><h3 class=\"subsection-title\">관련자 지시에 따른 수동적 가담 경위 소명</h3><p class=\"case-text\">YK 담당 변호사는 의뢰인이 대출모집인을 은행 직원으로 알고 안내에 따랐다는 경위를 들어, 사기 가능성을 인식하고도 받아들인 고의나 공모가 없었다고 주장했습니다. 다만 법원은 실제 사업 의사 없이 허위 자금사용계획서를 직접 작성·제출하고 관련자들과 역할을 나눈 점을 근거로 <mark class=\"assistance-highlight\"><strong>사기의 고의와 공모를 인정했습니다.</strong></mark> 고의를 부인한 주장은 받아들여지지 않았지만, 관련자들의 지시에 따라 수동적으로 가담한 경위를 소명한 것은 의뢰인의 역할과 책임 정도를 형량에 반영하기 위해서였습니다.</p></section><section id=\"section-assistance-sub-2\"><h3 class=\"subsection-title\">성실한 대출이자 납부를 선처 요소로 정리</h3><p class=\"case-text\">편취금액이 적지 않고 허위 서류를 제출한 점이 불리한 상황에서, YK 담당 변호사는 의뢰인이 대출이자를 연체 없이 납부해 온 사정과 형사처벌 이력이 없는 초범이라는 점을 선처 요소로 짚었습니다. 법원도 수동적인 가담 경위와 함께 <mark class=\"assistance-highlight\"><strong>성실한 이자 납부와 초범인 점을 유리하게 참작했습니다.</strong></mark> 이는 범죄 성립과 별개로 대출 이후의 이행 상황과 가담 정도가 형량 판단에서 빠지지 않도록 하기 위한 조력이었습니다.</p></section></section><section class=\"section\" id=\"section-result\"><h2 class=\"section-title\">일반사기 사건 결과 : 집행유예</h2><p class=\"case-text\">법원은 의뢰인에게 집행유예 판결을 선고했습니다.</p>\n<div class=\"circled-result\"><p class=\"case-text\">① <strong>관련자들의 지시에 따라 수동적으로 가담한 것으로 보이는 점</strong></p><p class=\"case-text\">② <strong>대출금 이자를 연체 없이 성실하게 납부한 것으로 보이는 점</strong></p><p class=\"case-text\">③ <strong>형사처벌 이력이 없는 초범인 점</strong></p></div>\n<p class=\"case-text\">고의가 없었다는 주장은 받아들여지지 않았지만, 가담 경위와 성실한 이자 납부, 초범이라는 사정이 형을 정하는 데 고려됐습니다.</p>\n<p class=\"case-text\"></p></section>\n    \n    <div class=\"tags\"><span class=\"tag\">사업자대출사기</span><span class=\"tag\">집행유예</span><span class=\"tag\">수동적가담</span><span class=\"tag\">초범</span><span class=\"tag\">형사</span><span class=\"tag\">일반사기</span></div>\n  </main>\n</article>\n\n\n  \n\n</div>"}