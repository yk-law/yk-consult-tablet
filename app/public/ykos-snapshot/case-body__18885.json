color: #fff; background: #102169; }\n.case-role-value { padding: 5px 9px; color: #102169; background: #f3f6ff; }\n.case-summary-table { width: 100%; border-collapse: collapse; table-layout: fixed; font-size: 15px; }\n.case-summary-label, .case-summary-value { border-top: 1px solid #e5eaf3; padding: 11px 0; vertical-align: top; text-align: left; }\n.case-summary-row-first { border-top: 0; }\n.case-summary-label { width: 118px; color: #1a2744; font-weight: 800; }\n.case-summary-value { color: #374151; font-weight: 600; }\n.toc { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: 24px 32px; margin-bottom: 20px; }\n.toc-title { font-size: 11px; font-weight: 700; letter-spacing: 2px; color: #9ca3af; text-transform: uppercase; margin-bottom: 14px; }\n.toc-list { list-style: none; padding: 0; margin: 0; }\n.toc-item { margin-bottom: 8px; font-size: 16px; }\n.toc-link { color: #102169; font-weight: 600; text-decoration: none; }\n.toc .toc-sub { margin: 4px 0 0 18px; }\n.toc .toc-sub .toc-link { color: #4b5563; font-size: 15px; font-weight: 400; }\n.section { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: 36px 40px; margin-bottom: 20px; }\n.section-title { color: #1a2744; font-size: 22px; font-weight: 700; line-height: 1.4; margin: 0 0 18px; }\n.subsection-title { color: #2d4a8a; font-size: 18px; font-weight: 700; line-height: 1.4; margin: 24px 0 10px; }\n.case-text { color: #374151; font-size: 17px; margin: 0 0 14px; }\n.case-list { list-style-type: disc; padding-left: 1.5rem; margin: 10px 0 14px; }\n.case-list-item { color: #374151; margin-bottom: 6px; font-weight: 800; }\n.assistance-highlight { background: linear-gradient(transparent 58%, #fde68a 58%); padding: 0 2px; font-weight: 800; color: #1f2937; }\n.public-text-issue { background: #fee2e2; color: #991b1b; border: 1px solid #ef4444; border-radius: 4px; box-shadow: 0 0 0 2px rgba(239, 68, 68, 0.16); padding: 0 3px; font-weight: 900; }\n.ref-box, .def-box, .qna-box, .order-box { background: #f9fafb; border-left: 4px solid #102169; border-radius: 4px; padding: 16px 20px; margin: 16px 0; font-size: 15px; }\n.case-table { width: 100%; border-collapse: collapse; margin: 16px 0 20px; font-size: 15px; table-layout: fixed; }\n.case-table-head, .case-table-cell { border: 1px solid #dbe1ee; padding: 10px 12px; vertical-align: top; word-break: keep-all; }\n.case-table-head { background: #f3f6fb; color: #1a2744; font-weight: 700; }\n.assistance-image { margin: 24px 0 4px; aspect-ratio: 16 / 9; overflow: hidden; border-radius: 8px; border: 1px solid #e5e7eb; }\n.assistance-image-img { display: block; width: 100%; height: 100%; object-fit: cover; border: 0; }\n.result-cta { background: #15266f; border-radius: 8px; padding: 28px 36px; margin-top: 28px; margin-bottom: 0; color: #fff; }\n.result-cta-text { color: #fff; font-size: 16px; font-weight: 700; line-height: 1.65; margin: 0 0 20px; }\n.result-cta-button { display: inline-block; background: #fff; color: #15266f; text-decoration: none; font-size: 15px; font-weight: 800; padding: 12px 22px; border-radius: 7px; }\n.result-cta + .tags { margin-top: 40px; }\n.footer-note { text-align: center; font-size: 14px; color: #9ca3af; padding: 20px 24px 40px; margin: 0; }\n@page { margin: 12mm; }\n/* 모바일만: 좌우 여백을 살짝 줄여 본문 폭 확보. PC 레이아웃은 유지. */\n@media (max-width: 720px) {\n  .preview-header { padding: 28px 18px; }\n  .preview-container { padding: 20px 12px 56px; }\n  .section { padding: 26px 16px; }\n  .section-title { font-size: 20px; }\n  .subsection-title { font-size: 17px; }\n  .case-text { font-size: 16px; }\n  .toc { padding: 18px 16px; }\n  .case-summary-card { padding: 18px 16px; }\n  .case-summary-table { font-size: 14px; }\n  .case-summary-label { width: 96px; }\n  .ref-box, .def-box, .qna-box, .order-box { padding: 14px 14px; }\n  .result-cta { padding: 22px 18px; }\n}\n@media (max-width: 768px) {\n  .preview-header .preview-lead { font-size: 22px; line-height: 1.4; }\n}\n@media print {\n  .preview-result, .preview-result { background: #f8fafc !important; }\n  .preview-header, .result-cta, .case-role-label, .case-table-head, .tag, .case-role-value, .ref-box, .def-box, .qna-box, .order-box {\n    -webkit-print-color-adjust: exact !important;\n    print-color-adjust: exact !important;\n  }\n  .preview-container { padding-bottom: 40px; }\n  .section, .toc, .case-summary-card, .result-cta { break-inside: avoid; page-break-inside: avoid; }\n  .result-cta + .tags { margin-top: 42px; }\n}\n}</style><div data-embedded-case-html-root=\"\" class=\"\" style=\"display:block;width:100%;min-width:0;box-sizing:border-box;\">\n\n<article class=\"preview-result\">\n  <header class=\"preview-header\">\n    <div class=\"label\">YK SUCCESS CASE</div>\n    <p class=\"preview-lead\">자영업자인 의뢰인은 인터넷 중고거래 사기에 사용된 계좌와 휴대전화 유심 등을 마련하는 역할을 맡아 다수의 피해자가 발생한 사기 사건으로 재판을 받았습니다.</p>\n  </header>\n  <main class=\"preview-container\">\n    <div class=\"lead\" id=\"section-overview\">\n<p class=\"case-text\">YK 담당 변호사는 피해자 8명과의 합의 및 일부 피해자에 대한 공탁 사실, 의뢰인에게 범죄 이력이 없다는 점을 유리한 양형 사유로 소명했고, 의뢰인은 집행유예를 선고받았습니다.</p></div>\n    <section class=\"case-summary-card\" aria-label=\"사건 결과 요약\"><div class=\"case-summary-title\"><span>사건 결과 요약</span><span class=\"case-role-badges\"><span class=\"case-role-badge case-role-badge-client\"><span class=\"case-role-label\">의뢰인</span><span class=\"case-role-value\">피고인</span></span></span></div><table class=\"case-summary-table\"><tbody><tr><th class=\"case-summary-label case-summary-row-first\" scope=\"row\">사건 유형</th><td class=\"case-summary-value case-summary-row-first\">일반사기</td></tr><tr><th class=\"case-summary-label\" scope=\"row\">쟁점</th><td class=\"case-summary-value\">합의·공탁에 따른 피해 회복 노력, 공동범행 가담 역할, 범죄 이력 유무</td></tr><tr><th class=\"case-summary-label\" scope=\"row\">결과</th><td class=\"case-summary-value\">집행유예</td></tr><tr><th class=\"case-summary-label\" scope=\"row\">대응 포인트</th><td class=\"case-summary-value\">피해자 8명과의 합의 및 일부 공탁, 가담 역할과 범죄 이력 부재를 통한 선처 요청</td></tr></tbody></table></section><div data-case-cta-slot=\"top\"></div>\n    <nav class=\"toc\"><div class=\"toc-title\">CONTENTS</div><ul class=\"toc-list\"><li class=\"toc-item\"><a class=\"toc-link\">중고거래 사기로 재판을 받게 된 경위</a></li><li class=\"toc-item\"><a class=\"toc-link\">일반사기 재범 처벌 수위와 양형요소</a><ul class=\"toc-list toc-sub\"><li class=\"toc-item\"><a class=\"toc-link\">처벌 수위와 적용 법령</a></li><li class=\"toc-item\"><a class=\"toc-link\">양형기준과 감경·가중요소</a></li></ul></li><li class=\"toc-item\"><a class=\"toc-link\">중고거래 사기 집행유예를 위한 YK 담당 변호사의 조력</a><ul class=\"toc-list toc-sub\"><li class=\"toc-item\"><a class=\"toc-link\">피해 회복을 위한 피해자 합의 성립 입증</a></li><li class=\"toc-item\"><a class=\"toc-link\">범행 가담 역할을 구분해 선처 사유로 정리</a></li></ul></li><li class=\"toc-item\"><a class=\"toc-link\">일반사기 사건 결과 : 집행유예</a></li></ul></nav>\n    <section class=\"section\" id=\"section-background\"><h2 class=\"section-title\">중고거래 사기로 재판을 받게 된 경위</h2><p class=\"case-text\">의뢰인은 인터넷 중고거래 사기에 사용된 계좌와 휴대전화 유심 등을 마련하는 역할을 맡았다가 재판을 받게 되었습니다.</p>\n<p class=\"case-text\">함께 기소된 다른 피고인은 상품권·청소용품·낚싯대 등을 판매한다는 허위 글을 올리고 피해자들에게 연락했습니다.</p>\n<p class=\"case-text\">물품을 보내줄 의사나 능력 없이 대금을 받아 여러 피해자가 발생한 사건이었습니다.</p>\n<p class=\"case-text\">의뢰인이 직접 판매글을 게시하거나 피해자에게 연락한 것은 아니었습니다.</p>\n<p class=\"case-text\">그러나 <strong>범행에 필요한 수단을 마련한 행위 역시 공동범행의 책임이 문제 되는 사안</strong>이었습니다.</p>\n<p class=\"case-text\">의뢰인은 재판에서 자신의 가담 범위와 책임을 설명하고, 피해 회복을 위한 대응을 준비하고자 YK 담당 변호사의 조력을 구했습니다.</p><figure class=\"assistance-image\"><img class=\"assistance-image-img\" src=\"https://www.yklawfirm.co.kr/ai_case/18885/f136afbd6f6c8f69.webp\" alt=\"중고거래사기 계좌·유심 제공 가담 혐의와 피해자 합의·공탁 양형 대응\"></figure></section><section class=\"section\" id=\"section-info-1\"><h2 class=\"section-title\">일반사기 재범 처벌 수위와 양형요소</h2><section id=\"section-info-1-sub-1\"><h3 class=\"subsection-title\">처벌 수위와 적용 법령</h3><p class=\"case-text\">사람을 속여 물품 대금 등 재물을 받으면 형법 제347조 제1항의 사기죄가 성립할 수 있습니다. 재산상 이익을 얻는 경우에는 같은 조 제2항이 적용됩니다. <strong>이 사건의 대금 편취에는 제1항이 적용됐습니다.</strong> 범행 당시 법률에 따른 법정형은 10년 이하의 징역 또는 2천만 원 이하의 벌금입니다.</p>\n<div class=\"ref-box\"><span class=\"ref-title\">관련 쟁점은 <strong><a rel=\"noopener noreferrer\">사기죄 성립 요건 및 형량</a></strong>에서 확인하실 수 있습니다.</span><span class=\"ref-body\"></span></div>\n<p class=\"case-text\">역할을 나눠 사기 범행을 함께 실행했다면 형법 제30조에 따라 공동정범으로 책임을 질 수 있습니다. 직접 허위 판매글을 쓰지 않았더라도 가담 경위와 역할에 따라 책임이 인정될 수 있습니다.</p>\n<p class=\"case-text\">재범이라고 모두 형법 제35조의 누범가중 대상이 되는 것은 아닙니다. 징역형 집행이 끝나거나 면제된 뒤 법에서 정한 기간 안에 다시 범죄를 저지르는 등 요건을 충족해야 합니다. 이 사건에서 <strong>의뢰인은 초범이며, 누범가중이 적용된 사람은 범행을 주도한 다른 피고인</strong>입니다.</p></section><section id=\"section-info-1-sub-2\"><h3 class=\"subsection-title\">양형기준과 감경·가중요소</h3><table class=\"case-table\"><thead><tr><th class=\"case-table-head\">구분</th><th class=\"case-table-head\">감경요소</th><th class=\"case-table-head\">가중요소</th></tr></thead><tbody><tr><td class=\"case-table-cell\">행위</td><td class=\"case-table-cell\">참작할 만한 가담 경위, 피해 회복</td><td class=\"case-table-cell\">다수 피해자, 반복적인 범행</td></tr><tr><td class=\"case-table-cell\">행위자·기타</td><td class=\"case-table-cell\">형사처벌 이력이 없는 점, 반성</td><td class=\"case-table-cell\">같은 범죄의 반복, 불리한 범행 후 정황</td></tr></tbody></table>\n<p class=\"case-text\">양형기준은 법원이 구체적인 형량을 정할 때 참고하는 기준입니다. 사기 사건에서는 피해금액뿐 아니라 피해자 수, 반복성, 가담 정도, 범죄 이력과 피해 회복 여부를 함께 살핍니다. 개별 피해금액이 적더라도 여러 사람을 상대로 반복한 범행은 불리하게 평가될 수 있습니다.</p>\n<p class=\"case-text\">형사처벌 이력이 없는 점, 가담 정도가 낮은 점, 진지한 반성, 합의와 실질적인 피해 회복 등은 유리하게 고려될 수 있습니다. 반대로 같은 범죄를 반복하거나 불특정 다수에게 피해를 준 점, 범행 수법이 불량한 점은 불리한 요소가 됩니다.</p>\n<p class=\"case-text\">이 사건에서는 의뢰인이 초범인 점, 피해자 8명과 합의한 점, 다른 피고인이 범행을 주도한 점이 유리하게 고려됐습니다. 다만 피해자가 다수이고 범행 수단과 방법이 좋지 않다는 점은 불리하게 반영됐습니다.</p>\n<p class=\"case-text\">공탁도 피해 회복을 위한 사정으로 고려될 수 있지만, 합의와 동일하게 평가되는 것은 아닙니다. 이 사건에서는 공탁금 수령을 거부한 피해자들의 의사도 함께 고려됐습니다. 따라서 공탁 여부만으로 감경을 예상해서는 안 됩니다.</p></section></section><section class=\"section\" id=\"section-assistance\"><h2 class=\"section-title\">중고거래 사기 집행유예를 위한 YK 담당 변호사의 조력</h2><section id=\"section-assistance-sub-1\"><h3 class=\"subsection-title\">피해 회복을 위한 피해자 합의 성립 입증</h3><p class=\"case-text\">YK 담당 변호사는 피해자가 다수인 상황에서 <mark class=\"assistance-highlight\"><strong>공판 중 피해자 8명과 성립한 합의와 일부 피해자를 위한 공탁 사실</strong></mark>을 형량 결정에 참작해 달라고 요청했습니다. 공탁금을 받지 않겠다는 피해자도 있어, 공탁을 피해 회복의 완료나 모든 피해자의 용서로 설명하지 않았습니다. 합의와 공탁만으로 집행유예를 구하기보다, 실제 피해 회복 노력과 그 범위를 구분해 재판부가 판단하도록 하는 데 중점을 뒀습니다.</p></section><section id=\"section-assistance-sub-2\"><h3 class=\"subsection-title\">범행 가담 역할을 구분해 선처 사유로 정리</h3><p class=\"case-text\">YK 담당 변호사는 의뢰인이 범행에 쓰인 계좌와 휴대전화 유심 등을 마련한 책임을 전제로, 다른 피고인이 허위 판매글 게시와 피해자 연락을 맡아 범행을 주도했다는 점을 주장했습니다. 여기에 <mark class=\"assistance-highlight\"><strong>의뢰인에게 범죄 이력이 없다는 사정</strong></mark>을 함께 제시하며 형량에 참작해 달라고 요청했습니다. 공동범행의 책임을 부정하는 대신, 각자의 가담 역할과 범죄 이력을 구분해 의뢰인의 형량을 판단할 필요가 있음을 강조했습니다.</p></section></section><section class=\"section\" id=\"section-result\"><h2 class=\"section-title\">일반사기 사건 결과 : 집행유예</h2><p class=\"case-text\">법원은 의뢰인에게 <strong>집행유예 판결을 선고했습니다.</strong></p>\n<div class=\"circled-result\"><p class=\"case-text\">① <strong>공판 중 피해자 8명과 합의하고 일부 피해자를 위해 공탁한 점</strong></p><p class=\"case-text\">② <strong>의뢰인에게 범죄 이력이 없는 점</strong></p><p class=\"case-text\">③ <strong>의뢰인은 계좌와 휴대전화 유심 등을 마련하는 역할을 맡았고, 다른 피고인이 범행을 주도한 점</strong></p></div>\n<p class=\"case-text\">그 결과 의뢰인은 일반사기 사건에서 집행유예를 받았습니다. 이번 사건은 YK 담당 변호사가 강조한 피해 회복 노력과 범죄 이력, 범행에서 맡은 역할이 형량 결정에 유리하게 고려된 사례입니다.</p>\n<p class=\"case-text\"></p></section>\n    \n    <div class=\"tags\"><span class=\"tag\">중고거래사기</span><span class=\"tag\">집행유예</span><span class=\"tag\">피해자합의</span><span class=\"tag\">형사공탁</span><span class=\"tag\">형사</span><span class=\"tag\">일반사기</span></div>\n  </main>\n</article>\n\n\n  \n\n</div>"}