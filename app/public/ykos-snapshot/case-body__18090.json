7px; color: #fff; background: #102169; }\n.case-role-value { padding: 5px 9px; color: #102169; background: #f3f6ff; }\n.case-summary-table { width: 100%; border-collapse: collapse; table-layout: fixed; font-size: 15px; }\n.case-summary-label, .case-summary-value { border-top: 1px solid #e5eaf3; padding: 11px 0; vertical-align: top; text-align: left; }\n.case-summary-row-first { border-top: 0; }\n.case-summary-label { width: 118px; color: #1a2744; font-weight: 800; }\n.case-summary-value { color: #374151; font-weight: 600; }\n.toc { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: 24px 32px; margin-bottom: 20px; }\n.toc-title { font-size: 11px; font-weight: 700; letter-spacing: 2px; color: #9ca3af; text-transform: uppercase; margin-bottom: 14px; }\n.toc-list { list-style: none; padding: 0; margin: 0; }\n.toc-item { margin-bottom: 8px; font-size: 16px; }\n.toc-link { color: #102169; font-weight: 600; text-decoration: none; }\n.toc .toc-sub { margin: 4px 0 0 18px; }\n.toc .toc-sub .toc-link { color: #4b5563; font-size: 15px; font-weight: 400; }\n.section { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: 36px 40px; margin-bottom: 20px; }\n.section-title { color: #1a2744; font-size: 22px; font-weight: 700; line-height: 1.4; margin: 0 0 18px; }\n.subsection-title { color: #2d4a8a; font-size: 18px; font-weight: 700; line-height: 1.4; margin: 24px 0 10px; }\n.case-text { color: #374151; font-size: 17px; margin: 0 0 14px; }\n.case-list { list-style-type: disc; padding-left: 1.5rem; margin: 10px 0 14px; }\n.case-list-item { color: #374151; margin-bottom: 6px; font-weight: 800; }\n.assistance-highlight { background: linear-gradient(transparent 58%, #fde68a 58%); padding: 0 2px; font-weight: 800; color: #1f2937; }\n.public-text-issue { background: #fee2e2; color: #991b1b; border: 1px solid #ef4444; border-radius: 4px; box-shadow: 0 0 0 2px rgba(239, 68, 68, 0.16); padding: 0 3px; font-weight: 900; }\n.ref-box, .def-box, .qna-box, .order-box { background: #f9fafb; border-left: 4px solid #102169; border-radius: 4px; padding: 16px 20px; margin: 16px 0; font-size: 15px; }\n.case-table { width: 100%; border-collapse: collapse; margin: 16px 0 20px; font-size: 15px; table-layout: fixed; }\n.case-table-head, .case-table-cell { border: 1px solid #dbe1ee; padding: 10px 12px; vertical-align: top; word-break: keep-all; }\n.case-table-head { background: #f3f6fb; color: #1a2744; font-weight: 700; }\n.assistance-image { margin: 24px 0 4px; aspect-ratio: 16 / 9; overflow: hidden; border-radius: 8px; border: 1px solid #e5e7eb; }\n.assistance-image-img { display: block; width: 100%; height: 100%; object-fit: cover; border: 0; }\n.result-cta { background: #15266f; border-radius: 8px; padding: 28px 36px; margin-top: 28px; margin-bottom: 0; color: #fff; }\n.result-cta-text { color: #fff; font-size: 16px; font-weight: 700; line-height: 1.65; margin: 0 0 20px; }\n.result-cta-button { display: inline-block; background: #fff; color: #15266f; text-decoration: none; font-size: 15px; font-weight: 800; padding: 12px 22px; border-radius: 7px; }\n.result-cta + .tags { margin-top: 40px; }\n.footer-note { text-align: center; font-size: 14px; color: #9ca3af; padding: 20px 24px 40px; margin: 0; }\n@page { margin: 12mm; }\n/* 모바일만: 좌우 여백을 살짝 줄여 본문 폭 확보. PC 레이아웃은 유지. */\n@media (max-width: 720px) {\n  .preview-header { padding: 28px 18px; }\n  .preview-container { padding: 20px 12px 56px; }\n  .section { padding: 26px 16px; }\n  .section-title { font-size: 20px; }\n  .subsection-title { font-size: 17px; }\n  .case-text { font-size: 16px; }\n  .toc { padding: 18px 16px; }\n  .case-summary-card { padding: 18px 16px; }\n  .case-summary-table { font-size: 14px; }\n  .case-summary-label { width: 96px; }\n  .ref-box, .def-box, .qna-box, .order-box { padding: 14px 14px; }\n  .result-cta { padding: 22px 18px; }\n}\n@media (max-width: 768px) {\n  .preview-header .preview-lead { font-size: 22px; line-height: 1.4; }\n}\n@media print {\n  .preview-result, .preview-result { background: #f8fafc !important; }\n  .preview-header, .result-cta, .case-role-label, .case-table-head, .tag, .case-role-value, .ref-box, .def-box, .qna-box, .order-box {\n    -webkit-print-color-adjust: exact !important;\n    print-color-adjust: exact !important;\n  }\n  .preview-container { padding-bottom: 40px; }\n  .section, .toc, .case-summary-card, .result-cta { break-inside: avoid; page-break-inside: avoid; }\n  .result-cta + .tags { margin-top: 42px; }\n}\n}</style><div data-embedded-case-html-root=\"\" class=\"\" style=\"display:block;width:100%;min-width:0;box-sizing:border-box;\">\n\n<article class=\"preview-result\">\n  <header class=\"preview-header\">\n    <div class=\"label\">YK SUCCESS CASE</div>\n    <p class=\"preview-lead\">의뢰인은 벨트컨베이어 안전시설물 설치공사 중 발생한 추락사고로 형사재판을 받게 되었습니다. 비계 설치작업을 하던 근로자가 계단참 작업발판을 밟았는데, 발판이 탈락하면서 약 7.5m 아래로 추락한 사고였습니다. 근로자는 목 척수 손상 등으로 약 8개월간 치료가 필요한 상해를 입었습니다. 검사는 작업발판을 핀용접이나 클립 고정 없이 철선으로만 임시 고정한 점을 문제 삼았습니다. 발판이 충분한 하중을 견디도록 강도를 확보하지 않았고, 출입금지 등 안전조치도 하지 않았다고 보아 의뢰인을 업무상과실치상·산업안전보건법위반 혐의로 기소했습니다. 이에 의뢰인은 임시 고정 방식이 당시 작업 공정에 적합했는지, 필요한 안전조치를 이행했는지를 두고 법적 판단을 받아야 하는 상황에 놓였습니다.</p>\n  </header>\n  <main class=\"preview-container\">\n    <section class=\"case-summary-card\" aria-label=\"사건 결과 요약\"><div class=\"case-summary-title\"><span>사건 결과 요약</span><span class=\"case-role-badges\"><span class=\"case-role-badge case-role-badge-client\"><span class=\"case-role-label\">의뢰인</span><span class=\"case-role-value\">피고인</span></span></span></div><table class=\"case-summary-table\"><tbody><tr><th class=\"case-summary-label case-summary-row-first\" scope=\"row\">사건 유형</th><td class=\"case-summary-value case-summary-row-first\">기타</td></tr><tr><th class=\"case-summary-label\" scope=\"row\">쟁점</th><td class=\"case-summary-value\">발판 임시 고정의 적정성, 작업발판 강도 기준 충족 여부, 피해자의 관계 근로자 해당 여부</td></tr><tr><th class=\"case-summary-label\" scope=\"row\">결과</th><td class=\"case-summary-value\">무죄</td></tr><tr><th class=\"case-summary-label\" scope=\"row\">대응 포인트</th><td class=\"case-summary-value\">후속 작업공정과 구조검토보고서, 피해자의 작업 범위를 근거로 주의의무 및 안전조치 위반을 다툼</td></tr></tbody></table></section><div data-case-cta-slot=\"top\"></div>\n    <nav class=\"toc\"><div class=\"toc-title\">CONTENTS</div><ul class=\"toc-list\"><li class=\"toc-item\"><a class=\"toc-link\">추락사고로 업무상과실치상·산업안전보건법위반 혐의를 받은 경위</a></li><li class=\"toc-item\"><a class=\"toc-link\">산업재해 추락사고의 형사책임 판단 기준</a></li><li class=\"toc-item\"><a class=\"toc-link\">업무상과실치상·산업안전보건법위반 무죄를 위한 YK 담당 변호사의 조력</a><ul class=\"toc-list toc-sub\"><li class=\"toc-item\"><a class=\"toc-link\">후속 작업 공정을 근거로 발판 임시 고정의 적정성 소명</a></li><li class=\"toc-item\"><a class=\"toc-link\">구조검토보고서를 근거로 발판 강도 기준 충족 주장</a></li><li class=\"toc-item\"><a class=\"toc-link\">비계 설치 업무를 근거로 관계 근로자 해당성 소명</a></li></ul></li><li class=\"toc-item\"><a class=\"toc-link\">업무상과실치상 사건 결과 : 무죄</a></li></ul></nav>\n    <section class=\"section\" id=\"section-background\"><h2 class=\"section-title\">추락사고로 업무상과실치상·산업안전보건법위반 혐의를 받은 경위</h2><p class=\"case-text\">의뢰인은 벨트컨베이어 안전시설물 설치공사 중 발생한 추락사고로 형사재판을 받게 되었습니다.</p>\n<p class=\"case-text\">비계 설치작업을 하던 근로자가 계단참 작업발판을 밟았는데, 발판이 탈락하면서 약 7.5m 아래로 추락한 사고였습니다.</p>\n<p class=\"case-text\">근로자는 목 척수 손상 등으로 약 8개월간 치료가 필요한 상해를 입었습니다.</p>\n<p class=\"case-text\">검사는 작업발판을 핀용접이나 클립 고정 없이 철선으로만 임시 고정한 점을 문제 삼았습니다.</p>\n<p class=\"case-text\">발판이 충분한 하중을 견디도록 강도를 확보하지 않았고, 출입금지 등 안전조치도 하지 않았다고 보아 의뢰인을 <strong>업무상과실치상·산업안전보건법위반 혐의로 기소</strong>했습니다.</p>\n<p class=\"case-text\">이에 의뢰인은 임시 고정 방식이 당시 작업 공정에 적합했는지, 필요한 안전조치를 이행했는지를 두고 법적 판단을 받아야 하는 상황에 놓였습니다.</p><figure class=\"assistance-image\"><img class=\"assistance-image-img\" src=\"https://www.yklawfirm.co.kr/ai_case/18090/29a51a83ba1157f3.webp\" alt=\"공사 중 작업발판 추락사고 업무상과실치상·산업안전보건법위반 대응\"></figure></section><section class=\"section\" id=\"section-info-1\"><h2 class=\"section-title\">산업재해 추락사고의 형사책임 판단 기준</h2><p class=\"case-text\">산업재해로 근로자가 크게 다쳤더라도 사고 발생만으로 현장 관계자의 형사책임이 인정되는 것은 아닙니다. <strong>업무상 주의의무를 위반했는지, 필요한 안전조치를 이행하지 않았는지가 증거로 입증되어야 합니다.</strong> 범죄가 증명되지 않은 경우에는 형사소송법 제325조 후단에 따라 무죄를 선고합니다.</p>\n<p class=\"case-text\">업무상과실치상에서는 담당자가 업무 중 지켜야 할 주의의무를 어겼고, 그로 인해 근로자가 다쳤는지가 쟁점입니다. 산업안전보건법 위반에서는 해당 작업에 필요한 재해예방조치를 하지 않았는지를 살펴봅니다. 따라서 부상의 정도와 별개로, 문제 된 작업 방식과 안전조치 의무를 구체적으로 구분해야 합니다.</p>\n<p class=\"case-text\">이 사건에서 철선으로 작업발판을 임시 고정한 행위는 전체 공정 속에서 판단할 필요가 있었습니다. 후속 안전데크와 연결·조정해야 하는 단계였기 때문입니다. 계단참을 먼저 완전히 고정하면 나중에 다시 해체해야 해 위험이 커질 수 있다는 점도 판단 요소가 되었습니다. 임시 고정이라는 이유만으로 곧바로 안전조치 위반이라고 볼 수는 없었던 것입니다.</p>\n<p class=\"case-text\">작업발판의 강도 역시 사고 결과와 구분해 살펴야 합니다. 이 사건에서는 발판이 매제곱미터당 500킬로그램 이상의 하중을 견딜 수 있었는지가 쟁점이었습니다. 법원은 <strong>추락사고가 발생했다는 사실만으로 발판의 강도 기준 미달을 인정할 수는 없다</strong>고 보았습니다. 구조검토보고서의 내용과 이를 반박할 증거가 있는지가 중요했습니다.</p>\n<p class=\"case-text\">출입금지 조치가 필요했는지는 근로자가 맡은 작업과 연결됩니다. 사고를 당한 근로자는 구조물 설치에 필수적인 비계 설치작업을 수행하고 있었습니다. 따라서 출입을 막아야 할 ‘관계 근로자가 아닌 사람’에 해당하는지가 별도로 검토되었습니다. 이처럼 형사책임은 사고의 중대성뿐 아니라 작업 공정, 시설의 강도, 근로자의 업무 범위를 구분해 판단합니다.</p></section><section class=\"section\" id=\"section-assistance\"><h2 class=\"section-title\">업무상과실치상·산업안전보건법위반 무죄를 위한 YK 담당 변호사의 조력</h2><section id=\"section-assistance-sub-1\"><h3 class=\"subsection-title\">후속 작업 공정을 근거로 발판 임시 고정의 적정성 소명</h3><p class=\"case-text\">YK 담당 변호사는 계단참을 후속 안전데크와 연결·조정하려면 철선으로 임시 고정할 필요가 있었다고 주장했습니다. 먼저 완전히 고정하면 이후 다시 해체해야 해 오히려 위험이 커질 수 있다는 점도 짚었습니다. <mark class=\"assistance-highlight\"><strong>임시 고정이라는 이유만으로 주의의무 위반으로 볼 수 없다는 점</strong></mark>을 강조했습니다.</p></section><section id=\"section-assistance-sub-2\"><h3 class=\"subsection-title\">구조검토보고서를 근거로 발판 강도 기준 충족 주장</h3><p class=\"case-text\">YK 담당 변호사는 구조검토보고서를 근거로 작업발판이 매제곱미터당 500킬로그램 이상의 하중을 견디는 강도 기준을 충족한다고 주장했습니다. 보고서에 반하는 별도 증거가 없다는 점도 지적했습니다. <mark class=\"assistance-highlight\"><strong>발판 탈락 사고와 발판 자체의 강도 미달은 구분해 판단해야 한다는 취지</strong></mark>였습니다.</p></section><section id=\"section-assistance-sub-3\"><h3 class=\"subsection-title\">비계 설치 업무를 근거로 관계 근로자 해당성 소명</h3><p class=\"case-text\">YK 담당 변호사는 피해자가 상부 계단과 안전데크 설치에 필요한 <mark class=\"assistance-highlight\"><strong>비계 설치작업을 수행하던 근로자라는 점</strong></mark>을 짚었습니다. 비계 설치는 구조물 설치에 필수적인 공정이므로, 피해자를 출입금지 대상인 ‘관계 근로자가 아닌 사람’으로 볼 수 없다고 주장했습니다. 따라서 피해자의 작업구역 출입만으로 출입금지 조치 위반을 인정해서는 안 된다는 점을 소명했습니다.</p></section></section><section class=\"section\" id=\"section-result\"><h2 class=\"section-title\">업무상과실치상 사건 결과 : 무죄</h2><p class=\"case-text\">법원은 의뢰인을 포함한 <strong>피고인들 전원에게 무죄를 선고했습니다.</strong></p>\n<div class=\"circled-result\"><p class=\"case-text\">① <strong>철선 임시 고정은 후속 안전데크와의 연결·조정을 위한 정상적인 작업 방법인 점</strong></p><p class=\"case-text\">② <strong>사고 발생만으로 발판의 강도 기준 미달을 인정할 수 없고, 구조검토보고서에 반하는 별도 증거도 없는 점</strong></p><p class=\"case-text\">③ <strong>피해자는 구조물 설치에 필수적인 비계 작업을 수행한 근로자로, 출입금지 대상에 해당한다고 볼 증거가 없는 점</strong></p></div>\n<p class=\"case-text\">그 결과 의뢰인은 업무상 주의의무 위반과 산업재해 예방조치 미이행이 충분히 증명되지 않아 무죄 판결을 받았습니다. 이번 사건은 YK 담당 변호사가 짚은 작업공정의 적정성, 발판의 강도, 근로자의 작업 범위가 형사책임 판결의 핵심이 된 사례입니다.</p>\n<p class=\"case-text\"></p></section>\n    \n    <div class=\"tags\"><span class=\"tag\">업무상과실치상</span><span class=\"tag\">산업안전보건법위반</span><span class=\"tag\">산재사고</span><span class=\"tag\">무죄판결</span><span class=\"tag\">노동/산재</span><span class=\"tag\">기타</span></div>\n  </main>\n</article>\n\n\n  \n\n</div>"}