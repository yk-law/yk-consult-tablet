color: #fff; background: #102169; }\n.case-role-value { padding: 5px 9px; color: #102169; background: #f3f6ff; }\n.case-summary-table { width: 100%; border-collapse: collapse; table-layout: fixed; font-size: 15px; }\n.case-summary-label, .case-summary-value { border-top: 1px solid #e5eaf3; padding: 11px 0; vertical-align: top; text-align: left; }\n.case-summary-row-first { border-top: 0; }\n.case-summary-label { width: 118px; color: #1a2744; font-weight: 800; }\n.case-summary-value { color: #374151; font-weight: 600; }\n.toc { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: 24px 32px; margin-bottom: 20px; }\n.toc-title { font-size: 11px; font-weight: 700; letter-spacing: 2px; color: #9ca3af; text-transform: uppercase; margin-bottom: 14px; }\n.toc-list { list-style: none; padding: 0; margin: 0; }\n.toc-item { margin-bottom: 8px; font-size: 16px; }\n.toc-link { color: #102169; font-weight: 600; text-decoration: none; }\n.toc .toc-sub { margin: 4px 0 0 18px; }\n.toc .toc-sub .toc-link { color: #4b5563; font-size: 15px; font-weight: 400; }\n.section { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: 36px 40px; margin-bottom: 20px; }\n.section-title { color: #1a2744; font-size: 22px; font-weight: 700; line-height: 1.4; margin: 0 0 18px; }\n.subsection-title { color: #2d4a8a; font-size: 18px; font-weight: 700; line-height: 1.4; margin: 24px 0 10px; }\n.case-text { color: #374151; font-size: 17px; margin: 0 0 14px; }\n.case-list { list-style-type: disc; padding-left: 1.5rem; margin: 10px 0 14px; }\n.case-list-item { color: #374151; margin-bottom: 6px; font-weight: 800; }\n.assistance-highlight { background: linear-gradient(transparent 58%, #fde68a 58%); padding: 0 2px; font-weight: 800; color: #1f2937; }\n.public-text-issue { background: #fee2e2; color: #991b1b; border: 1px solid #ef4444; border-radius: 4px; box-shadow: 0 0 0 2px rgba(239, 68, 68, 0.16); padding: 0 3px; font-weight: 900; }\n.ref-box, .def-box, .qna-box, .order-box { background: #f9fafb; border-left: 4px solid #102169; border-radius: 4px; padding: 16px 20px; margin: 16px 0; font-size: 15px; }\n.case-table { width: 100%; border-collapse: collapse; margin: 16px 0 20px; font-size: 15px; table-layout: fixed; }\n.case-table-head, .case-table-cell { border: 1px solid #dbe1ee; padding: 10px 12px; vertical-align: top; word-break: keep-all; }\n.case-table-head { background: #f3f6fb; color: #1a2744; font-weight: 700; }\n.assistance-image { margin: 24px 0 4px; aspect-ratio: 16 / 9; overflow: hidden; border-radius: 8px; border: 1px solid #e5e7eb; }\n.assistance-image-img { display: block; width: 100%; height: 100%; object-fit: cover; border: 0; }\n.result-cta { background: #15266f; border-radius: 8px; padding: 28px 36px; margin-top: 28px; margin-bottom: 0; color: #fff; }\n.result-cta-text { color: #fff; font-size: 16px; font-weight: 700; line-height: 1.65; margin: 0 0 20px; }\n.result-cta-button { display: inline-block; background: #fff; color: #15266f; text-decoration: none; font-size: 15px; font-weight: 800; padding: 12px 22px; border-radius: 7px; }\n.result-cta + .tags { margin-top: 40px; }\n.footer-note { text-align: center; font-size: 14px; color: #9ca3af; padding: 20px 24px 40px; margin: 0; }\n@page { margin: 12mm; }\n/* 모바일만: 좌우 여백을 살짝 줄여 본문 폭 확보. PC 레이아웃은 유지. */\n@media (max-width: 720px) {\n  .preview-header { padding: 28px 18px; }\n  .preview-container { padding: 20px 12px 56px; }\n  .section { padding: 26px 16px; }\n  .section-title { font-size: 20px; }\n  .subsection-title { font-size: 17px; }\n  .case-text { font-size: 16px; }\n  .toc { padding: 18px 16px; }\n  .case-summary-card { padding: 18px 16px; }\n  .case-summary-table { font-size: 14px; }\n  .case-summary-label { width: 96px; }\n  .ref-box, .def-box, .qna-box, .order-box { padding: 14px 14px; }\n  .result-cta { padding: 22px 18px; }\n}\n@media (max-width: 768px) {\n  .preview-header .preview-lead { font-size: 22px; line-height: 1.4; }\n}\n@media print {\n  .preview-result, .preview-result { background: #f8fafc !important; }\n  .preview-header, .result-cta, .case-role-label, .case-table-head, .tag, .case-role-value, .ref-box, .def-box, .qna-box, .order-box {\n    -webkit-print-color-adjust: exact !important;\n    print-color-adjust: exact !important;\n  }\n  .preview-container { padding-bottom: 40px; }\n  .section, .toc, .case-summary-card, .result-cta { break-inside: avoid; page-break-inside: avoid; }\n  .result-cta + .tags { margin-top: 42px; }\n}\n}</style><div data-embedded-case-html-root=\"\" class=\"\" style=\"display:block;width:100%;min-width:0;box-sizing:border-box;\">\n\n<article class=\"preview-result\">\n  <header class=\"preview-header\">\n    <div class=\"label\">YK SUCCESS CASE</div>\n    <p class=\"preview-lead\">공사현장 관리 업무를 맡았던 의뢰인은 납품 관련자와 공모해 사석 납품수량을 부풀리고 피해업체에 대금을 청구한 혐의로 수사기관의 수사를 받은 뒤, 사기 및 업무상배임 혐의로 검찰에 기소 의견 송치되었습니다.</p>\n  </header>\n  <main class=\"preview-container\">\n    <div class=\"lead\" id=\"section-overview\">\n<p class=\"case-text\">YK 담당 변호사는 피해업체와의 합의서를 제출하고 검사실에서 직접 변론하며 의뢰인이 범행으로 얻은 이익이 없는 점과 사건 경위의 참작 사유를 소명했으며, 의뢰인은 기소유예 처분을 받았습니다.</p></div>\n    <section class=\"case-summary-card\" aria-label=\"사건 결과 요약\"><div class=\"case-summary-title\"><span>사건 결과 요약</span><span class=\"case-role-badges\"><span class=\"case-role-badge case-role-badge-client\"><span class=\"case-role-label\">의뢰인</span><span class=\"case-role-value\">피의자</span></span></span></div><table class=\"case-summary-table\"><tbody><tr><th class=\"case-summary-label case-summary-row-first\" scope=\"row\">사건 유형</th><td class=\"case-summary-value case-summary-row-first\">일반사기</td></tr><tr><th class=\"case-summary-label\" scope=\"row\">쟁점</th><td class=\"case-summary-value\">피해업체와의 합의 및 처벌불원, 의뢰인의 이익 취득 여부, 손해보전 요구를 수용한 경위</td></tr><tr><th class=\"case-summary-label\" scope=\"row\">결과</th><td class=\"case-summary-value\">기소유예</td></tr><tr><th class=\"case-summary-label\" scope=\"row\">대응 포인트</th><td class=\"case-summary-value\">합의서 제출과 검사실 직접 변론을 통해 이익 미취득 및 사건 경위의 참작 사유 소명</td></tr></tbody></table></section><div data-case-cta-slot=\"top\"></div>\n    <nav class=\"toc\"><div class=\"toc-title\">CONTENTS</div><ul class=\"toc-list\"><li class=\"toc-item\"><a class=\"toc-link\">납품대금 사기 혐의로 검찰에 송치된 경위</a></li><li class=\"toc-item\"><a class=\"toc-link\">일반사기 처벌 수위와 양형요소</a><ul class=\"toc-list toc-sub\"><li class=\"toc-item\"><a class=\"toc-link\">처벌 수위와 적용 법령</a></li><li class=\"toc-item\"><a class=\"toc-link\">양형기준과 감경·가중요소</a></li></ul></li><li class=\"toc-item\"><a class=\"toc-link\">사기·업무상배임 기소유예를 위한 YK 담당 변호사의 조력</a><ul class=\"toc-list toc-sub\"><li class=\"toc-item\"><a class=\"toc-link\">피해업체의 처벌불원 의사를 담은 합의서 제출</a></li><li class=\"toc-item\"><a class=\"toc-link\">검사실 직접 변론으로 사건 경위의 참작 사유 소명</a></li></ul></li><li class=\"toc-item\"><a class=\"toc-link\">일반사기 사건 결과 : 기소유예</a></li></ul></nav>\n    <section class=\"section\" id=\"section-background\"><h2 class=\"section-title\">납품대금 사기 혐의로 검찰에 송치된 경위</h2><p class=\"case-text\">의뢰인은 공사현장 관리 업무를 맡던 중 사석 납품대금 청구 문제로 수사를 받게 되었습니다.</p>\n<p class=\"case-text\">납품을 중개·관리한 사람과 공모해 실제보다 납품수량을 부풀리고, 이를 토대로 피해업체에 대금을 청구했다는 사기 및 업무상배임 혐의였습니다.</p>\n<p class=\"case-text\">문제가 된 것은 총 10회에 걸쳐 지급된 납품대금 중 약 3억 7천만 원에 해당하는 허위물량 대금이었습니다.</p>\n<p class=\"case-text\">현장 관리 과정에서 정확한 납품수량과 적정한 대금 지급을 확인해야 할 의무를 위반했는지도 수사 대상이 됐습니다.</p>\n<p class=\"case-text\">수사기관이 직접 혐의를 포착해 수사를 진행했고, 사건은 <strong>기소 의견으로 검찰에 송치</strong>되었습니다.</p>\n<p class=\"case-text\">의뢰인은 검찰 단계에서 사건 경위와 자신의 관여 내용을 설명하고 법적 대응을 준비하기 위해 YK 담당 변호사의 조력을 받게 되었습니다.</p><figure class=\"assistance-image\"><img class=\"assistance-image-img\" src=\"https://www.yklawfirm.co.kr/ai_case/15188/6d6511799de6d3cf.webp\" alt=\"사기 혐의 송치 후 합의와 검사실 변론 대응\"></figure></section><section class=\"section\" id=\"section-info-1\"><h2 class=\"section-title\">일반사기 처벌 수위와 양형요소</h2><section id=\"section-info-1-sub-1\"><h3 class=\"subsection-title\">처벌 수위와 적용 법령</h3><p class=\"case-text\">사기는 사람을 속여 재물이나 재산상 이익을 얻었는지를 살펴 판단하며, 형법 제347조에 따라 <strong>20년 이하의 징역 또는 5천만 원 이하의 벌금</strong>에 처할 수 있습니다. 업무상배임은 형법 제356조에 따라 <strong>10년 이하의 징역 또는 3천만 원 이하의 벌금</strong>에 처할 수 있습니다. 자신이 아니라 제3자가 이익을 얻도록 한 경우에도 처벌 대상이 될 수 있습니다.</p>\n<div class=\"ref-box\"><span class=\"ref-title\">관련 쟁점은 <strong><a rel=\"noopener noreferrer\">처벌불원서 양식 작성방법, 첨부서류, 제출기한</a></strong>에서 확인하실 수 있습니다.</span><span class=\"ref-body\"></span></div>\n<p class=\"case-text\">법령 안내 기준: 2026년 10월 24일. 아래 사건의 범행 시점과 적용 법률은 별도로 확인해야 합니다. 사기죄의 법정형은 2025년 12월 23일 개정되었으며, 개정 전 행위에는 행위 당시 법률의 적용 여부를 확인해야 합니다. 근거: 형법 제347조, 법무부 개정·시행 안내.</p>\n<p class=\"case-text\">따라서 본인이 납품대금을 직접 받지 않았다는 사정만으로 사기 혐의가 배제되는 것은 아닙니다. 허위 청구에 가담했는지, 그로 인해 다른 사람이 이익을 얻었는지를 함께 살펴야 합니다.</p>\n<p class=\"case-text\"><strong>초범이라고 해서 반드시 벌금형이나 기소유예로 끝나는 것은 아닙니다.</strong> 피해금액과 가담 정도, 피해 회복 여부 등을 함께 고려합니다.</p></section><section id=\"section-info-1-sub-2\"><h3 class=\"subsection-title\">양형기준과 감경·가중요소</h3><table class=\"case-table\"><thead><tr><th class=\"case-table-head\">구분</th><th class=\"case-table-head\">감경요소</th><th class=\"case-table-head\">가중요소</th></tr></thead><tbody><tr><td class=\"case-table-cell\">행위</td><td class=\"case-table-cell\">참작할 만한 범행 경위, 피해나 위험이 낮은 사정</td><td class=\"case-table-cell\">위험성이나 피해가 큰 사정</td></tr><tr><td class=\"case-table-cell\">행위자·기타</td><td class=\"case-table-cell\">반성, 피해 회복, 재범 방지 노력</td><td class=\"case-table-cell\">재범, 증거은폐, 범행 후 정황이 불리한 사정</td></tr></tbody></table>\n<p class=\"case-text\">양형기준은 법원이 형량을 정할 때 참고하는 기준입니다. 일반사기는 이득액에 따라 유형을 구분하고, 범행 경위와 피해 회복 등 사정에 따라 감경·기본·가중 구간을 판단합니다. 검찰의 기소유예 여부와 법원의 형량 판단은 구분해야 합니다.</p>\n<p class=\"case-text\">처벌을 가볍게 정하는 데 고려될 수 있는 사정은 형사처벌 이력이 없는 점, 가담 경위에 참작할 사유가 있는 점, 피해 회복과 피해자의 처벌불원 의사 등입니다. 반대로 계획적·조직적 범행, 장기간 반복한 범행, 일반사기 전력이나 증거은폐 등은 불리하게 고려될 수 있습니다.</p>\n<p class=\"case-text\">이 사건에서 문제 된 허위물량 대금은 약 3억 7천만 원입니다. 검찰은 피의사실을 인정하면서도 현장소장은 초범이고 공사팀 차장은 벌금 전과 1회 외 다른 범죄전력이 없는 점, 범행 경위에 참작할 사유가 있는 점, 직접 얻은 이익이 없다는 점을 고려했습니다.</p>\n<p class=\"case-text\">피해업체와의 원만한 합의 및 처벌을 원하지 않는다는 의사 역시 중요한 참작 사정이었습니다. YK 담당 변호사는 합의서를 제출하고 검사실에서 직접 변론했으며, 사건은 <strong>기소유예로 종결됐습니다.</strong> 다만 합의나 처벌불원 의사가 있다고 해서 사기 사건이 자동으로 종결되는 것은 아닙니다.</p></section></section><section class=\"section\" id=\"section-assistance\"><h2 class=\"section-title\">사기·업무상배임 기소유예를 위한 YK 담당 변호사의 조력</h2><section id=\"section-assistance-sub-1\"><h3 class=\"subsection-title\">피해업체의 처벌불원 의사를 담은 합의서 제출</h3><p class=\"case-text\">수사기관이 기소 의견으로 사건을 검찰에 넘긴 상황에서, YK 담당 변호사는 <mark class=\"assistance-highlight\"><strong>피해업체가 의뢰인과 합의하고 처벌을 원하지 않는다는 의사를 담은 합의서</strong></mark>를 제출했습니다. 합의만으로 기소유예가 보장되는 것은 아니지만, 검찰이 처분을 결정할 때 피해업체의 의사도 참작할 수 있도록 전달했습니다.</p></section><section id=\"section-assistance-sub-2\"><h3 class=\"subsection-title\">검사실 직접 변론으로 사건 경위의 참작 사유 소명</h3><p class=\"case-text\">YK 담당 변호사는 검사실에서 직접 변론하며, 납품을 중개·관리한 사람이 수량 측정 오류와 단가 문제를 이유로 손해보전을 요구했고 의뢰인이 공사 진행을 위해 이를 수용하게 된 경위를 주장했습니다. 이와 함께 <mark class=\"assistance-highlight\"><strong>의뢰인이 범행으로 얻은 이익이 없다는 점</strong></mark>을 강조하며 기소유예 처분을 요청했습니다. 제3자가 이익을 얻은 행위의 책임을 부정하기보다, 의뢰인의 이익 취득 여부와 요구를 수용한 경위가 처분 판단에 함께 반영되도록 하는 데 초점을 맞췄습니다.</p></section></section><section class=\"section\" id=\"section-result\"><h2 class=\"section-title\">일반사기 사건 결과 : 기소유예</h2><p class=\"case-text\">검찰은 의뢰인의 <strong>사기 및 업무상배임 혐의에 대해 기소유예 처분</strong>을 내렸습니다.</p>\n<div class=\"circled-result\"><p class=\"case-text\">① <strong>피해업체와 원만히 합의한 점</strong></p><p class=\"case-text\">② <strong>피해업체가 의뢰인의 처벌을 원하지 않는다는 의사를 밝힌 점</strong></p><p class=\"case-text\">③ <strong>의뢰인이 범행으로 얻은 이익이 없는 점</strong></p><p class=\"case-text\">④ <strong>납품 관련자가 수량 측정 오류와 단가 문제 등을 이유로 손해보전을 요구하자, 원활한 공사 진행을 위해 이를 수용한 경위에 참작할 사유가 있는 점</strong></p></div>\n<p class=\"case-text\">그 결과 의뢰인은 기소 의견으로 송치된 사건에서 재판에 넘겨지지 않고 기소유예로 사건을 마무리했습니다. 이번 사건은 YK 담당 변호사가 합의서 제출과 검사실 직접 변론으로 전달한 피해업체의 처벌불원 의사와 사건 경위가 기소유예 처분에 참작된 사례입니다.</p>\n<p class=\"case-text\"></p></section>\n    \n    <div class=\"tags\"><span class=\"tag\">사기기소유예</span><span class=\"tag\">업무상배임</span><span class=\"tag\">납품대금</span><span class=\"tag\">피해자합의</span><span class=\"tag\">형사</span><span class=\"tag\">일반사기</span></div>\n  </main>\n</article>\n\n\n  \n\n</div>"}