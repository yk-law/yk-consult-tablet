#fff; background: #102169; }\n.case-role-value { padding: 5px 9px; color: #102169; background: #f3f6ff; }\n.case-summary-table { width: 100%; border-collapse: collapse; table-layout: fixed; font-size: 15px; }\n.case-summary-label, .case-summary-value { border-top: 1px solid #e5eaf3; padding: 11px 0; vertical-align: top; text-align: left; }\n.case-summary-row-first { border-top: 0; }\n.case-summary-label { width: 118px; color: #1a2744; font-weight: 800; }\n.case-summary-value { color: #374151; font-weight: 600; }\n.toc { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: 24px 32px; margin-bottom: 20px; }\n.toc-title { font-size: 11px; font-weight: 700; letter-spacing: 2px; color: #9ca3af; text-transform: uppercase; margin-bottom: 14px; }\n.toc-list { list-style: none; padding: 0; margin: 0; }\n.toc-item { margin-bottom: 8px; font-size: 16px; }\n.toc-link { color: #102169; font-weight: 600; text-decoration: none; }\n.toc .toc-sub { margin: 4px 0 0 18px; }\n.toc .toc-sub .toc-link { color: #4b5563; font-size: 15px; font-weight: 400; }\n.section { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: 36px 40px; margin-bottom: 20px; }\n.section-title { color: #1a2744; font-size: 22px; font-weight: 700; line-height: 1.4; margin: 0 0 18px; }\n.subsection-title { color: #2d4a8a; font-size: 18px; font-weight: 700; line-height: 1.4; margin: 24px 0 10px; }\n.case-text { color: #374151; font-size: 17px; margin: 0 0 14px; }\n.case-list { list-style-type: disc; padding-left: 1.5rem; margin: 10px 0 14px; }\n.case-list-item { color: #374151; margin-bottom: 6px; font-weight: 800; }\n.assistance-highlight { background: linear-gradient(transparent 58%, #fde68a 58%); padding: 0 2px; font-weight: 800; color: #1f2937; }\n.public-text-issue { background: #fee2e2; color: #991b1b; border: 1px solid #ef4444; border-radius: 4px; box-shadow: 0 0 0 2px rgba(239, 68, 68, 0.16); padding: 0 3px; font-weight: 900; }\n.ref-box, .def-box, .qna-box, .order-box { background: #f9fafb; border-left: 4px solid #102169; border-radius: 4px; padding: 16px 20px; margin: 16px 0; font-size: 15px; }\n.case-table { width: 100%; border-collapse: collapse; margin: 16px 0 20px; font-size: 15px; table-layout: fixed; }\n.case-table-head, .case-table-cell { border: 1px solid #dbe1ee; padding: 10px 12px; vertical-align: top; word-break: keep-all; }\n.case-table-head { background: #f3f6fb; color: #1a2744; font-weight: 700; }\n.assistance-image { margin: 24px 0 4px; aspect-ratio: 16 / 9; overflow: hidden; border-radius: 8px; border: 1px solid #e5e7eb; }\n.assistance-image-img { display: block; width: 100%; height: 100%; object-fit: cover; border: 0; }\n.result-cta { background: #15266f; border-radius: 8px; padding: 28px 36px; margin-top: 28px; margin-bottom: 0; color: #fff; }\n.result-cta-text { color: #fff; font-size: 16px; font-weight: 700; line-height: 1.65; margin: 0 0 20px; }\n.result-cta-button { display: inline-block; background: #fff; color: #15266f; text-decoration: none; font-size: 15px; font-weight: 800; padding: 12px 22px; border-radius: 7px; }\n.result-cta + .tags { margin-top: 40px; }\n.footer-note { text-align: center; font-size: 14px; color: #9ca3af; padding: 20px 24px 40px; margin: 0; }\n@page { margin: 12mm; }\n/* 모바일만: 좌우 여백을 살짝 줄여 본문 폭 확보. PC 레이아웃은 유지. */\n@media (max-width: 720px) {\n  .preview-header { padding: 28px 18px; }\n  .preview-container { padding: 20px 12px 56px; }\n  .section { padding: 26px 16px; }\n  .section-title { font-size: 20px; }\n  .subsection-title { font-size: 17px; }\n  .case-text { font-size: 16px; }\n  .toc { padding: 18px 16px; }\n  .case-summary-card { padding: 18px 16px; }\n  .case-summary-table { font-size: 14px; }\n  .case-summary-label { width: 96px; }\n  .ref-box, .def-box, .qna-box, .order-box { padding: 14px 14px; }\n  .result-cta { padding: 22px 18px; }\n}\n@media (max-width: 768px) {\n  .preview-header .preview-lead { font-size: 22px; line-height: 1.4; }\n}\n@media print {\n  .preview-result, .preview-result { background: #f8fafc !important; }\n  .preview-header, .result-cta, .case-role-label, .case-table-head, .tag, .case-role-value, .ref-box, .def-box, .qna-box, .order-box {\n    -webkit-print-color-adjust: exact !important;\n    print-color-adjust: exact !important;\n  }\n  .preview-container { padding-bottom: 40px; }\n  .section, .toc, .case-summary-card, .result-cta { break-inside: avoid; page-break-inside: avoid; }\n  .result-cta + .tags { margin-top: 42px; }\n}\n}</style><div data-embedded-case-html-root=\"\" class=\"\" style=\"display:block;width:100%;min-width:0;box-sizing:border-box;\">\n\n<article class=\"preview-result\">\n  <header class=\"preview-header\">\n    <div class=\"label\">YK SUCCESS CASE</div>\n    <p class=\"preview-lead\">의뢰인은 대출용 매출자료가 필요하고 결제일 전에 승인을 취소하겠다고 피해자들을 속여 받은 카드정보로 결제하거나, 허락 없이 카드정보를 사용해 약 4,600만 원의 재산상 이익을 얻은 혐의로 재판을 받았습니다.</p>\n  </header>\n  <main class=\"preview-container\">\n    <div class=\"lead\" id=\"section-overview\">\n<p class=\"case-text\">YK 담당 변호사는 의뢰인이 잘못을 인정한 점과 피해회복이 지연된 뒤 피해자와 합의해 처벌불원 의사를 받은 사정 등을 강조했으며, 의뢰인은 징역 6개월에 집행유예 2년을 선고받았습니다.</p></div>\n    <section class=\"case-summary-card\" aria-label=\"사건 결과 요약\"><div class=\"case-summary-title\"><span>사건 결과 요약</span><span class=\"case-role-badges\"><span class=\"case-role-badge case-role-badge-client\"><span class=\"case-role-label\">의뢰인</span><span class=\"case-role-value\">피고인</span></span></span></div><table class=\"case-summary-table\"><tbody><tr><th class=\"case-summary-label case-summary-row-first\" scope=\"row\">사건 유형</th><td class=\"case-summary-value case-summary-row-first\">일반사기</td></tr><tr><th class=\"case-summary-label\" scope=\"row\">쟁점</th><td class=\"case-summary-value\">피해자 합의 및 처벌불원, 잘못의 인정, 확정된 사기 사건과 함께 재판받았을 경우의 형평, 자녀 부양 사정</td></tr><tr><th class=\"case-summary-label\" scope=\"row\">결과</th><td class=\"case-summary-value\">집행유예</td></tr><tr><th class=\"case-summary-label\" scope=\"row\">대응 포인트</th><td class=\"case-summary-value\">합의와 처벌불원 의사, 자녀 부양 사정 및 함께 재판받았을 경우의 형평을 근거로 선처 요청</td></tr></tbody></table></section><div data-case-cta-slot=\"top\"></div>\n    <nav class=\"toc\"><div class=\"toc-title\">CONTENTS</div><ul class=\"toc-list\"><li class=\"toc-item\"><a class=\"toc-link\">카드정보 사용으로 사기 혐의를 받은 의뢰인</a></li><li class=\"toc-item\"><a class=\"toc-link\">일반사기 처벌 수위와 양형요소</a><ul class=\"toc-list toc-sub\"><li class=\"toc-item\"><a class=\"toc-link\">처벌 수위와 적용 법령</a></li><li class=\"toc-item\"><a class=\"toc-link\">양형기준과 감경·가중요소</a></li></ul></li><li class=\"toc-item\"><a class=\"toc-link\">사기 집행유예를 위한 YK 담당 변호사의 조력</a><ul class=\"toc-list toc-sub\"><li class=\"toc-item\"><a class=\"toc-link\">피해자와의 합의를 근거로 처벌불원 의사 소명</a></li><li class=\"toc-item\"><a class=\"toc-link\">자녀 부양 사정을 선처 요소로 정리</a></li></ul></li><li class=\"toc-item\"><a class=\"toc-link\">일반사기 사건 결과 : 집행유예</a></li></ul></nav>\n    <section class=\"section\" id=\"section-background\"><h2 class=\"section-title\">카드정보 사용으로 사기 혐의를 받은 의뢰인</h2><p class=\"case-text\">의뢰인은 대출에 필요한 매출자료를 만들고, 카드대금 결제일 전에 승인을 취소하겠다고 말해 피해자들로부터 신용카드 정보를 받았습니다.</p>\n<p class=\"case-text\">그러나 실제로는 결제대행사를 통해 현금화해 사용할 목적이었고, 카드대금을 지급할 의사나 능력이 없는 상태에서 결제를 진행했습니다.</p>\n<p class=\"case-text\">여기에 피해자의 허락 없이 카드정보를 입력해 결제한 일도 문제가 됐습니다.</p>\n<p class=\"case-text\">이처럼 카드정보를 받아 결제하거나 허락 없이 사용한 행위로 얻은 재산상 이익은 <strong>총 약 4,600만 원</strong>에 이르렀습니다.</p>\n<p class=\"case-text\">의뢰인은 사기·컴퓨터등사용사기 혐의로 형사절차에 대응해야 했습니다.</p>\n<p class=\"case-text\">카드정보를 받은 경위와 사용 방식이 쟁점이 된 상황에서, 법적 조력을 받고자 YK 담당 변호사를 찾았습니다.</p><figure class=\"assistance-image\"><img class=\"assistance-image-img\" src=\"https://www.yklawfirm.co.kr/ai_case/16833/9420fdc70b347d68.webp\" alt=\"신용카드정보 부정사용 사기 혐의와 피해자 합의로 집행유예 대응\"></figure></section><section class=\"section\" id=\"section-info-1\"><h2 class=\"section-title\">일반사기 처벌 수위와 양형요소</h2><section id=\"section-info-1-sub-1\"><h3 class=\"subsection-title\">처벌 수위와 적용 법령</h3><p class=\"case-text\">이 사건에 적용된 구 형법 제347조 제1항은 사람을 속여 재물이나 재산상 이익을 얻은 경우 <strong>10년 이하의 징역 또는 2천만 원 이하의 벌금</strong>에 처하도록 정하고 있습니다. 카드정보를 받을 당시 어떤 설명을 했는지, 실제로 결제를 취소하거나 카드대금을 지급할 의사와 능력이 있었는지가 중요한 판단 대상입니다.</p>\n<div class=\"ref-box\"><span class=\"ref-title\">관련 쟁점은 <strong><a rel=\"noopener noreferrer\">사기죄 합의 안하면 형량은? 사기죄 합의 중요성</a></strong>에서 확인하실 수 있습니다.</span><span class=\"ref-body\"></span></div>\n<p class=\"case-text\">법령 안내 기준: 2026년 10월 24일. 아래 사건의 범행 시점과 적용 법률은 별도로 확인해야 합니다. 사기죄의 법정형은 2025년 12월 23일 개정되었으며, 개정 전 행위에는 행위 당시 법률의 적용 여부를 확인해야 합니다. 근거: 형법 제347조, 법무부 개정·시행 안내.</p>\n<p class=\"case-text\">피해자의 허락 없이 카드정보를 입력해 결제한 행위에는 형법 제347조의2의 컴퓨터등사용사기죄가 적용됐습니다. 이는 컴퓨터 등 정보처리장치에 권한 없이 정보를 입력하는 등의 방법으로 재산상 이익을 얻는 행위를 처벌하는 규정입니다. 이 사건에 적용된 법률상 처벌 범위는 사기죄와 같습니다.</p></section><section id=\"section-info-1-sub-2\"><h3 class=\"subsection-title\">양형기준과 감경·가중요소</h3><table class=\"case-table\"><thead><tr><th class=\"case-table-head\">구분</th><th class=\"case-table-head\">감경요소</th><th class=\"case-table-head\">가중요소</th></tr></thead><tbody><tr><td class=\"case-table-cell\">행위</td><td class=\"case-table-cell\">참작할 만한 범행 경위, 피해나 위험이 낮은 사정</td><td class=\"case-table-cell\">위험성이나 피해가 큰 사정</td></tr><tr><td class=\"case-table-cell\">행위자·기타</td><td class=\"case-table-cell\">반성, 피해 회복, 재범 방지 노력</td><td class=\"case-table-cell\">재범, 증거은폐, 범행 후 정황이 불리한 사정</td></tr></tbody></table>\n<p class=\"case-text\">양형기준은 법원이 구체적인 형량을 정할 때 참고하는 기준입니다. 사기 사건에서는 피해금액뿐 아니라 범행 수법과 반복성, 피해회복 정도, 반성 여부, 이전에 사기죄로 처벌받은 이력 등을 함께 살펴봅니다.</p>\n<p class=\"case-text\">여러 피해자를 상대로 범행했거나 장기간 반복한 사정은 불리하게 고려될 수 있습니다. 이 사건에서도 약 4,600만 원의 피해가 발생했고, 상당 기간 피해회복이 이루어지지 않은 점이 불리한 사정으로 평가됐습니다.</p>\n<p class=\"case-text\">반대로 잘못을 인정하고 진지하게 반성한 점, 피해를 회복하거나 피해자가 처벌을 원하지 않는 점은 감경요소가 될 수 있습니다. <strong>피해자와의 합의는 중요한 양형요소이지만, 합의만으로 처벌이 없어지는 것은 아닙니다.</strong></p>\n<p class=\"case-text\">이 사건에서는 잘못을 인정한 점과 뒤늦게 피해자와 합의해 피해자가 처벌을 원하지 않은 점이 고려됐습니다. 이미 형이 확정된 별도 사기 사건과 함께 재판받았을 때의 형평, 부양할 자녀가 있다는 사정도 형량 판단에 반영됐습니다.</p></section></section><section class=\"section\" id=\"section-assistance\"><h2 class=\"section-title\">사기 집행유예를 위한 YK 담당 변호사의 조력</h2><section id=\"section-assistance-sub-1\"><h3 class=\"subsection-title\">피해자와의 합의를 근거로 처벌불원 의사 소명</h3><p class=\"case-text\">YK 담당 변호사는 상당 기간 피해회복이 이루어지지 않은 점을 가볍게 다루지 않으면서, 의뢰인이 잘못을 인정하고 뒤늦게 피해자와 합의한 사정을 강조했습니다. 특히 <mark class=\"assistance-highlight\"><strong>피해자가 처벌을 원하지 않는다는 의사</strong></mark>를 형량을 정할 때 반영해 달라고 요청했습니다. 이는 피해회복이 지연된 불리한 사정을 인정하되, 이후 이루어진 합의 역시 선처 요소로 평가받기 위한 조력이었습니다.</p></section><section id=\"section-assistance-sub-2\"><h3 class=\"subsection-title\">자녀 부양 사정을 선처 요소로 정리</h3><p class=\"case-text\">YK 담당 변호사는 의뢰인에게 부양할 자녀가 있다는 생활관계를 선처 사유로 설명하되, 이를 범행의 책임을 줄이는 근거로 내세우지는 않았습니다. 이와 별도로, 이미 판결이 확정된 사기 사건과 이번 사건을 함께 재판받았을 경우의 형평도 형량에 반영해 달라고 강조했습니다. <mark class=\"assistance-highlight\"><strong>자녀 부양이라는 개인적 사정</strong></mark>과 함께 재판받았을 때의 형평이라는 법적 고려 사항을 구분해, 각각의 의미가 양형 판단에서 빠지지 않도록 했습니다.</p></section></section><section class=\"section\" id=\"section-result\"><h2 class=\"section-title\">일반사기 사건 결과 : 집행유예</h2><p class=\"case-text\">법원은 의뢰인에게 징역 6개월에 집행유예 2년을 선고했습니다.</p>\n<div class=\"circled-result\"><p class=\"case-text\">① <strong>의뢰인이 자신의 잘못을 인정한 점</strong></p><p class=\"case-text\">② <strong>뒤늦게나마 피해자와 합의하고, 피해자가 처벌을 원하지 않는다는 의사를 밝힌 점</strong></p><p class=\"case-text\">③ <strong>이미 판결이 확정된 사기 사건과 함께 재판받았을 경우의 형평을 고려할 필요가 있었던 점</strong></p><p class=\"case-text\">④ <strong>의뢰인에게 부양할 자녀가 있는 점</strong></p></div>\n<p class=\"case-text\">이번 사건은 합의 여부뿐 아니라 잘못의 인정, 피해자가 처벌을 원하지 않는다는 의사, 자녀 부양 사정 등이 함께 법원의 판결에 반영된 사례입니다.</p>\n<p class=\"case-text\"></p></section>\n    \n    <div class=\"tags\"><span class=\"tag\">사기</span><span class=\"tag\">컴퓨터등사용사기</span><span class=\"tag\">피해자합의</span><span class=\"tag\">집행유예</span><span class=\"tag\">형사</span><span class=\"tag\">일반사기</span></div>\n  </main>\n</article>\n\n\n  \n\n</div>"}