#fff; background: #102169; }\n.case-role-value { padding: 5px 9px; color: #102169; background: #f3f6ff; }\n.case-summary-table { width: 100%; border-collapse: collapse; table-layout: fixed; font-size: 15px; }\n.case-summary-label, .case-summary-value { border-top: 1px solid #e5eaf3; padding: 11px 0; vertical-align: top; text-align: left; }\n.case-summary-row-first { border-top: 0; }\n.case-summary-label { width: 118px; color: #1a2744; font-weight: 800; }\n.case-summary-value { color: #374151; font-weight: 600; }\n.toc { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: 24px 32px; margin-bottom: 20px; }\n.toc-title { font-size: 11px; font-weight: 700; letter-spacing: 2px; color: #9ca3af; text-transform: uppercase; margin-bottom: 14px; }\n.toc-list { list-style: none; padding: 0; margin: 0; }\n.toc-item { margin-bottom: 8px; font-size: 16px; }\n.toc-link { color: #102169; font-weight: 600; text-decoration: none; }\n.toc .toc-sub { margin: 4px 0 0 18px; }\n.toc .toc-sub .toc-link { color: #4b5563; font-size: 15px; font-weight: 400; }\n.section { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: 36px 40px; margin-bottom: 20px; }\n.section-title { color: #1a2744; font-size: 22px; font-weight: 700; line-height: 1.4; margin: 0 0 18px; }\n.subsection-title { color: #2d4a8a; font-size: 18px; font-weight: 700; line-height: 1.4; margin: 24px 0 10px; }\n.case-text { color: #374151; font-size: 17px; margin: 0 0 14px; }\n.case-list { list-style-type: disc; padding-left: 1.5rem; margin: 10px 0 14px; }\n.case-list-item { color: #374151; margin-bottom: 6px; font-weight: 800; }\n.assistance-highlight { background: linear-gradient(transparent 58%, #fde68a 58%); padding: 0 2px; font-weight: 800; color: #1f2937; }\n.public-text-issue { background: #fee2e2; color: #991b1b; border: 1px solid #ef4444; border-radius: 4px; box-shadow: 0 0 0 2px rgba(239, 68, 68, 0.16); padding: 0 3px; font-weight: 900; }\n.ref-box, .def-box, .qna-box, .order-box { background: #f9fafb; border-left: 4px solid #102169; border-radius: 4px; padding: 16px 20px; margin: 16px 0; font-size: 15px; }\n.case-table { width: 100%; border-collapse: collapse; margin: 16px 0 20px; font-size: 15px; table-layout: fixed; }\n.case-table-head, .case-table-cell { border: 1px solid #dbe1ee; padding: 10px 12px; vertical-align: top; word-break: keep-all; }\n.case-table-head { background: #f3f6fb; color: #1a2744; font-weight: 700; }\n.assistance-image { margin: 24px 0 4px; aspect-ratio: 16 / 9; overflow: hidden; border-radius: 8px; border: 1px solid #e5e7eb; }\n.assistance-image-img { display: block; width: 100%; height: 100%; object-fit: cover; border: 0; }\n.result-cta { background: #15266f; border-radius: 8px; padding: 28px 36px; margin-top: 28px; margin-bottom: 0; color: #fff; }\n.result-cta-text { color: #fff; font-size: 16px; font-weight: 700; line-height: 1.65; margin: 0 0 20px; }\n.result-cta-button { display: inline-block; background: #fff; color: #15266f; text-decoration: none; font-size: 15px; font-weight: 800; padding: 12px 22px; border-radius: 7px; }\n.result-cta + .tags { margin-top: 40px; }\n.footer-note { text-align: center; font-size: 14px; color: #9ca3af; padding: 20px 24px 40px; margin: 0; }\n@page { margin: 12mm; }\n/* 모바일만: 좌우 여백을 살짝 줄여 본문 폭 확보. PC 레이아웃은 유지. */\n@media (max-width: 720px) {\n  .preview-header { padding: 28px 18px; }\n  .preview-container { padding: 20px 12px 56px; }\n  .section { padding: 26px 16px; }\n  .section-title { font-size: 20px; }\n  .subsection-title { font-size: 17px; }\n  .case-text { font-size: 16px; }\n  .toc { padding: 18px 16px; }\n  .case-summary-card { padding: 18px 16px; }\n  .case-summary-table { font-size: 14px; }\n  .case-summary-label { width: 96px; }\n  .ref-box, .def-box, .qna-box, .order-box { padding: 14px 14px; }\n  .result-cta { padding: 22px 18px; }\n}\n@media (max-width: 768px) {\n  .preview-header .preview-lead { font-size: 22px; line-height: 1.4; }\n}\n@media print {\n  .preview-result, .preview-result { background: #f8fafc !important; }\n  .preview-header, .result-cta, .case-role-label, .case-table-head, .tag, .case-role-value, .ref-box, .def-box, .qna-box, .order-box {\n    -webkit-print-color-adjust: exact !important;\n    print-color-adjust: exact !important;\n  }\n  .preview-container { padding-bottom: 40px; }\n  .section, .toc, .case-summary-card, .result-cta { break-inside: avoid; page-break-inside: avoid; }\n  .result-cta + .tags { margin-top: 42px; }\n}\n}</style><div data-embedded-case-html-root=\"\" class=\"\" style=\"display:block;width:100%;min-width:0;box-sizing:border-box;\">\n\n<article class=\"preview-result\">\n  <header class=\"preview-header\">\n    <div class=\"label\">YK SUCCESS CASE</div>\n    <p class=\"preview-lead\">의뢰인은 사기 혐의로 기소되어 1심에서 실형을 선고받은 뒤, 형량이 무겁다는 이유로 항소했습니다.</p>\n  </header>\n  <main class=\"preview-container\">\n    <div class=\"lead\" id=\"section-overview\">\n<p class=\"case-text\">YK 담당 변호사는 항소심에서 의뢰인이 범행을 모두 인정하고 반성하는 태도와 피해자와의 합의로 피해자가 처벌을 원하지 않는 사정을 강조했으며, 의뢰인은 집행유예를 선고받았습니다.</p></div>\n    <section class=\"case-summary-card\" aria-label=\"사건 결과 요약\"><div class=\"case-summary-title\"><span>사건 결과 요약</span><span class=\"case-role-badges\"><span class=\"case-role-badge case-role-badge-client\"><span class=\"case-role-label\">의뢰인</span><span class=\"case-role-value\">피고인</span></span></span></div><table class=\"case-summary-table\"><tbody><tr><th class=\"case-summary-label case-summary-row-first\" scope=\"row\">사건 유형</th><td class=\"case-summary-value case-summary-row-first\">일반사기</td></tr><tr><th class=\"case-summary-label\" scope=\"row\">쟁점</th><td class=\"case-summary-value\">피해자 합의 및 처벌불원, 범행 인정과 반성, 1심 실형의 집행유예 변경 여부</td></tr><tr><th class=\"case-summary-label\" scope=\"row\">결과</th><td class=\"case-summary-value\">집행유예</td></tr><tr><th class=\"case-summary-label\" scope=\"row\">대응 포인트</th><td class=\"case-summary-value\">항소심 합의와 처벌불원, 범행 인정 및 반성을 근거로 선처 요청</td></tr></tbody></table></section><div data-case-cta-slot=\"top\"></div>\n    <nav class=\"toc\"><div class=\"toc-title\">CONTENTS</div><ul class=\"toc-list\"><li class=\"toc-item\"><a class=\"toc-link\">사기 사건 1심 실형 이후 항소한 경위</a></li><li class=\"toc-item\"><a class=\"toc-link\">일반사기 항소심 판단 기준</a><ul class=\"toc-list toc-sub\"><li class=\"toc-item\"><a class=\"toc-link\">항소심의 개념</a></li><li class=\"toc-item\"><a class=\"toc-link\">항소심 판단요소</a></li></ul></li><li class=\"toc-item\"><a class=\"toc-link\">일반사기 처벌 수위와 양형요소</a><ul class=\"toc-list toc-sub\"><li class=\"toc-item\"><a class=\"toc-link\">처벌 수위와 적용 법령</a></li><li class=\"toc-item\"><a class=\"toc-link\">양형기준과 감경·가중요소</a></li></ul></li><li class=\"toc-item\"><a class=\"toc-link\">사기 항소심 집행유예를 위한 YK 담당 변호사의 조력</a><ul class=\"toc-list toc-sub\"><li class=\"toc-item\"><a class=\"toc-link\">피해자와의 합의를 선처 사유로 주장</a></li><li class=\"toc-item\"><a class=\"toc-link\">범행을 인정하고 반성하는 태도 소명</a></li></ul></li><li class=\"toc-item\"><a class=\"toc-link\">일반사기 사건 결과 : 집행유예</a></li></ul></nav>\n    <section class=\"section\" id=\"section-background\"><h2 class=\"section-title\">사기 사건 1심 실형 이후 항소한 경위</h2><p class=\"case-text\">의뢰인은 사기 혐의로 기소되어 재판을 받았고, 1심에서 실형을 선고받았습니다.</p>\n<p class=\"case-text\">의뢰인은 1심 형량이 지나치게 무겁다는 이유로 항소해 형량을 다시 판단받고자 했습니다.</p>\n<p class=\"case-text\">검사도 항소했습니다.</p>\n<p class=\"case-text\">다만 의뢰인과 달리 1심 형량이 너무 가볍다는 이유였습니다.</p>\n<p class=\"case-text\">이에 항소심에서는 <strong>1심 형량이 적절한지</strong>를 두고 양측의 주장을 다시 살펴보게 되었습니다.</p>\n<p class=\"case-text\">의뢰인은 형량을 낮춰야 할 사정을 설명하고 검사의 항소에도 대응해야 하는 상황에서, YK 담당 변호사의 조력을 받아 항소심을 진행했습니다.</p><figure class=\"assistance-image\"><img class=\"assistance-image-img\" src=\"https://www.yklawfirm.co.kr/ai_case/18816/17ea0e88af3a1cfc.webp\" alt=\"사기죄 1심 실형 후 피해자 합의로 항소심 집행유예를 구한 사례\"></figure></section><section class=\"section\" id=\"section-info-1\"><h2 class=\"section-title\">일반사기 항소심 판단 기준</h2><section id=\"section-info-1-sub-1\"><h3 class=\"subsection-title\">항소심의 개념</h3><p class=\"case-text\">항소심은 1심 결과에 불복한 피고인이나 검사의 주장을 상급 법원이 다시 심리하는 절차입니다. 이 사건에서는 양측 모두 형량이 적절하지 않다는 이유로 항소했습니다. 이처럼 형이 너무 무겁거나 가볍다고 다투는 것을 ‘양형부당’이라고 합니다.</p>\n<div class=\"ref-box\"><span class=\"ref-title\">관련 쟁점은 <strong><a rel=\"noopener noreferrer\">사기죄 합의 안하면 형량은? 사기죄 합의 중요성</a></strong>에서 확인하실 수 있습니다.</span><span class=\"ref-body\"></span></div>\n<p class=\"case-text\">따라서 항소심의 핵심은 <strong>1심 형량이 사건의 책임과 여러 사정에 비추어 적절한지</strong>였습니다. 단순히 형을 낮춰 달라는 요청이 아니라, 형량을 바꿀 만한 이유가 있는지를 판단받는 과정입니다.</p></section><section id=\"section-info-1-sub-2\"><h3 class=\"subsection-title\">항소심 판단요소</h3><p class=\"case-text\">법원은 범행 내용과 피해 규모뿐 아니라 범행 이후의 태도와 항소심에서 달라진 사정도 함께 살펴봅니다. 특히 1심 이후 피해자와 합의했는지, 피해자가 처벌을 원하지 않는다는 의사를 밝혔는지는 중요한 판단 요소가 될 수 있습니다. 다만 합의가 이루어졌다는 이유만으로 집행유예가 보장되는 것은 아닙니다.</p>\n<p class=\"case-text\">이 사건에서 법원은 범행이 이루어진 기간과 피해 규모를 고려해 책임이 가볍지 않다고 보았습니다. 동시에 의뢰인이 범행을 모두 인정하고 반성하는 태도를 보인 점을 살폈습니다. 항소심에서 피해자와 합의해 피해자가 처벌을 원하지 않게 된 사정도 고려했습니다.</p>\n<p class=\"case-text\">그 밖에도 나이, 성격과 생활환경, 범행의 수단과 방법, 범행 전후의 정황을 함께 판단했습니다. 이처럼 항소심에서는 <strong>불리한 사정과 유리한 사정을 함께 살펴 형량 변경이 필요한지</strong>를 결정합니다.</p></section></section><section class=\"section\" id=\"section-info-2\"><h2 class=\"section-title\">일반사기 처벌 수위와 양형요소</h2><section id=\"section-info-2-sub-1\"><h3 class=\"subsection-title\">처벌 수위와 적용 법령</h3><p class=\"case-text\">사기죄는 사람을 속여 재물을 받거나 재산상 이익을 얻었을 때 성립합니다. 이 사건에는 <strong>행위 당시의 구 형법 제347조 제1항</strong>이 적용되었습니다. 해당 규정의 처벌 범위는 10년 이하의 징역 또는 2천만 원 이하의 벌금입니다. 개정된 현행법의 처벌 수위와는 구분해야 합니다.</p>\n<p class=\"case-text\">법에서 정한 처벌 범위가 곧 실제 선고되는 형량은 아닙니다. 법원은 범행 내용과 피해 규모, 피해 회복 여부 등을 살펴 형을 정합니다. 징역형을 선택하더라도 형법 제62조 제1항의 요건을 충족하면 집행유예를 선고할 수 있습니다. 집행유예는 정해진 기간 동안 형의 집행을 미루는 제도입니다.</p></section><section id=\"section-info-2-sub-2\"><h3 class=\"subsection-title\">양형기준과 감경·가중요소</h3><table class=\"case-table\"><thead><tr><th class=\"case-table-head\">구분</th><th class=\"case-table-head\">감경요소</th><th class=\"case-table-head\">가중요소</th></tr></thead><tbody><tr><td class=\"case-table-cell\">행위</td><td class=\"case-table-cell\">참작할 만한 범행 경위, 피해나 위험이 낮은 사정</td><td class=\"case-table-cell\">위험성이나 피해가 큰 사정</td></tr><tr><td class=\"case-table-cell\">행위자·기타</td><td class=\"case-table-cell\">반성, 피해 회복, 재범 방지 노력</td><td class=\"case-table-cell\">재범, 증거은폐, 범행 후 정황이 불리한 사정</td></tr></tbody></table>\n<p class=\"case-text\">양형기준은 법원이 형량을 정할 때 참고하는 기준입니다. 일반사기는 피해금액에 따라 권고 형량의 범위를 나누고, 범행 수법과 피해 회복 등 감경·가중요소를 함께 살핍니다.</p>\n<p class=\"case-text\">장기간 반복된 범행이나 계획적·조직적 범행, 다수의 피해자를 대상으로 한 범행은 불리하게 평가될 수 있습니다. 반면 진지한 반성, 실질적인 피해 회복, 피해자가 처벌을 원하지 않는다는 의사는 유리한 요소로 고려됩니다.</p>\n<p class=\"case-text\"><strong>피해자와의 합의는 중요한 양형요소이지만, 합의만으로 집행유예가 보장되지는 않습니다.</strong> 법원은 합의 내용과 함께 범행의 경위, 피해 정도, 범행 이후의 태도 등을 살펴 판단합니다.</p>\n<p class=\"case-text\">이 사건에서도 법원은 범행 기간과 피해 규모를 책임이 가볍지 않은 사정으로 보았습니다. 다만 의뢰인이 범행을 모두 인정하고 반성한 점, 항소심에서 피해자와 합의해 피해자가 처벌을 원하지 않은 점을 유리하게 고려했습니다.</p></section></section><section class=\"section\" id=\"section-assistance\"><h2 class=\"section-title\">사기 항소심 집행유예를 위한 YK 담당 변호사의 조력</h2><section id=\"section-assistance-sub-1\"><h3 class=\"subsection-title\">피해자와의 합의를 선처 사유로 주장</h3><p class=\"case-text\">YK 담당 변호사는 범행 기간과 피해 규모에 비추어 의뢰인의 책임이 가볍지 않다는 점을 전제로, 항소심에서 이루어진 피해자와의 합의를 선처 사유로 제시했습니다. 특히 <mark class=\"assistance-highlight\"><strong>피해자가 의뢰인의 처벌을 원하지 않는다는 점</strong></mark>을 강조했습니다. 이는 범행의 책임을 축소하려는 것이 아니라, 1심 이후 달라진 사정도 형량 판단에 반영해 달라는 취지였습니다.</p></section><section id=\"section-assistance-sub-2\"><h3 class=\"subsection-title\">범행을 인정하고 반성하는 태도 소명</h3><p class=\"case-text\">YK 담당 변호사는 의뢰인이 <mark class=\"assistance-highlight\"><strong>범행을 모두 인정하고 반성하는 태도를 보이고 있다는 점</strong></mark>을 항소심에서 주장했습니다. 범행 자체를 다투는 대신 잘못을 인정하는 태도를 유리한 양형 사유로 제시하며, 1심의 실형을 그대로 유지해야 하는지 다시 판단해 달라고 요청했습니다. 이는 범행의 기간과 피해 규모뿐 아니라 범행 이후의 태도까지 함께 고려해 달라는 조력이었습니다.</p></section></section><section class=\"section\" id=\"section-result\"><h2 class=\"section-title\">일반사기 사건 결과 : 집행유예</h2><p class=\"case-text\">항소심 법원은 다음 사정을 의뢰인에게 유리하게 고려하여 <strong>집행유예를 선고했습니다.</strong></p>\n<div class=\"circled-result\"><p class=\"case-text\">① <strong>의뢰인이 범행을 모두 인정하고 반성하는 태도를 보인 점</strong></p><p class=\"case-text\">② <strong>항소심에서 피해자와 합의한 점</strong></p><p class=\"case-text\">③ <strong>피해자가 의뢰인의 처벌을 원하지 않는다는 의사를 밝힌 점</strong></p></div>\n<p class=\"case-text\">그 결과 의뢰인은 1심 실형에서 항소심 집행유예로 형이 변경되었습니다. 범행 인정과 반성, 피해자와의 합의 및 처벌을 원하지 않는 의사가 유리한 양형 사유로 받아들여진 사례입니다.</p>\n<p class=\"case-text\"></p></section>\n    \n    <div class=\"tags\"><span class=\"tag\">사기죄</span><span class=\"tag\">사기항소심</span><span class=\"tag\">피해자합의</span><span class=\"tag\">집행유예</span><span class=\"tag\">형사</span><span class=\"tag\">일반사기</span></div>\n  </main>\n</article>\n\n\n  \n\n</div>"}