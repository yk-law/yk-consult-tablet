color: #fff; background: #102169; }\n.case-role-value { padding: 5px 9px; color: #102169; background: #f3f6ff; }\n.case-summary-table { width: 100%; border-collapse: collapse; table-layout: fixed; font-size: 15px; }\n.case-summary-label, .case-summary-value { border-top: 1px solid #e5eaf3; padding: 11px 0; vertical-align: top; text-align: left; }\n.case-summary-row-first { border-top: 0; }\n.case-summary-label { width: 118px; color: #1a2744; font-weight: 800; }\n.case-summary-value { color: #374151; font-weight: 600; }\n.toc { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: 24px 32px; margin-bottom: 20px; }\n.toc-title { font-size: 11px; font-weight: 700; letter-spacing: 2px; color: #9ca3af; text-transform: uppercase; margin-bottom: 14px; }\n.toc-list { list-style: none; padding: 0; margin: 0; }\n.toc-item { margin-bottom: 8px; font-size: 16px; }\n.toc-link { color: #102169; font-weight: 600; text-decoration: none; }\n.toc .toc-sub { margin: 4px 0 0 18px; }\n.toc .toc-sub .toc-link { color: #4b5563; font-size: 15px; font-weight: 400; }\n.section { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: 36px 40px; margin-bottom: 20px; }\n.section-title { color: #1a2744; font-size: 22px; font-weight: 700; line-height: 1.4; margin: 0 0 18px; }\n.subsection-title { color: #2d4a8a; font-size: 18px; font-weight: 700; line-height: 1.4; margin: 24px 0 10px; }\n.case-text { color: #374151; font-size: 17px; margin: 0 0 14px; }\n.case-list { list-style-type: disc; padding-left: 1.5rem; margin: 10px 0 14px; }\n.case-list-item { color: #374151; margin-bottom: 6px; font-weight: 800; }\n.assistance-highlight { background: linear-gradient(transparent 58%, #fde68a 58%); padding: 0 2px; font-weight: 800; color: #1f2937; }\n.public-text-issue { background: #fee2e2; color: #991b1b; border: 1px solid #ef4444; border-radius: 4px; box-shadow: 0 0 0 2px rgba(239, 68, 68, 0.16); padding: 0 3px; font-weight: 900; }\n.ref-box, .def-box, .qna-box, .order-box { background: #f9fafb; border-left: 4px solid #102169; border-radius: 4px; padding: 16px 20px; margin: 16px 0; font-size: 15px; }\n.case-table { width: 100%; border-collapse: collapse; margin: 16px 0 20px; font-size: 15px; table-layout: fixed; }\n.case-table-head, .case-table-cell { border: 1px solid #dbe1ee; padding: 10px 12px; vertical-align: top; word-break: keep-all; }\n.case-table-head { background: #f3f6fb; color: #1a2744; font-weight: 700; }\n.assistance-image { margin: 24px 0 4px; aspect-ratio: 16 / 9; overflow: hidden; border-radius: 8px; border: 1px solid #e5e7eb; }\n.assistance-image-img { display: block; width: 100%; height: 100%; object-fit: cover; border: 0; }\n.result-cta { background: #15266f; border-radius: 8px; padding: 28px 36px; margin-top: 28px; margin-bottom: 0; color: #fff; }\n.result-cta-text { color: #fff; font-size: 16px; font-weight: 700; line-height: 1.65; margin: 0 0 20px; }\n.result-cta-button { display: inline-block; background: #fff; color: #15266f; text-decoration: none; font-size: 15px; font-weight: 800; padding: 12px 22px; border-radius: 7px; }\n.result-cta + .tags { margin-top: 40px; }\n.footer-note { text-align: center; font-size: 14px; color: #9ca3af; padding: 20px 24px 40px; margin: 0; }\n@page { margin: 12mm; }\n/* 모바일만: 좌우 여백을 살짝 줄여 본문 폭 확보. PC 레이아웃은 유지. */\n@media (max-width: 720px) {\n  .preview-header { padding: 28px 18px; }\n  .preview-container { padding: 20px 12px 56px; }\n  .section { padding: 26px 16px; }\n  .section-title { font-size: 20px; }\n  .subsection-title { font-size: 17px; }\n  .case-text { font-size: 16px; }\n  .toc { padding: 18px 16px; }\n  .case-summary-card { padding: 18px 16px; }\n  .case-summary-table { font-size: 14px; }\n  .case-summary-label { width: 96px; }\n  .ref-box, .def-box, .qna-box, .order-box { padding: 14px 14px; }\n  .result-cta { padding: 22px 18px; }\n}\n@media (max-width: 768px) {\n  .preview-header .preview-lead { font-size: 22px; line-height: 1.4; }\n}\n@media print {\n  .preview-result, .preview-result { background: #f8fafc !important; }\n  .preview-header, .result-cta, .case-role-label, .case-table-head, .tag, .case-role-value, .ref-box, .def-box, .qna-box, .order-box {\n    -webkit-print-color-adjust: exact !important;\n    print-color-adjust: exact !important;\n  }\n  .preview-container { padding-bottom: 40px; }\n  .section, .toc, .case-summary-card, .result-cta { break-inside: avoid; page-break-inside: avoid; }\n  .result-cta + .tags { margin-top: 42px; }\n}\n}</style><div data-embedded-case-html-root=\"\" class=\"\" style=\"display:block;width:100%;min-width:0;box-sizing:border-box;\">\n\n<article class=\"preview-result\">\n  <header class=\"preview-header\">\n    <div class=\"label\">YK SUCCESS CASE</div>\n    <p class=\"preview-lead\">회사원인 의뢰인은 상대방과 말다툼을 하던 중 머그컵으로 이마를 내리쳤다는 특수폭행 혐의로 수사를 받았습니다.</p>\n  </header>\n  <main class=\"preview-container\">\n    <div class=\"lead\" id=\"section-overview\">\n<p class=\"case-text\">YK 담당 변호사가 조력한 이 사건에서는 상대방이 경찰 조사에서 스스로 식탁 모서리에 머리를 부딪쳤다고 진술을 바꾼 점과 의사도 상처의 원인을 판단하기 어렵다고 밝힌 점이 고려되어, 의뢰인은 증거불충분으로 혐의없음 불기소 처분을 받았습니다.</p></div>\n    <section class=\"case-summary-card\" aria-label=\"사건 결과 요약\"><div class=\"case-summary-title\"><span>사건 결과 요약</span><span class=\"case-role-badges\"><span class=\"case-role-badge case-role-badge-client\"><span class=\"case-role-label\">의뢰인</span><span class=\"case-role-value\">피의자</span></span></span></div><table class=\"case-summary-table\"><tbody><tr><th class=\"case-summary-label case-summary-row-first\" scope=\"row\">사건 유형</th><td class=\"case-summary-value case-summary-row-first\">특수폭행</td></tr><tr><th class=\"case-summary-label\" scope=\"row\">쟁점</th><td class=\"case-summary-value\">상대방 진술의 일관성, 상처 발생 원인, 도구를 이용한 폭행의 입증 여부</td></tr><tr><th class=\"case-summary-label\" scope=\"row\">결과</th><td class=\"case-summary-value\">불기소</td></tr><tr><th class=\"case-summary-label\" scope=\"row\">대응 포인트</th><td class=\"case-summary-value\">신고와 조사 진술의 차이 및 의사 소견을 근거로 폭행 혐의 입증 부족 소명</td></tr></tbody></table></section><div data-case-cta-slot=\"top\"></div>\n    <nav class=\"toc\"><div class=\"toc-title\">CONTENTS</div><ul class=\"toc-list\"><li class=\"toc-item\"><a class=\"toc-link\">머그컵 사용 의혹으로 특수폭행 수사를 받은 경위</a></li><li class=\"toc-item\"><a class=\"toc-link\">특수폭행 처벌 수위와 양형요소</a><ul class=\"toc-list toc-sub\"><li class=\"toc-item\"><a class=\"toc-link\">처벌 수위와 적용 법령</a></li><li class=\"toc-item\"><a class=\"toc-link\">양형기준과 감경·가중요소</a></li></ul></li><li class=\"toc-item\"><a class=\"toc-link\">특수폭행 불기소를 위한 YK 담당 변호사의 소명</a><ul class=\"toc-list toc-sub\"><li class=\"toc-item\"><a class=\"toc-link\">신고 내용과 조사 진술의 차이를 근거로 폭행 혐의 반박</a></li><li class=\"toc-item\"><a class=\"toc-link\">상처 원인을 단정할 수 없다는 의사 소견으로 방어</a></li></ul></li><li class=\"toc-item\"><a class=\"toc-link\">특수폭행 사건 결과 : 불기소</a></li></ul></nav>\n    <section class=\"section\" id=\"section-background\"><h2 class=\"section-title\">머그컵 사용 의혹으로 특수폭행 수사를 받은 경위</h2><p class=\"case-text\">의뢰인은 상대방과 말다툼을 한 뒤, 머그컵으로 상대방의 이마를 내리쳤다는 특수폭행 혐의로 수사를 받게 되었습니다.</p>\n<p class=\"case-text\">당시 상대방의 이마가 찢어진 사실은 있었지만, 상처가 생긴 경위에 관해서는 의뢰인의 설명이 달랐습니다.</p>\n<p class=\"case-text\">의뢰인은 <strong>상대방을 폭행한 사실이 없으며, 상대방이 자해하는 것을 말렸을 뿐이라고 주장했습니다.</strong> 말다툼과 상처가 있었다는 사실과 별개로, 실제 머그컵을 사용한 폭행이 있었는지가 쟁점이 되었습니다.</p>\n<p class=\"case-text\">의뢰인은 자신의 입장을 수사 과정에서 설명하고 혐의에 대응하기 위해 YK 담당 변호사의 조력을 받았습니다.</p><figure class=\"assistance-image\"><img class=\"assistance-image-img\" src=\"https://www.yklawfirm.co.kr/ai_case/18628/42e36a4d0a446d8c.webp\" alt=\"머그컵 특수폭행 혐의와 상처 발생 경위 다툼에 대응한 의뢰인\"></figure></section><section class=\"section\" id=\"section-info-1\"><h2 class=\"section-title\">특수폭행 처벌 수위와 양형요소</h2><section id=\"section-info-1-sub-1\"><h3 class=\"subsection-title\">처벌 수위와 적용 법령</h3><p class=\"case-text\">특수폭행에는 형법 제261조가 적용됩니다. 단체 또는 다중의 위력을 보이거나, 위험한 물건을 휴대하여 사람을 폭행한 경우 성립합니다. 법정형은 <strong>5년 이하의 징역 또는 1,000만 원 이하의 벌금</strong>입니다. 일반 폭행보다 무겁게 처벌됩니다.</p>\n<div class=\"ref-box\"><span class=\"ref-title\">관련 쟁점은 <strong><a rel=\"noopener noreferrer\">특수폭행죄 처벌 수위와 성립요건</a></strong>에서 확인하실 수 있습니다.</span><span class=\"ref-body\"></span></div>\n<p class=\"case-text\">머그컵처럼 일상에서 사용하는 물건도 사용 방법과 상황에 따라 위험한 물건으로 판단될 수 있습니다. 물건의 재질과 형태, 사용 방법, 겨냥한 신체 부위 등을 살펴 신체에 위험을 줄 수 있었는지 판단합니다. 다만 물건이 현장에 있었다는 사정만으로 특수폭행이 성립하는 것은 아닙니다. 실제 폭행이 있었는지도 증거로 인정되어야 합니다.</p></section><section id=\"section-info-1-sub-2\"><h3 class=\"subsection-title\">양형기준과 감경·가중요소</h3><table class=\"case-table\"><thead><tr><th class=\"case-table-head\">구분</th><th class=\"case-table-head\">감경요소</th><th class=\"case-table-head\">가중요소</th></tr></thead><tbody><tr><td class=\"case-table-cell\">행위</td><td class=\"case-table-cell\">참작할 만한 범행 경위, 피해나 위험이 낮은 사정</td><td class=\"case-table-cell\">위험성이나 피해가 큰 사정</td></tr><tr><td class=\"case-table-cell\">행위자·기타</td><td class=\"case-table-cell\">반성, 피해 회복, 재범 방지 노력</td><td class=\"case-table-cell\">재범, 증거은폐, 범행 후 정황이 불리한 사정</td></tr></tbody></table>\n<p class=\"case-text\">양형기준은 유죄가 인정될 때 법원이 형량을 정하는 데 참고하는 기준입니다. 폭행의 정도와 피해 결과, 범행 경위, 피해 회복 여부 등을 함께 고려합니다.</p>\n<p class=\"case-text\">폭행 정도가 경미한 경우, 진지하게 반성한 경우, 형사처벌 이력이 없는 경우 등은 감경요소가 될 수 있습니다. 피해자가 처벌을 원하지 않거나 실질적인 피해 회복이 이루어진 사정도 고려됩니다.</p>\n<p class=\"case-text\">반대로 계획적인 범행, 장기간 반복한 폭행, 잔혹한 범행수법, 중한 상해 발생 등은 가중요소가 될 수 있습니다. 같은 범죄로 처벌받은 이력 역시 형량 판단에 영향을 줄 수 있습니다.</p>\n<p class=\"case-text\">다만 이 사건의 핵심은 형량을 줄일 사정이 아니라 <strong>의뢰인이 실제로 머그컵을 이용해 폭행했는지</strong>였습니다. 상대방에게 상처가 있었다는 사실과, 그 상처가 의뢰인의 폭행으로 생겼다는 판단은 구분해야 합니다. 따라서 양형요소를 살피기에 앞서 폭행 행위와 상처 발생 경위를 뒷받침하는 증거가 중요했습니다.</p></section></section><section class=\"section\" id=\"section-assistance\"><h2 class=\"section-title\">특수폭행 불기소를 위한 YK 담당 변호사의 소명</h2><section id=\"section-assistance-sub-1\"><h3 class=\"subsection-title\">신고 내용과 조사 진술의 차이를 근거로 폭행 혐의 반박</h3><p class=\"case-text\">YK 담당 변호사는 상대방이 112 신고 당시에는 의뢰인이 도구로 때렸다고 했으나, 경찰 조사에서는 다투다가 화가 나 식탁 모서리에 스스로 머리를 부딪쳤다고 진술한 차이를 짚었습니다. 이후 진술이 자해를 말렸다는 의뢰인의 설명과 일부 부합한다는 점을 들어, <mark class=\"assistance-highlight\"><strong>최초 신고 내용만으로 머그컵을 사용한 폭행을 인정하기 어렵다</strong></mark>고 소명했습니다. 상처가 있다는 사실이 곧 의뢰인의 폭행을 입증하는 것으로 해석되지 않도록 했습니다.</p></section><section id=\"section-assistance-sub-2\"><h3 class=\"subsection-title\">상처 원인을 단정할 수 없다는 의사 소견으로 방어</h3><p class=\"case-text\">YK 담당 변호사는 상대방의 상처를 확인한 의사가 자해로 생긴 것인지, 다른 사람의 행위로 생긴 것인지 판단할 수 없다고 한 의견을 근거로 제시했습니다. 이를 상대방의 경찰 진술과 연결해, <mark class=\"assistance-highlight\"><strong>상처의 존재만으로 의뢰인이 폭행했다고 단정할 수 없다</strong></mark>는 점을 강조했습니다. 의사 소견이 폭행을 입증하는 근거로 받아들여지지 않도록, 상처의 원인과 혐의를 뒷받침하는 증거가 충분한지를 구분해 주장했습니다.</p></section></section><section class=\"section\" id=\"section-result\"><h2 class=\"section-title\">특수폭행 사건 결과 : 불기소</h2><p class=\"case-text\">검찰은 의뢰인의 특수폭행 혐의에 대해 <strong>혐의없음(증거불충분) 불기소 처분</strong>을 내렸습니다.</p>\n<div class=\"circled-result\"><p class=\"case-text\">① <strong>상대방이 신고 당시에는 도구로 맞았다고 했으나, 경찰 조사에서는 스스로 머리를 부딪쳤다고 진술을 바꾸어 일관성이 없었던 점</strong></p><p class=\"case-text\">② <strong>이후 진술이 자해를 말렸다는 의뢰인의 설명과 일부 부합한 점</strong></p><p class=\"case-text\">③ <strong>상처를 확인한 의사가 자해인지 타해인지 판단할 수 없다는 의견을 밝힌 점</strong></p><p class=\"case-text\">④ <strong>최초 신고 진술만으로 폭행을 인정하기 부족하고, 달리 혐의를 뒷받침할 증거가 없었던 점</strong></p></div>\n<p class=\"case-text\">그 결과 의뢰인은 특수폭행 혐의로 재판에 넘겨지지 않았습니다. 진술의 일관성과 상처 원인에 관한 의사 의견이 검찰의 증거 판단에서 중요하게 다뤄진 사례입니다.</p>\n<p class=\"case-text\"></p></section>\n    \n    <div class=\"tags\"><span class=\"tag\">특수폭행</span><span class=\"tag\">불기소</span><span class=\"tag\">증거불충분</span><span class=\"tag\">진술번복</span><span class=\"tag\">형사</span></div>\n  </main>\n</article>\n\n\n  \n\n</div>"}