color: #fff; background: #102169; }\n.case-role-value { padding: 5px 9px; color: #102169; background: #f3f6ff; }\n.case-summary-table { width: 100%; border-collapse: collapse; table-layout: fixed; font-size: 15px; }\n.case-summary-label, .case-summary-value { border-top: 1px solid #e5eaf3; padding: 11px 0; vertical-align: top; text-align: left; }\n.case-summary-row-first { border-top: 0; }\n.case-summary-label { width: 118px; color: #1a2744; font-weight: 800; }\n.case-summary-value { color: #374151; font-weight: 600; }\n.toc { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: 24px 32px; margin-bottom: 20px; }\n.toc-title { font-size: 11px; font-weight: 700; letter-spacing: 2px; color: #9ca3af; text-transform: uppercase; margin-bottom: 14px; }\n.toc-list { list-style: none; padding: 0; margin: 0; }\n.toc-item { margin-bottom: 8px; font-size: 16px; }\n.toc-link { color: #102169; font-weight: 600; text-decoration: none; }\n.toc .toc-sub { margin: 4px 0 0 18px; }\n.toc .toc-sub .toc-link { color: #4b5563; font-size: 15px; font-weight: 400; }\n.section { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: 36px 40px; margin-bottom: 20px; }\n.section-title { color: #1a2744; font-size: 22px; font-weight: 700; line-height: 1.4; margin: 0 0 18px; }\n.subsection-title { color: #2d4a8a; font-size: 18px; font-weight: 700; line-height: 1.4; margin: 24px 0 10px; }\n.case-text { color: #374151; font-size: 17px; margin: 0 0 14px; }\n.case-list { list-style-type: disc; padding-left: 1.5rem; margin: 10px 0 14px; }\n.case-list-item { color: #374151; margin-bottom: 6px; font-weight: 800; }\n.assistance-highlight { background: linear-gradient(transparent 58%, #fde68a 58%); padding: 0 2px; font-weight: 800; color: #1f2937; }\n.public-text-issue { background: #fee2e2; color: #991b1b; border: 1px solid #ef4444; border-radius: 4px; box-shadow: 0 0 0 2px rgba(239, 68, 68, 0.16); padding: 0 3px; font-weight: 900; }\n.ref-box, .def-box, .qna-box, .order-box { background: #f9fafb; border-left: 4px solid #102169; border-radius: 4px; padding: 16px 20px; margin: 16px 0; font-size: 15px; }\n.case-table { width: 100%; border-collapse: collapse; margin: 16px 0 20px; font-size: 15px; table-layout: fixed; }\n.case-table-head, .case-table-cell { border: 1px solid #dbe1ee; padding: 10px 12px; vertical-align: top; word-break: keep-all; }\n.case-table-head { background: #f3f6fb; color: #1a2744; font-weight: 700; }\n.assistance-image { margin: 24px 0 4px; aspect-ratio: 16 / 9; overflow: hidden; border-radius: 8px; border: 1px solid #e5e7eb; }\n.assistance-image-img { display: block; width: 100%; height: 100%; object-fit: cover; border: 0; }\n.result-cta { background: #15266f; border-radius: 8px; padding: 28px 36px; margin-top: 28px; margin-bottom: 0; color: #fff; }\n.result-cta-text { color: #fff; font-size: 16px; font-weight: 700; line-height: 1.65; margin: 0 0 20px; }\n.result-cta-button { display: inline-block; background: #fff; color: #15266f; text-decoration: none; font-size: 15px; font-weight: 800; padding: 12px 22px; border-radius: 7px; }\n.result-cta + .tags { margin-top: 40px; }\n.footer-note { text-align: center; font-size: 14px; color: #9ca3af; padding: 20px 24px 40px; margin: 0; }\n@page { margin: 12mm; }\n/* 모바일만: 좌우 여백을 살짝 줄여 본문 폭 확보. PC 레이아웃은 유지. */\n@media (max-width: 720px) {\n  .preview-header { padding: 28px 18px; }\n  .preview-container { padding: 20px 12px 56px; }\n  .section { padding: 26px 16px; }\n  .section-title { font-size: 20px; }\n  .subsection-title { font-size: 17px; }\n  .case-text { font-size: 16px; }\n  .toc { padding: 18px 16px; }\n  .case-summary-card { padding: 18px 16px; }\n  .case-summary-table { font-size: 14px; }\n  .case-summary-label { width: 96px; }\n  .ref-box, .def-box, .qna-box, .order-box { padding: 14px 14px; }\n  .result-cta { padding: 22px 18px; }\n}\n@media (max-width: 768px) {\n  .preview-header .preview-lead { font-size: 22px; line-height: 1.4; }\n}\n@media print {\n  .preview-result, .preview-result { background: #f8fafc !important; }\n  .preview-header, .result-cta, .case-role-label, .case-table-head, .tag, .case-role-value, .ref-box, .def-box, .qna-box, .order-box {\n    -webkit-print-color-adjust: exact !important;\n    print-color-adjust: exact !important;\n  }\n  .preview-container { padding-bottom: 40px; }\n  .section, .toc, .case-summary-card, .result-cta { break-inside: avoid; page-break-inside: avoid; }\n  .result-cta + .tags { margin-top: 42px; }\n}\n}</style><div data-embedded-case-html-root=\"\" class=\"\" style=\"display:block;width:100%;min-width:0;box-sizing:border-box;\">\n\n<article class=\"preview-result\">\n  <header class=\"preview-header\">\n    <div class=\"label\">YK SUCCESS CASE</div>\n    <p class=\"preview-lead\">자영업자인 의뢰인은 공범들과 전세자금대출금을 편취한 혐의로 기소되어 1심에서 실형을 선고받았고, 형량이 지나치게 무겁다는 이유로 항소했습니다.</p>\n  </header>\n  <main class=\"preview-container\">\n    <div class=\"lead\" id=\"section-overview\">\n<p class=\"case-text\">YK 담당 변호사는 항소심에서 피해금액 전액 변제 등 피해 회복 사정을 중심으로 감형을 구했고, 의뢰인은 집행유예를 선고받았습니다.</p></div>\n    <section class=\"case-summary-card\" aria-label=\"사건 결과 요약\"><div class=\"case-summary-title\"><span>사건 결과 요약</span><span class=\"case-role-badges\"><span class=\"case-role-badge case-role-badge-client\"><span class=\"case-role-label\">의뢰인</span><span class=\"case-role-value\">피고인</span></span></span></div><table class=\"case-summary-table\"><tbody><tr><th class=\"case-summary-label case-summary-row-first\" scope=\"row\">사건 유형</th><td class=\"case-summary-value case-summary-row-first\">일반사기</td></tr><tr><th class=\"case-summary-label\" scope=\"row\">쟁점</th><td class=\"case-summary-value\">피해금액 전액 변제, 1심 이후 피해 회복 정도의 변화, 범행 인정과 반성의 양형 반영</td></tr><tr><th class=\"case-summary-label\" scope=\"row\">결과</th><td class=\"case-summary-value\">집행유예</td></tr><tr><th class=\"case-summary-label\" scope=\"row\">대응 포인트</th><td class=\"case-summary-value\">전액 변제와 반성하는 태도를 항소심 선처 사유로 소명하여 감형 요청</td></tr></tbody></table></section><div data-case-cta-slot=\"top\"></div>\n    <nav class=\"toc\"><div class=\"toc-title\">CONTENTS</div><ul class=\"toc-list\"><li class=\"toc-item\"><a class=\"toc-link\">전세대출사기로 1심 실형을 선고받은 의뢰인</a></li><li class=\"toc-item\"><a class=\"toc-link\">일반사기 항소심 판단 기준</a><ul class=\"toc-list toc-sub\"><li class=\"toc-item\"><a class=\"toc-link\">항소심의 개념</a></li><li class=\"toc-item\"><a class=\"toc-link\">항소심 판단요소</a></li></ul></li><li class=\"toc-item\"><a class=\"toc-link\">일반사기 처벌 수위와 양형요소</a><ul class=\"toc-list toc-sub\"><li class=\"toc-item\"><a class=\"toc-link\">처벌 수위와 적용 법령</a></li><li class=\"toc-item\"><a class=\"toc-link\">양형기준과 감경·가중요소</a></li></ul></li><li class=\"toc-item\"><a class=\"toc-link\">전세대출사기 항소심 집행유예를 위한 YK 담당 변호사의 조력</a><ul class=\"toc-list toc-sub\"><li class=\"toc-item\"><a class=\"toc-link\">피해금액 전액 변제 사실을 항소심 선처 사유로 소명</a></li><li class=\"toc-item\"><a class=\"toc-link\">범행을 인정하고 반성하는 태도를 양형 요소로 정리</a></li></ul></li><li class=\"toc-item\"><a class=\"toc-link\">일반사기 사건 결과 : 집행유예</a></li></ul></nav>\n    <section class=\"section\" id=\"section-background\"><h2 class=\"section-title\">전세대출사기로 1심 실형을 선고받은 의뢰인</h2><p class=\"case-text\">의뢰인은 공범들과 역할을 나눠 전세자금대출금을 편취한 혐의로 기소되었습니다.</p>\n<p class=\"case-text\">공범들이 명의자를 섭외하는 등 역할을 분담한 가운데, 의뢰인은 <strong>임차인 역할로 범행에 가담</strong>했습니다.</p>\n<p class=\"case-text\">의뢰인과 관련된 피해금액은 약 7,200만원이었습니다.</p>\n<p class=\"case-text\">1심에서는 범행의 계획성과 조직성 등이 무겁게 평가되어 <strong>실형이 선고되었습니다.</strong> 의뢰인은 범행을 인정하고 반성하면서도 형량이 지나치게 무겁다는 이유로 항소했습니다.</p>\n<p class=\"case-text\">이후 의뢰인은 항소심 대응을 위해 YK 담당 변호사의 조력을 구했습니다.</p>\n<p class=\"case-text\">임차인 역할 역시 범행 실현에 필수적이었다는 점을 전제로, 구체적인 가담 정도와 피해 회복 노력을 설명할 필요가 있었습니다.</p>\n<p class=\"case-text\">특히 <strong>항소심에 이르러 피해금액 전부를 변제한 사정</strong>이 중요한 양형 요소였습니다.</p><figure class=\"assistance-image\"><img class=\"assistance-image-img\" src=\"https://www.yklawfirm.co.kr/ai_case/18837/6ae7c6e36a88dc8b.webp\" alt=\"전세자금대출사기 임차인 가담 혐의와 항소심 피해금 전액 변제\"></figure></section><section class=\"section\" id=\"section-info-1\"><h2 class=\"section-title\">일반사기 항소심 판단 기준</h2><section id=\"section-info-1-sub-1\"><h3 class=\"subsection-title\">항소심의 개념</h3><p class=\"case-text\">항소심은 1심 판결에 불복한 당사자의 요청으로 상급 법원이 1심 판단이 타당한지 다시 살피는 절차입니다. 범행을 인정하면서 형량이 지나치게 무겁다고 다투는 경우에는, 1심에서 정한 형이 적절한지가 주요 쟁점이 됩니다.</p>\n<div class=\"ref-box\"><span class=\"ref-title\">피해 회복의 양형상 의미는 <strong><a rel=\"noopener noreferrer\">사기죄 합의 안하면 형량은? 사기죄 합의 중요성</a></strong>에서 확인해 보세요.</span><span class=\"ref-body\"></span></div>\n<p class=\"case-text\"><strong>1심 이후 새롭게 달라진 사정</strong>도 중요한 판단 대상입니다. 항소심에서 피해금을 추가로 변제했다면 법원은 이를 기존의 범행 경위와 함께 고려합니다. 다만 항소하거나 추가 변제를 했다는 이유만으로 형이 낮아지는 것은 아닙니다.</p></section><section id=\"section-info-1-sub-2\"><h3 class=\"subsection-title\">항소심 판단요소</h3><p class=\"case-text\">법원은 범행의 내용과 피고인의 역할, 피해 회복 정도 등을 살펴봅니다. 계획적인 대출사기에서는 역할 분담과 가담 정도가 중요하며, 임차인 역할도 범행 실현에 필수적이었다면 책임을 가볍게 보지 않을 수 있습니다.</p>\n<p class=\"case-text\">피해 회복에 관해서는 변제 의사뿐 아니라 <strong>실제로 지급한 금액과 남은 피해액</strong>을 확인합니다. 이 사건에서도 항소심에 이르러 피해금액 전부를 변제한 점이 중요한 판단 사정이 되었습니다.</p>\n<p class=\"case-text\">범행을 인정하고 반성하는 태도와 과거 처벌 이력 등도 함께 고려됩니다. 최종 판단은 어느 한 사정만으로 정해지지 않고 범행의 책임과 이후 달라진 사정을 종합해 이루어집니다.</p></section></section><section class=\"section\" id=\"section-info-2\"><h2 class=\"section-title\">일반사기 처벌 수위와 양형요소</h2><section id=\"section-info-2-sub-1\"><h3 class=\"subsection-title\">처벌 수위와 적용 법령</h3><p class=\"case-text\">사기죄는 사람을 속여 재물이나 재산상 이익을 얻는 범죄입니다. 이 사건에는 행위 당시의 구 형법 제347조 제1항이 적용되어, <strong>10년 이하의 징역 또는 2천만 원 이하의 벌금</strong>이 처벌 범위가 됩니다. 개정된 현행법의 처벌 수위와는 구분해야 합니다.</p>\n<p class=\"case-text\">공범들과 역할을 나눠 범행한 경우에는 형법 제30조의 공동정범 규정도 적용됩니다. 여러 사람이 함께 범죄를 실행하면 각자를 그 범죄의 실행자로 처벌한다는 의미입니다. 따라서 직접 받은 이익만으로 책임이 정해지지는 않습니다.</p></section><section id=\"section-info-2-sub-2\"><h3 class=\"subsection-title\">양형기준과 감경·가중요소</h3><table class=\"case-table\"><thead><tr><th class=\"case-table-head\">구분</th><th class=\"case-table-head\">감경요소</th><th class=\"case-table-head\">가중요소</th></tr></thead><tbody><tr><td class=\"case-table-cell\">행위</td><td class=\"case-table-cell\">참작할 만한 범행 경위</td><td class=\"case-table-cell\">계획적·조직적인 범행</td></tr><tr><td class=\"case-table-cell\">행위자·기타</td><td class=\"case-table-cell\">반성, 실질적인 피해 회복</td><td class=\"case-table-cell\">불리한 범죄 이력, 범행 후 정황</td></tr></tbody></table>\n<p class=\"case-text\">양형기준은 법원이 구체적인 형량을 정할 때 참고하는 기준입니다. 사기 사건에서는 피해 규모, 범행 수법, 가담 정도, 실제 피해 회복 여부, 범죄 이력 등을 함께 살핍니다.</p>\n<p class=\"case-text\">이 사건에서는 전세자금대출 제도를 악용한 점과 임차인 역할이 범행 실행에 필수적이었다는 점이 불리하게 고려됐습니다. 반면 <strong>피해금액 전부를 변제한 사정과 반성하는 태도</strong>는 중요한 감경 요소였습니다.</p>\n<p class=\"case-text\">피해금을 변제한 사실과 피해자와 합의가 성립한 사실은 구분해야 합니다. 전액 변제만으로 집행유예가 보장되는 것도 아닙니다.</p>\n<p class=\"case-text\">같은 사기 범죄 이력이 있다면 양형에 불리하게 작용할 수 있습니다. 다만 이 사건 피고인들은 모두 일반사기 전력이 없었으므로, 일반사기 재범 사건과는 구분할 필요가 있습니다.</p></section></section><section class=\"section\" id=\"section-assistance\"><h2 class=\"section-title\">전세대출사기 항소심 집행유예를 위한 YK 담당 변호사의 조력</h2><section id=\"section-assistance-sub-1\"><h3 class=\"subsection-title\">피해금액 전액 변제 사실을 항소심 선처 사유로 소명</h3><p class=\"case-text\">YK 담당 변호사는 의뢰인이 1심과 항소심에 걸쳐 피해 회복을 위해 변제한 사실을 확인했습니다. 이를 바탕으로 <mark class=\"assistance-highlight\"><strong>항소심에 이르러 피해금액 전액이 변제되었다는 점</strong></mark>을 선처 사유로 소명했습니다. 1심 이후 달라진 피해 회복 정도가 형량 판단에 반영되어야 한다는 취지로 감형을 구했습니다.</p></section><section id=\"section-assistance-sub-2\"><h3 class=\"subsection-title\">범행을 인정하고 반성하는 태도를 양형 요소로 정리</h3><p class=\"case-text\">YK 담당 변호사는 임차인 역할도 범행 실현에 필수적이었다는 점을 전제로, 의뢰인이 <mark class=\"assistance-highlight\"><strong>범행을 인정하고 반성하는 태도를 보였다는 사정</strong></mark>을 주장했습니다. 반성의 태도와 실제 전액 변제 사실을 함께 제시하며, 범행 이후의 태도와 피해 회복 노력도 형량 판단에 반영되도록 조력했습니다.</p></section></section><section class=\"section\" id=\"section-result\"><h2 class=\"section-title\">일반사기 사건 결과 : 집행유예</h2><p class=\"case-text\">항소심 법원은 의뢰인에게 <strong>집행유예를 선고했습니다.</strong> 의뢰인은 공범들과 전세자금대출금을 편취한 혐의로 1심에서 실형을 선고받았으나, 형량이 지나치게 무겁다는 이유로 항소했습니다. 항소심에서는 범행을 인정하고 반성하는 태도와 함께, 1심 이후 이루어진 피해 회복이 중요한 양형 사정으로 제시되었습니다.</p>\n<div class=\"circled-result\"><p class=\"case-text\">① <strong>항소심에 이르러 피해금액 전액을 변제한 점</strong></p><p class=\"case-text\">② <strong>범행을 인정하고 반성하는 태도를 보인 점</strong></p></div>\n<p class=\"case-text\">YK 담당 변호사는 의뢰인이 1심과 항소심에 걸쳐 변제한 내역을 확인하고, 항소심에 이르러 피해금액 전액이 변제되었다는 점을 소명하며 감형을 구했습니다. 이번 사건은 범행의 계획성과 조직성으로 1심에서 실형이 선고된 상황에서도, 이후의 피해 회복 노력과 반성하는 태도가 항소심 양형에 반영되어 집행유예가 선고된 사례입니다.</p>\n<p class=\"case-text\"></p></section>\n    \n    <div class=\"tags\"><span class=\"tag\">전세대출사기</span><span class=\"tag\">사기집행유예</span><span class=\"tag\">항소심감형</span><span class=\"tag\">피해금전액변제</span><span class=\"tag\">형사</span><span class=\"tag\">일반사기</span></div>\n  </main>\n</article>\n\n\n  \n\n</div>"}