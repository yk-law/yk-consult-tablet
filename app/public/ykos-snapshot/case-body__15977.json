5px 7px; color: #fff; background: #102169; }\n.case-role-value { padding: 5px 9px; color: #102169; background: #f3f6ff; }\n.case-summary-table { width: 100%; border-collapse: collapse; table-layout: fixed; font-size: 15px; }\n.case-summary-label, .case-summary-value { border-top: 1px solid #e5eaf3; padding: 11px 0; vertical-align: top; text-align: left; }\n.case-summary-row-first { border-top: 0; }\n.case-summary-label { width: 118px; color: #1a2744; font-weight: 800; }\n.case-summary-value { color: #374151; font-weight: 600; }\n.toc { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: 24px 32px; margin-bottom: 20px; }\n.toc-title { font-size: 11px; font-weight: 700; letter-spacing: 2px; color: #9ca3af; text-transform: uppercase; margin-bottom: 14px; }\n.toc-list { list-style: none; padding: 0; margin: 0; }\n.toc-item { margin-bottom: 8px; font-size: 16px; }\n.toc-link { color: #102169; font-weight: 600; text-decoration: none; }\n.toc .toc-sub { margin: 4px 0 0 18px; }\n.toc .toc-sub .toc-link { color: #4b5563; font-size: 15px; font-weight: 400; }\n.section { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: 36px 40px; margin-bottom: 20px; }\n.section-title { color: #1a2744; font-size: 22px; font-weight: 700; line-height: 1.4; margin: 0 0 18px; }\n.subsection-title { color: #2d4a8a; font-size: 18px; font-weight: 700; line-height: 1.4; margin: 24px 0 10px; }\n.case-text { color: #374151; font-size: 17px; margin: 0 0 14px; }\n.case-list { list-style-type: disc; padding-left: 1.5rem; margin: 10px 0 14px; }\n.case-list-item { color: #374151; margin-bottom: 6px; font-weight: 800; }\n.assistance-highlight { background: linear-gradient(transparent 58%, #fde68a 58%); padding: 0 2px; font-weight: 800; color: #1f2937; }\n.public-text-issue { background: #fee2e2; color: #991b1b; border: 1px solid #ef4444; border-radius: 4px; box-shadow: 0 0 0 2px rgba(239, 68, 68, 0.16); padding: 0 3px; font-weight: 900; }\n.ref-box, .def-box, .qna-box, .order-box { background: #f9fafb; border-left: 4px solid #102169; border-radius: 4px; padding: 16px 20px; margin: 16px 0; font-size: 15px; }\n.case-table { width: 100%; border-collapse: collapse; margin: 16px 0 20px; font-size: 15px; table-layout: fixed; }\n.case-table-head, .case-table-cell { border: 1px solid #dbe1ee; padding: 10px 12px; vertical-align: top; word-break: keep-all; }\n.case-table-head { background: #f3f6fb; color: #1a2744; font-weight: 700; }\n.assistance-image { margin: 24px 0 4px; aspect-ratio: 16 / 9; overflow: hidden; border-radius: 8px; border: 1px solid #e5e7eb; }\n.assistance-image-img { display: block; width: 100%; height: 100%; object-fit: cover; border: 0; }\n.result-cta { background: #15266f; border-radius: 8px; padding: 28px 36px; margin-top: 28px; margin-bottom: 0; color: #fff; }\n.result-cta-text { color: #fff; font-size: 16px; font-weight: 700; line-height: 1.65; margin: 0 0 20px; }\n.result-cta-button { display: inline-block; background: #fff; color: #15266f; text-decoration: none; font-size: 15px; font-weight: 800; padding: 12px 22px; border-radius: 7px; }\n.result-cta + .tags { margin-top: 40px; }\n.footer-note { text-align: center; font-size: 14px; color: #9ca3af; padding: 20px 24px 40px; margin: 0; }\n@page { margin: 12mm; }\n/* 모바일만: 좌우 여백을 살짝 줄여 본문 폭 확보. PC 레이아웃은 유지. */\n@media (max-width: 720px) {\n  .preview-header { padding: 28px 18px; }\n  .preview-container { padding: 20px 12px 56px; }\n  .section { padding: 26px 16px; }\n  .section-title { font-size: 20px; }\n  .subsection-title { font-size: 17px; }\n  .case-text { font-size: 16px; }\n  .toc { padding: 18px 16px; }\n  .case-summary-card { padding: 18px 16px; }\n  .case-summary-table { font-size: 14px; }\n  .case-summary-label { width: 96px; }\n  .ref-box, .def-box, .qna-box, .order-box { padding: 14px 14px; }\n  .result-cta { padding: 22px 18px; }\n}\n@media (max-width: 768px) {\n  .preview-header .preview-lead { font-size: 22px; line-height: 1.4; }\n}\n@media print {\n  .preview-result, .preview-result { background: #f8fafc !important; }\n  .preview-header, .result-cta, .case-role-label, .case-table-head, .tag, .case-role-value, .ref-box, .def-box, .qna-box, .order-box {\n    -webkit-print-color-adjust: exact !important;\n    print-color-adjust: exact !important;\n  }\n  .preview-container { padding-bottom: 40px; }\n  .section, .toc, .case-summary-card, .result-cta { break-inside: avoid; page-break-inside: avoid; }\n  .result-cta + .tags { margin-top: 42px; }\n}\n}</style><div data-embedded-case-html-root=\"\" class=\"\" style=\"display:block;width:100%;min-width:0;box-sizing:border-box;\">\n\n<article class=\"preview-result\">\n  <header class=\"preview-header\">\n    <div class=\"label\">YK SUCCESS CASE</div>\n    <p class=\"preview-lead\">지방자치단체와 공단은 수질 개선을 위한 비점오염저감시설 설치공사를 추진하던 중, 인근 주민들로부터 환경피해 우려와 절차상 위법을 이유로 공사 전면 중지 신청을 받았습니다.</p>\n  </header>\n  <main class=\"preview-container\">\n    <div class=\"lead\" id=\"section-overview\">\n<p class=\"case-text\">YK 담당 변호사는 공사의 공익성과 절차 진행 경위, 신청인들의 구체적 생활피해 소명 부족을 중심으로 대응했고, 법원은 공사중지가처분 신청을 기각했습니다.</p></div>\n    <section class=\"case-summary-card\" aria-label=\"사건 결과 요약\"><div class=\"case-summary-title\"><span>사건 결과 요약</span><span class=\"case-role-badges\"><span class=\"case-role-badge case-role-badge-client\"><span class=\"case-role-label\">의뢰인</span><span class=\"case-role-value\">피고</span></span></span></div><table class=\"case-summary-table\"><tbody><tr><th class=\"case-summary-label case-summary-row-first\" scope=\"row\">사건 유형</th><td class=\"case-summary-value case-summary-row-first\">일반소송</td></tr><tr><th class=\"case-summary-label\" scope=\"row\">쟁점</th><td class=\"case-summary-value\">공사중지가처분 요건, 생활상 피해의 수인한도, 환경피해의 구체성, 사업의 공익성과 공사 중단 손실</td></tr><tr><th class=\"case-summary-label\" scope=\"row\">결과</th><td class=\"case-summary-value\">(전부)승소</td></tr><tr><th class=\"case-summary-label\" scope=\"row\">대응 포인트</th><td class=\"case-summary-value\">공사 중지 필요성 부족과 사업의 공익성을 중심으로 가처분 신청을 방어</td></tr></tbody></table></section><div data-case-cta-slot=\"top\"></div>\n    <nav class=\"toc\"><div class=\"toc-title\">CONTENTS</div><ul class=\"toc-list\"><li class=\"toc-item\"><a class=\"toc-link\">환경피해 우려로 제기된 공사중지가처분</a></li><li class=\"toc-item\"><a class=\"toc-link\">공사중지가처분이 인정되는 판단 기준</a></li><li class=\"toc-item\"><a class=\"toc-link\">공사중지가처분 기각을 이끈 YK 담당 변호사의 대응</a><ul class=\"toc-list toc-sub\"><li class=\"toc-item\"><a class=\"toc-link\">공사 중지 요건의 엄격성을 근거로 방어</a></li><li class=\"toc-item\"><a class=\"toc-link\">환경피해 우려의 구체성 부족을 근거로 반박</a></li><li class=\"toc-item\"><a class=\"toc-link\">사업의 공익성과 중단 손실을 근거로 주장</a></li></ul></li><li class=\"toc-item\"><a class=\"toc-link\">일반소송 사건 결과 : (전부)승소</a></li></ul></nav>\n    <section class=\"section\" id=\"section-background\"><h2 class=\"section-title\">환경피해 우려로 제기된 공사중지가처분</h2><p class=\"case-text\">의뢰인 측은 축산지역 오염물질이 하천으로 흘러드는 것을 줄이고 수질을 개선하기 위해 비점오염저감시설 설치공사를 추진했습니다.</p>\n<p class=\"case-text\">그러나 인근 주민들은 공사 과정의 소음·진동·분진과 시설 완공 후 악취·해충 발생을 우려했습니다.</p>\n<p class=\"case-text\">주민들은 환경영향평가와 주민설명회 절차에도 문제가 있다고 주장하며, 성토·굴착·구조물 설치를 포함한 <strong>공사 전면 중지를 구하는 가처분</strong>을 신청했습니다.</p>\n<p class=\"case-text\">사업 자체가 멈출 수 있는 상황에서, 의뢰인 측은 절차의 적법성과 공익적 필요성을 설명하기 위해 YK 담당 변호사를 찾았습니다.</p><figure class=\"assistance-image\"><img class=\"assistance-image-img\" src=\"https://www.yklawfirm.co.kr/ai_case/15977/99950e9d227f5bed.webp\" alt=\"공사중지가처분 신청 기각 대응 비점오염저감시설 설치공사 분쟁\"></figure></section><section class=\"section\" id=\"section-info-1\"><h2 class=\"section-title\">공사중지가처분이 인정되는 판단 기준</h2><p class=\"case-text\">공사중지가처분은 공사가 계속되면 회복하기 어려운 피해가 발생할 우려가 있을 때, 본안소송의 결과가 나오기 전 공사를 멈춰 달라고 법원에 요청하는 절차입니다. 공사 전면 중지는 사업 진행 자체를 멈추게 하므로, 법원은 일반적인 임시조치보다 엄격한 기준을 적용합니다.</p>\n<p class=\"case-text\">특히 신청인이 주장하는 권리와 공사를 즉시 멈춰야 할 필요성이 <strong>높은 수준으로 구체적으로 입증되어야 합니다.</strong> 단순히 환경상 우려가 있다는 사정만으로는 부족합니다.</p>\n<p class=\"case-text\">헌법상 환경권은 중요한 기본권이지만, 그 자체만으로 특정 공사를 직접 중단시킬 수 있는 민사상 권리가 곧바로 인정되는 것은 아닙니다. 공사로 인해 개인의 생활이익이 실제로 침해되거나 침해될 가능성이 높다는 점을 보여야 합니다.</p>\n<p class=\"case-text\">법원은 주로 다음과 같은 사정을 살핍니다.</p>\n<ul class=\"case-list\"><li class=\"case-list-item\">신청인이 사업부지 인근에서 지속적으로 생활하는지</li><li class=\"case-list-item\">소음·진동·분진 등이 통상 감수할 수준을 넘는지</li><li class=\"case-list-item\">악취나 해충 등 완공 후 예상되는 피해가 구체적으로 예상되는지</li><li class=\"case-list-item\">환경영향평가, 주민설명회 등 사업 절차에 명백한 위법이 있는지</li><li class=\"case-list-item\">공사 중단으로 발생할 공익상·경제상 손실이 어느 정도인지</li></ul>\n<p class=\"case-text\">공사 피해가 사회통념상 감수하기 어려운 수준을 넘는지는 거리, 피해의 정도와 지속성, 주변 환경, 저감조치 가능성 등을 함께 고려해 판단합니다. 장래 발생할 수 있다는 우려만으로는 부족하며, 피해 발생 가능성과 범위를 뒷받침할 구체적 사정이 필요합니다.</p>\n<p class=\"case-text\">반면 사업이 수질 개선이나 오염 방지처럼 공익적 목적을 가지고 있고, 공사를 멈출 경우 상당한 사회적 손실이 예상된다면 법원은 공사중지 필요성을 더욱 신중하게 판단합니다. 향후 실제 피해가 인정될 경우 금전배상으로 회복할 수 있는지도 중요한 판단 요소가 됩니다.</p></section><section class=\"section\" id=\"section-assistance\"><h2 class=\"section-title\">공사중지가처분 기각을 이끈 YK 담당 변호사의 대응</h2><section id=\"section-assistance-sub-1\"><h3 class=\"subsection-title\">공사 중지 요건의 엄격성을 근거로 방어</h3><p class=\"case-text\">YK 담당 변호사는 <mark class=\"assistance-highlight\"><strong>공사 전면 중지는 사실상 본안소송과 같은 결과를 낳는 임시조치</strong></mark>라는 점을 강조했습니다. 주민 측이 주장하는 권리와 공사를 즉시 멈춰야 할 필요성은 높은 수준으로 소명돼야 한다고 주장했습니다.</p></section><section id=\"section-assistance-sub-2\"><h3 class=\"subsection-title\">환경피해 우려의 구체성 부족을 근거로 반박</h3><p class=\"case-text\">YK 담당 변호사는 일부 신청인이 사업부지 인근에서 일상생활을 한다고 보기 어려운 사정을 짚었습니다. <mark class=\"assistance-highlight\"><strong>소음·진동·분진, 향후 악취·해충이 각 신청인의 생활에 미치는 영향</strong></mark>과 감내하기 어려운 수준인지도 구체적으로 제시되지 않았다고 반박했습니다.</p></section><section id=\"section-assistance-sub-3\"><h3 class=\"subsection-title\">사업의 공익성과 중단 손실을 근거로 주장</h3><p class=\"case-text\">YK 담당 변호사는 <mark class=\"assistance-highlight\"><strong>해당 사업이 축산지역 오염물질의 하천 유출을 줄이고 식수원 수질을 개선하기 위한 사업</strong></mark>임을 주장했습니다. 절차상 위법성이 현 단계에서 명백하지 않고, 공사 중단 시 사회·경제적 손실이 커질 수 있다는 점도 함께 제시했습니다.</p></section></section><section class=\"section\" id=\"section-result\"><h2 class=\"section-title\">일반소송 사건 결과 : (전부)승소</h2><p class=\"case-text\">법원은 주민들이 제기한 공사중지가처분 신청을 <strong>기각</strong>했습니다.</p>\n<div class=\"circled-result\"><p class=\"case-text\">① <strong>공사 전면 중지는 본안소송과 같은 결과를 가져올 수 있어 높은 수준의 소명이 필요한 점</strong></p><p class=\"case-text\">② <strong>공사로 인한 생활상 피해가 수인한도를 넘는다고 보기 어려운 점</strong></p><p class=\"case-text\">③ <strong>사업의 수질 개선 공익성과 공사 중단에 따른 손실이 큰 점</strong></p></div>\n<p class=\"case-text\">그 결과 의뢰인 측은 사업을 계속 추진할 수 있게 됐습니다.</p>\n<p class=\"case-text\"></p></section>\n    \n    <div class=\"tags\"><span class=\"tag\">공사중지가처분</span><span class=\"tag\">환경권분쟁</span><span class=\"tag\">환경영향평가</span><span class=\"tag\">가처분신청기각</span><span class=\"tag\">기업</span><span class=\"tag\">일반소송</span></div>\n  </main>\n</article>\n\n\n  \n\n</div>"}