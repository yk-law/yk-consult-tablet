color: #fff; background: #102169; }\n.case-role-value { padding: 5px 9px; color: #102169; background: #f3f6ff; }\n.case-summary-table { width: 100%; border-collapse: collapse; table-layout: fixed; font-size: 15px; }\n.case-summary-label, .case-summary-value { border-top: 1px solid #e5eaf3; padding: 11px 0; vertical-align: top; text-align: left; }\n.case-summary-row-first { border-top: 0; }\n.case-summary-label { width: 118px; color: #1a2744; font-weight: 800; }\n.case-summary-value { color: #374151; font-weight: 600; }\n.toc { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: 24px 32px; margin-bottom: 20px; }\n.toc-title { font-size: 11px; font-weight: 700; letter-spacing: 2px; color: #9ca3af; text-transform: uppercase; margin-bottom: 14px; }\n.toc-list { list-style: none; padding: 0; margin: 0; }\n.toc-item { margin-bottom: 8px; font-size: 16px; }\n.toc-link { color: #102169; font-weight: 600; text-decoration: none; }\n.toc .toc-sub { margin: 4px 0 0 18px; }\n.toc .toc-sub .toc-link { color: #4b5563; font-size: 15px; font-weight: 400; }\n.section { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: 36px 40px; margin-bottom: 20px; }\n.section-title { color: #1a2744; font-size: 22px; font-weight: 700; line-height: 1.4; margin: 0 0 18px; }\n.subsection-title { color: #2d4a8a; font-size: 18px; font-weight: 700; line-height: 1.4; margin: 24px 0 10px; }\n.case-text { color: #374151; font-size: 17px; margin: 0 0 14px; }\n.case-list { list-style-type: disc; padding-left: 1.5rem; margin: 10px 0 14px; }\n.case-list-item { color: #374151; margin-bottom: 6px; font-weight: 800; }\n.assistance-highlight { background: linear-gradient(transparent 58%, #fde68a 58%); padding: 0 2px; font-weight: 800; color: #1f2937; }\n.public-text-issue { background: #fee2e2; color: #991b1b; border: 1px solid #ef4444; border-radius: 4px; box-shadow: 0 0 0 2px rgba(239, 68, 68, 0.16); padding: 0 3px; font-weight: 900; }\n.ref-box, .def-box, .qna-box, .order-box { background: #f9fafb; border-left: 4px solid #102169; border-radius: 4px; padding: 16px 20px; margin: 16px 0; font-size: 15px; }\n.case-table { width: 100%; border-collapse: collapse; margin: 16px 0 20px; font-size: 15px; table-layout: fixed; }\n.case-table-head, .case-table-cell { border: 1px solid #dbe1ee; padding: 10px 12px; vertical-align: top; word-break: keep-all; }\n.case-table-head { background: #f3f6fb; color: #1a2744; font-weight: 700; }\n.assistance-image { margin: 24px 0 4px; aspect-ratio: 16 / 9; overflow: hidden; border-radius: 8px; border: 1px solid #e5e7eb; }\n.assistance-image-img { display: block; width: 100%; height: 100%; object-fit: cover; border: 0; }\n.result-cta { background: #15266f; border-radius: 8px; padding: 28px 36px; margin-top: 28px; margin-bottom: 0; color: #fff; }\n.result-cta-text { color: #fff; font-size: 16px; font-weight: 700; line-height: 1.65; margin: 0 0 20px; }\n.result-cta-button { display: inline-block; background: #fff; color: #15266f; text-decoration: none; font-size: 15px; font-weight: 800; padding: 12px 22px; border-radius: 7px; }\n.result-cta + .tags { margin-top: 40px; }\n.footer-note { text-align: center; font-size: 14px; color: #9ca3af; padding: 20px 24px 40px; margin: 0; }\n@page { margin: 12mm; }\n/* 모바일만: 좌우 여백을 살짝 줄여 본문 폭 확보. PC 레이아웃은 유지. */\n@media (max-width: 720px) {\n  .preview-header { padding: 28px 18px; }\n  .preview-container { padding: 20px 12px 56px; }\n  .section { padding: 26px 16px; }\n  .section-title { font-size: 20px; }\n  .subsection-title { font-size: 17px; }\n  .case-text { font-size: 16px; }\n  .toc { padding: 18px 16px; }\n  .case-summary-card { padding: 18px 16px; }\n  .case-summary-table { font-size: 14px; }\n  .case-summary-label { width: 96px; }\n  .ref-box, .def-box, .qna-box, .order-box { padding: 14px 14px; }\n  .result-cta { padding: 22px 18px; }\n}\n@media (max-width: 768px) {\n  .preview-header .preview-lead { font-size: 22px; line-height: 1.4; }\n}\n@media print {\n  .preview-result, .preview-result { background: #f8fafc !important; }\n  .preview-header, .result-cta, .case-role-label, .case-table-head, .tag, .case-role-value, .ref-box, .def-box, .qna-box, .order-box {\n    -webkit-print-color-adjust: exact !important;\n    print-color-adjust: exact !important;\n  }\n  .preview-container { padding-bottom: 40px; }\n  .section, .toc, .case-summary-card, .result-cta { break-inside: avoid; page-break-inside: avoid; }\n  .result-cta + .tags { margin-top: 42px; }\n}\n}</style><div data-embedded-case-html-root=\"\" class=\"\" style=\"display:block;width:100%;min-width:0;box-sizing:border-box;\">\n\n<article class=\"preview-result\">\n  <header class=\"preview-header\">\n    <div class=\"label\">YK SUCCESS CASE</div>\n    <p class=\"preview-lead\">의뢰인은 공유 부동산을 관리·임대하던 상대방과 임대수익 정산을 두고 분쟁이 생겨, 자신의 지분에 해당하는 수익을 돌려받기 위한 부당이득금반환 소송을 제기했습니다.</p>\n  </header>\n  <main class=\"preview-container\">\n    <div class=\"lead\" id=\"section-overview\">\n<p class=\"case-text\">1심에서 청구가 일부 인정되었으나, 의뢰인은 인정받지 못한 금액에 대해 항소하여 임대수익과 공제 비용의 범위를 다시 다투게 되었습니다.</p>\n<p class=\"case-text\">YK 담당 변호사는 의뢰인의 항소심 절차를 진행했으며, 의뢰인은 상대방으로부터 약 7,529만 원과 이에 대한 지연손해금을 추가로 지급받도록 하는 판결을 받았습니다.</p></div>\n    <section class=\"case-summary-card\" aria-label=\"사건 결과 요약\"><div class=\"case-summary-title\"><span>사건 결과 요약</span><span class=\"case-role-badges\"><span class=\"case-role-badge case-role-badge-client\"><span class=\"case-role-label\">의뢰인</span><span class=\"case-role-value\">원고(반소피고)</span></span></span></div><table class=\"case-summary-table\"><tbody><tr><th class=\"case-summary-label case-summary-row-first\" scope=\"row\">사건 유형</th><td class=\"case-summary-value case-summary-row-first\">부당이득금</td></tr><tr><th class=\"case-summary-label\" scope=\"row\">쟁점</th><td class=\"case-summary-value\">제3자 임대료 합의의 효력 범위, 이자수익·잡수익의 정산 포함 여부, 순수익 산정 시 공제할 비용 범위</td></tr><tr><th class=\"case-summary-label\" scope=\"row\">결과</th><td class=\"case-summary-value\">일부승소</td></tr><tr><th class=\"case-summary-label\" scope=\"row\">대응 포인트</th><td class=\"case-summary-value\">제3자 합의의 효력과 정산 대상 수익·비용 범위를 다투는 항소심 대응</td></tr></tbody></table></section><div data-case-cta-slot=\"top\"></div>\n    <nav class=\"toc\"><div class=\"toc-title\">CONTENTS</div><ul class=\"toc-list\"><li class=\"toc-item\"><a class=\"toc-link\">공유 부동산 임대수익 정산을 둘러싼 부당이득금 분쟁</a></li><li class=\"toc-item\"><a class=\"toc-link\">공유 부동산 임대수익의 부당이득반환 판단 기준</a><ul class=\"toc-list toc-sub\"><li class=\"toc-item\"><a class=\"toc-link\">임대수익을 얻은 공유자에게 반환 의무가 생기는 경우</a></li><li class=\"toc-item\"><a class=\"toc-link\">제3자와의 임대료 합의가 다른 공유자에게도 적용될까</a></li><li class=\"toc-item\"><a class=\"toc-link\">수익과 비용을 입증하려면 어떤 자료가 필요할까</a></li></ul></li><li class=\"toc-item\"><a class=\"toc-link\">부당이득금 추가 지급 판결을 받은 YK 담당 변호사의 항소심 대응</a><ul class=\"toc-list toc-sub\"><li class=\"toc-item\"><a class=\"toc-link\">제3자 임대료 합의의 효력 범위 정리</a></li><li class=\"toc-item\"><a class=\"toc-link\">임대수익 정산에 포함할 수익 항목 정리</a></li><li class=\"toc-item\"><a class=\"toc-link\">순수익 산정에서 제외할 비용 항목 정리</a></li></ul></li><li class=\"toc-item\"><a class=\"toc-link\">부당이득금 사건 결과 : 일부승소</a></li></ul></nav>\n    <section class=\"section\" id=\"section-background\"><h2 class=\"section-title\">공유 부동산 임대수익 정산을 둘러싼 부당이득금 분쟁</h2><p class=\"case-text\">의뢰인은 부동산의 2/13 지분을 보유하고 있었습니다.</p>\n<p class=\"case-text\">나머지 지분을 가진 상대방이 부동산 전체를 관리하고 임대하면서 수익을 얻었으나, 의뢰인에게 돌아갈 정산금의 범위를 두고 다툼이 생겼습니다.</p>\n<p class=\"case-text\">의뢰인은 <strong>자신의 지분에 따른 임대수익을 돌려달라는 부당이득금 반환 소송</strong>을 제기했습니다.</p>\n<p class=\"case-text\">상대방은 제3자와 맺은 임대료 합의와 이미 지급한 금액을 근거로 추가로 반환할 돈이 없다고 주장했습니다.</p>\n<p class=\"case-text\">1심에서는 의뢰인의 청구가 일부만 인정됐습니다.</p>\n<p class=\"case-text\">의뢰인은 인정받지 못한 금액을 다시 다투기 위해 항소했습니다.</p>\n<p class=\"case-text\">항소심에서는 임대수익에 포함할 항목과 공제할 비용이 중요했기에, YK 담당 변호사의 도움을 받아 정산 범위를 다투게 되었습니다.</p><figure class=\"assistance-image\"><img class=\"assistance-image-img\" src=\"https://www.yklawfirm.co.kr/ai_case/17064/9433bae0780977b0.webp\" alt=\"공유 부동산 임대수익 정산과 부당이득금 항소심 추가 지급을 다툰 사례\"></figure></section><section class=\"section\" id=\"section-info-1\"><h2 class=\"section-title\">공유 부동산 임대수익의 부당이득반환 판단 기준</h2><section id=\"section-info-1-sub-1\"><h3 class=\"subsection-title\">임대수익을 얻은 공유자에게 반환 의무가 생기는 경우</h3><p class=\"case-text\">이 사건 항소심에서는 의뢰인이 1심에서 인정받지 못한 반환금의 범위가 심리 대상이 됐습니다. 핵심은 상대방이 얻은 수익과 공제할 비용을 따져 추가로 정산할 금액이 있는지였습니다.</p>\n<div class=\"ref-box\"><span class=\"ref-title\">관련 쟁점은 <strong><a rel=\"noopener noreferrer\">부당이득반환청구소송 성립 요건·절차·준비사항 총정리</a></strong>에서 확인하실 수 있습니다.</span><span class=\"ref-body\"></span></div>\n<p class=\"case-text\">민법 제263조에 따르면 공유자는 자신의 지분 비율에 따라 공유물 전체를 사용하고 수익을 얻을 수 있습니다. 한 공유자가 부동산 전체를 배타적으로 임대해 수익을 가져갔다면, <strong>순수익 중 다른 공유자의 지분에 해당하는 금액을 반환해야 할 수 있습니다.</strong></p>\n<p class=\"case-text\">부당이득반환청구에서는 상대방이 얻은 이익과 그로 인한 손실, 이익을 보유할 법률상 근거가 있는지가 중요합니다. 이 사건에서도 임대수익 전액이 아니라 비용을 뺀 순수익을 기준으로 의뢰인의 몫을 산정했습니다.</p></section><section id=\"section-info-1-sub-2\"><h3 class=\"subsection-title\">제3자와의 임대료 합의가 다른 공유자에게도 적용될까</h3><p class=\"case-text\">임대료 합의가 있다는 이유만으로 모든 공유자가 그 내용에 구속되는 것은 아닙니다. 누가 합의 당사자인지, 다른 공유자를 대신해 합의할 권한이 있었는지를 구분해야 합니다.</p>\n<p class=\"case-text\">상대방은 제3자와 맺은 임대료 합의를 근거로 수익 취득이 정당하다고 주장했습니다. 그러나 법원은 <strong>제3자가 의뢰인 회사의 사내이사였다는 사정만으로 그 합의의 효력이 의뢰인에게 미치지는 않는다</strong>고 판단했습니다.</p></section><section id=\"section-info-1-sub-3\"><h3 class=\"subsection-title\">수익과 비용을 입증하려면 어떤 자료가 필요할까</h3><p class=\"case-text\">정산에서는 실제 수익과 비용의 성격을 나누어 살펴야 합니다. 임대차계약서와 입금 내역은 임대수익을, 회계장부와 계좌 거래 내역은 이자수익·잡수익을 확인하는 데 활용할 수 있습니다. 비용은 지출 내역과 함께 임대·관리에 필요한 지출이었는지를 뒷받침해야 합니다.</p>\n<p class=\"case-text\">이 사건에서는 임대·관리 과정에서 발생한 이자수익과 잡수익도 총이익에 포함됐습니다. 반면 이 사건에서는 감가상각비, 무형자산상각비, 간주임대료 부가세, 재산세를 총비용에서 제외하는 데 당사자 사이에 다툼이 없었고, 법원도 해당 금액을 제외해 정산했습니다. 회계상 비용이라고 해서 정산에서도 모두 공제되는 것은 아닙니다.</p>\n<p class=\"case-text\">인건비를 다툴 때도 구체적인 근거가 필요합니다. 법원은 상대방 배우자의 급여와 아르바이트 비용이 부당하거나 불필요하다는 주장을 받아들이지 않았습니다. 비용의 명칭이나 지급 대상만 문제 삼기보다 실제 업무와 지출 필요성을 보여주는 자료가 중요합니다.</p></section></section><section class=\"section\" id=\"section-assistance\"><h2 class=\"section-title\">부당이득금 추가 지급 판결을 받은 YK 담당 변호사의 항소심 대응</h2><p class=\"case-text\">YK 담당 변호사는 의뢰인이 1심에서 인정받지 못한 부당이득금에 관한 항소심 절차를 진행했습니다.</p><section id=\"section-assistance-sub-1\"><h3 class=\"subsection-title\">제3자 임대료 합의의 효력 범위 정리</h3><p class=\"case-text\">항소심에서는 <mark class=\"assistance-highlight\"><strong>제3자와의 임대료 합의가 의뢰인에게도 적용되는지</strong></mark>가 쟁점이었습니다. 법원은 제3자가 의뢰인 회사의 사내이사였다는 사정만으로 합의 당사자가 아닌 의뢰인에게 효력이 미치지는 않는다고 판단했습니다.</p></section><section id=\"section-assistance-sub-2\"><h3 class=\"subsection-title\">임대수익 정산에 포함할 수익 항목 정리</h3><p class=\"case-text\">정산 대상에는 임대료 외에 임대·관리 과정에서 발생한 이자수익과 잡수익도 포함되는지가 다뤄졌습니다. 법원은 이를 총이익에 포함해 <mark class=\"assistance-highlight\"><strong>약 58억원</strong></mark>을 인정했습니다. 의뢰인 지분에 따른 반환액 산정에서 수익의 범위가 중요했습니다.</p></section><section id=\"section-assistance-sub-3\"><h3 class=\"subsection-title\">순수익 산정에서 제외할 비용 항목 정리</h3><p class=\"case-text\">법원은 감가상각비·무형자산상각비·간주임대료 부가세·재산세 합계 <mark class=\"assistance-highlight\"><strong>약 7억 5,217만 원을 비용에서 제외</strong></mark>했습니다. 다만 상대방 배우자의 급여와 아르바이트 비용이 부당하거나 불필요하다는 주장은 받아들이지 않았습니다. 이처럼 공제할 비용을 항목별로 구분해 의뢰인에게 반환할 순수익을 판단했습니다.</p></section></section><section class=\"section\" id=\"section-result\"><h2 class=\"section-title\">부당이득금 사건 결과 : 일부승소</h2><p class=\"case-text\">항소심 법원은 <strong>1심에서 의뢰인이 패소한 부분을 일부 취소하고, 상대방에게 부당이득금 추가 지급을 명했습니다.</strong></p>\n<div class=\"circled-result\"><p class=\"case-text\">① <strong>제3자와 체결한 임대료 합의의 효력이 합의 당사자가 아닌 의뢰인에게 미치지 않는 점</strong></p><p class=\"case-text\">② <strong>부동산 임대·관리 과정에서 발생한 이자수익과 잡수익도 정산할 총이익에 포함되는 점</strong></p><p class=\"case-text\">③ <strong>감가상각비·무형자산상각비·간주임대료 부가세·재산세 합계 약 7억 5,217만 원을 정산 비용에서 제외해야 하는 점</strong></p></div>\n<p class=\"case-text\">그 결과 의뢰인은 <strong>상대방으로부터 약 7,529만 원과 이에 따른 지연손해금을 추가로 지급받는 판결</strong>을 받았습니다. 이번 사건은 제3자 합의의 효력과 임대수익·비용의 범위를 구분해 살핀 결과, 항소심에서 의뢰인이 돌려받을 정산금이 늘어난 사례입니다.</p>\n<p class=\"case-text\"></p></section>\n    \n    <div class=\"tags\"><span class=\"tag\">부당이득금반환</span><span class=\"tag\">공유부동산</span><span class=\"tag\">임대수익정산</span><span class=\"tag\">항소심일부승소</span><span class=\"tag\">민사</span><span class=\"tag\">부당이득금</span></div>\n  </main>\n</article>\n\n\n  \n\n</div>"}