5px 7px; color: #fff; background: #102169; }\n.case-role-value { padding: 5px 9px; color: #102169; background: #f3f6ff; }\n.case-summary-table { width: 100%; border-collapse: collapse; table-layout: fixed; font-size: 15px; }\n.case-summary-label, .case-summary-value { border-top: 1px solid #e5eaf3; padding: 11px 0; vertical-align: top; text-align: left; }\n.case-summary-row-first { border-top: 0; }\n.case-summary-label { width: 118px; color: #1a2744; font-weight: 800; }\n.case-summary-value { color: #374151; font-weight: 600; }\n.toc { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: 24px 32px; margin-bottom: 20px; }\n.toc-title { font-size: 11px; font-weight: 700; letter-spacing: 2px; color: #9ca3af; text-transform: uppercase; margin-bottom: 14px; }\n.toc-list { list-style: none; padding: 0; margin: 0; }\n.toc-item { margin-bottom: 8px; font-size: 16px; }\n.toc-link { color: #102169; font-weight: 600; text-decoration: none; }\n.toc .toc-sub { margin: 4px 0 0 18px; }\n.toc .toc-sub .toc-link { color: #4b5563; font-size: 15px; font-weight: 400; }\n.section { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: 36px 40px; margin-bottom: 20px; }\n.section-title { color: #1a2744; font-size: 22px; font-weight: 700; line-height: 1.4; margin: 0 0 18px; }\n.subsection-title { color: #2d4a8a; font-size: 18px; font-weight: 700; line-height: 1.4; margin: 24px 0 10px; }\n.case-text { color: #374151; font-size: 17px; margin: 0 0 14px; }\n.case-list { list-style-type: disc; padding-left: 1.5rem; margin: 10px 0 14px; }\n.case-list-item { color: #374151; margin-bottom: 6px; font-weight: 800; }\n.assistance-highlight { background: linear-gradient(transparent 58%, #fde68a 58%); padding: 0 2px; font-weight: 800; color: #1f2937; }\n.public-text-issue { background: #fee2e2; color: #991b1b; border: 1px solid #ef4444; border-radius: 4px; box-shadow: 0 0 0 2px rgba(239, 68, 68, 0.16); padding: 0 3px; font-weight: 900; }\n.ref-box, .def-box, .qna-box, .order-box { background: #f9fafb; border-left: 4px solid #102169; border-radius: 4px; padding: 16px 20px; margin: 16px 0; font-size: 15px; }\n.case-table { width: 100%; border-collapse: collapse; margin: 16px 0 20px; font-size: 15px; table-layout: fixed; }\n.case-table-head, .case-table-cell { border: 1px solid #dbe1ee; padding: 10px 12px; vertical-align: top; word-break: keep-all; }\n.case-table-head { background: #f3f6fb; color: #1a2744; font-weight: 700; }\n.assistance-image { margin: 24px 0 4px; aspect-ratio: 16 / 9; overflow: hidden; border-radius: 8px; border: 1px solid #e5e7eb; }\n.assistance-image-img { display: block; width: 100%; height: 100%; object-fit: cover; border: 0; }\n.result-cta { background: #15266f; border-radius: 8px; padding: 28px 36px; margin-top: 28px; margin-bottom: 0; color: #fff; }\n.result-cta-text { color: #fff; font-size: 16px; font-weight: 700; line-height: 1.65; margin: 0 0 20px; }\n.result-cta-button { display: inline-block; background: #fff; color: #15266f; text-decoration: none; font-size: 15px; font-weight: 800; padding: 12px 22px; border-radius: 7px; }\n.result-cta + .tags { margin-top: 40px; }\n.footer-note { text-align: center; font-size: 14px; color: #9ca3af; padding: 20px 24px 40px; margin: 0; }\n@page { margin: 12mm; }\n/* 모바일만: 좌우 여백을 살짝 줄여 본문 폭 확보. PC 레이아웃은 유지. */\n@media (max-width: 720px) {\n  .preview-header { padding: 28px 18px; }\n  .preview-container { padding: 20px 12px 56px; }\n  .section { padding: 26px 16px; }\n  .section-title { font-size: 20px; }\n  .subsection-title { font-size: 17px; }\n  .case-text { font-size: 16px; }\n  .toc { padding: 18px 16px; }\n  .case-summary-card { padding: 18px 16px; }\n  .case-summary-table { font-size: 14px; }\n  .case-summary-label { width: 96px; }\n  .ref-box, .def-box, .qna-box, .order-box { padding: 14px 14px; }\n  .result-cta { padding: 22px 18px; }\n}\n@media (max-width: 768px) {\n  .preview-header .preview-lead { font-size: 22px; line-height: 1.4; }\n}\n@media print {\n  .preview-result, .preview-result { background: #f8fafc !important; }\n  .preview-header, .result-cta, .case-role-label, .case-table-head, .tag, .case-role-value, .ref-box, .def-box, .qna-box, .order-box {\n    -webkit-print-color-adjust: exact !important;\n    print-color-adjust: exact !important;\n  }\n  .preview-container { padding-bottom: 40px; }\n  .section, .toc, .case-summary-card, .result-cta { break-inside: avoid; page-break-inside: avoid; }\n  .result-cta + .tags { margin-top: 42px; }\n}\n}</style><div data-embedded-case-html-root=\"\" class=\"\" style=\"display:block;width:100%;min-width:0;box-sizing:border-box;\">\n\n<article class=\"preview-result\">\n  <header class=\"preview-header\">\n    <div class=\"label\">YK SUCCESS CASE</div>\n    <p class=\"preview-lead\">의뢰인은 배우자의 부정행위를 이유로 이혼소송을 제기해 1심에서 자녀의 친권자 및 양육자로 지정되었으나, 상대방이 항소하면서 자녀가 자신과 살기를 원한다는 이유로 변경을 요구했습니다.</p>\n  </header>\n  <main class=\"preview-container\">\n    <div class=\"lead\" id=\"section-overview\">\n<p class=\"case-text\">YK 담당 변호사는 자녀가 의뢰인과 상당 기간 생활하며 형성한 양육환경의 안정성과 환경 변경에 따른 정서적 부담을 중심으로 대응했고, 항소심에서도 의뢰인의 친권자 및 양육자 지정이 유지되었습니다.</p></div>\n    <section class=\"case-summary-card\" aria-label=\"사건 결과 요약\"><div class=\"case-summary-title\"><span>사건 결과 요약</span><span class=\"case-role-badges\"><span class=\"case-role-badge case-role-badge-client\"><span class=\"case-role-label\">의뢰인</span><span class=\"case-role-value\">원고</span></span></span></div><table class=\"case-summary-table\"><tbody><tr><th class=\"case-summary-label case-summary-row-first\" scope=\"row\">사건 유형</th><td class=\"case-summary-value case-summary-row-first\">이혼소송</td></tr><tr><th class=\"case-summary-label\" scope=\"row\">쟁점</th><td class=\"case-summary-value\">친권자·양육자 변경 여부, 자녀의 의사와 의사표현 경위, 양측의 양육능력과 보조양육환경, 양육환경 변경에 따른 정서적 부담</td></tr><tr><th class=\"case-summary-label\" scope=\"row\">결과</th><td class=\"case-summary-value\">일부승소</td></tr><tr><th class=\"case-summary-label\" scope=\"row\">대응 포인트</th><td class=\"case-summary-value\">현재 양육환경의 안정성과 자녀의 복리를 중심으로 친권자·양육자 지정 유지 주장</td></tr></tbody></table></section><div data-case-cta-slot=\"top\"></div>\n    <nav class=\"toc\"><div class=\"toc-title\">CONTENTS</div><ul class=\"toc-list\"><li class=\"toc-item\"><a class=\"toc-link\">이혼소송 후 항소심으로 이어진 양육권 다툼</a></li><li class=\"toc-item\"><a class=\"toc-link\">이혼소송에서 친권자·양육자 변경을 판단하는 기준</a><ul class=\"toc-list toc-sub\"><li class=\"toc-item\"><a class=\"toc-link\">양육환경이 달라지면 양육자를 바꿀 수 있을까</a></li><li class=\"toc-item\"><a class=\"toc-link\">양육자 변경이 자녀의 복리에 부합하는지 판단하는 기준</a></li></ul></li><li class=\"toc-item\"><a class=\"toc-link\">이혼소송 친권·양육자 지정 유지를 위한 YK 담당 변호사의 대응</a><ul class=\"toc-list toc-sub\"><li class=\"toc-item\"><a class=\"toc-link\">자녀 의사표현 경위를 검토해 양육자 지정 유지 주장</a></li><li class=\"toc-item\"><a class=\"toc-link\">양육환경 변경에 따른 정서적 부담을 근거로 방어</a></li></ul></li><li class=\"toc-item\"><a class=\"toc-link\">이혼소송 사건 결과 : 일부승소</a></li></ul></nav>\n    <section class=\"section\" id=\"section-background\"><h2 class=\"section-title\">이혼소송 후 항소심으로 이어진 양육권 다툼</h2><p class=\"case-text\">의뢰인은 배우자의 부정행위를 이유로 이혼소송을 제기했습니다.</p>\n<p class=\"case-text\">1심에서는 의뢰인이 자녀의 친권자 및 양육자로 지정되었습니다.</p>\n<p class=\"case-text\">이후 자녀를 인도받아 상당 기간 함께 생활했고, 자녀는 초등학교에 다니고 있었습니다.</p>\n<p class=\"case-text\">그러나 상대방은 자녀가 자신과 함께 살기를 원한다는 점을 내세워 항소했습니다.</p>\n<p class=\"case-text\">친권자와 양육자를 바꾸어 달라고 요구하면서 자녀 인도와 양육비, 위자료 판단도 다시 다투었습니다.</p>\n<p class=\"case-text\"><strong>이혼 자체는 항소심에서 다루는 대상이 아니었습니다.</strong></p>\n<p class=\"case-text\">의뢰인은 자녀와 이어온 양육환경을 유지하기 위해 항소심 대응이 필요했습니다.</p>\n<p class=\"case-text\">이에 YK 담당 변호사의 도움을 받아 자녀의 의사뿐 아니라 현재의 생활환경과 양육 상황을 함께 설명하며 상대방의 변경 요구에 대응하게 되었습니다.</p><figure class=\"assistance-image\"><img class=\"assistance-image-img\" src=\"https://www.yklawfirm.co.kr/ai_case/18277/d53655e44b02af73.webp\" alt=\"이혼소송 항소심에서 자녀 양육권 변경 요구에 대응한 사례\"></figure></section><section class=\"section\" id=\"section-info-1\"><h2 class=\"section-title\">이혼소송에서 친권자·양육자 변경을 판단하는 기준</h2><section id=\"section-info-1-sub-1\"><h3 class=\"subsection-title\">양육환경이 달라지면 양육자를 바꿀 수 있을까</h3><p class=\"case-text\">항소심에서 친권자·양육자 지정을 다툴 때는 1심 이후의 양육 상황도 살펴봅니다. 이 사건에서도 자녀가 의뢰인에게 인도된 뒤 이어온 생활과 상대방이 제시한 변경 사유가 판단 대상이 되었습니다.</p>\n<div class=\"ref-box\"><span class=\"ref-title\">관련 쟁점은 <strong><a rel=\"noopener noreferrer\">친권자 및 양육권변경 방법과 판단 기준</a></strong>에서 확인하실 수 있습니다.</span><span class=\"ref-body\"></span></div>\n<p class=\"case-text\">이혼하면서 친권자와 양육자를 정했더라도, 이후 양육환경이 달라지면 변경할 수 있습니다. 다만 부모가 기존 결정에 불만을 갖거나 자녀와 함께 살기를 원한다는 이유만으로 바뀌지는 않습니다. <strong>변경이 자녀의 복리, 즉 자녀의 안정적인 생활과 성장에 더 도움이 되는지가 핵심입니다.</strong></p></section><section id=\"section-info-1-sub-2\"><h3 class=\"subsection-title\">양육자 변경이 자녀의 복리에 부합하는지 판단하는 기준</h3><p class=\"case-text\">자녀가 누구와 살고 싶어 하는지는 중요한 판단 요소입니다. 다만 그 의사만으로 친권자와 양육자가 결정되는 것은 아닙니다. 이 사건에서 법원은 다음 사정을 함께 살폈습니다.</p>\n<ul class=\"case-list\"><li class=\"case-list-item\">자녀의 나이와 의사를 표현하게 된 경위</li><li class=\"case-list-item\">현재 양육환경에서 생활한 기간과 환경을 다시 바꿀 때의 정서적 부담</li><li class=\"case-list-item\">양측의 양육능력과 양육을 도와줄 수 있는 주변 환경</li></ul>\n<p class=\"case-text\">상대방은 자녀가 자신과 살고 싶다는 의사를 반복했다며 녹취록 등을 제출했습니다. 법원도 그러한 의사표현은 인정했습니다. 그러나 자녀가 이미 의뢰인과 상당 기간 생활하며 초등학교에 다니고 있다는 점과 생활환경을 다시 바꿀 때의 부담도 함께 고려했습니다.</p>\n<p class=\"case-text\">따라서 이 사건의 판단 포인트는 자녀의 의사표현 자체보다, <strong>그 의사를 포함한 여러 사정을 살폈을 때 양육환경을 바꾸는 것이 자녀에게 더 나은 선택인지</strong>에 있었습니다.</p></section></section><section class=\"section\" id=\"section-assistance\"><h2 class=\"section-title\">이혼소송 친권·양육자 지정 유지를 위한 YK 담당 변호사의 대응</h2><section id=\"section-assistance-sub-1\"><h3 class=\"subsection-title\">자녀 의사표현 경위를 검토해 양육자 지정 유지 주장</h3><p class=\"case-text\">YK 담당 변호사는 상대방이 제출한 녹취록과 자녀가 상대방과 살고 싶다는 의사를 반복한 사정을 살폈습니다. 다만 자녀의 의사와 함께 연령, 의사표현 경위도 고려해야 한다는 점에 초점을 맞췄습니다. 자녀의 뜻을 존중하되, <mark class=\"assistance-highlight\"><strong>양측의 양육능력과 보조양육환경을 종합해 판단해야 한다는 취지</strong></mark>로 양육자 지정 유지를 주장했습니다.</p></section><section id=\"section-assistance-sub-2\"><h3 class=\"subsection-title\">양육환경 변경에 따른 정서적 부담을 근거로 방어</h3><p class=\"case-text\">YK 담당 변호사는 자녀가 1심 판단에 따라 의뢰인에게 인도된 뒤 상당 기간 함께 생활하며 초등학교에 다니고 있다는 점을 강조했습니다. 양육환경을 다시 바꿀 때 생길 수 있는 정서적 부담도 함께 짚었습니다. 부모에 대한 선호뿐 아니라 <mark class=\"assistance-highlight\"><strong>현재 생활의 연속성과 자녀의 복리</strong></mark>를 중심으로 판단해야 한다는 대응이었습니다.</p></section></section><section class=\"section\" id=\"section-result\"><h2 class=\"section-title\">이혼소송 사건 결과 : 일부승소</h2><p class=\"case-text\">법원은 항소심에서도 <strong>의뢰인을 자녀의 친권자 및 양육자로 지정한 1심 판결을 유지</strong>했습니다. 양육비에 관한 상대방의 항소도 기각되어 1심 판단이 유지되었습니다. 다만 상대방이 의뢰인에게 지급할 위자료는 제3자가 지급한 위자료 원금을 공제해 약 2,300만원으로 감액되었습니다.</p>\n<div class=\"circled-result\"><p class=\"case-text\">① <strong>자녀가 의뢰인에게 인도된 뒤 상당 기간 함께 생활하며 초등학교에 다니고 있었던 점</strong></p><p class=\"case-text\">② <strong>양육환경을 다시 바꾸면 자녀에게 정서적 부담이 생길 수 있는 점</strong></p><p class=\"case-text\">③ <strong>자녀의 연령과 의사표현 경위, 양측의 양육능력과 보조양육환경을 함께 살폈을 때 양육자를 변경할 사정이 부족한 점</strong></p></div>\n<p class=\"case-text\">그 결과 의뢰인은 상대방의 변경 요구에도 자녀의 친권자 및 양육자 지위를 유지했습니다. 이번 사건은 YK 담당 변호사가 강조한 현재 양육환경의 안정성과 변경에 따른 정서적 부담이 법원의 판결에서도 중요하게 다뤄진 사례입니다.</p>\n<p class=\"case-text\"></p></section>\n    \n    <div class=\"tags\"><span class=\"tag\">이혼소송</span><span class=\"tag\">양육권분쟁</span><span class=\"tag\">친권자지정</span><span class=\"tag\">양육환경</span><span class=\"tag\">가사</span></div>\n  </main>\n</article>\n\n\n  \n\n</div>"}