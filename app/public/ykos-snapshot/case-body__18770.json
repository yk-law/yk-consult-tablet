color: #fff; background: #102169; }\n.case-role-value { padding: 5px 9px; color: #102169; background: #f3f6ff; }\n.case-summary-table { width: 100%; border-collapse: collapse; table-layout: fixed; font-size: 15px; }\n.case-summary-label, .case-summary-value { border-top: 1px solid #e5eaf3; padding: 11px 0; vertical-align: top; text-align: left; }\n.case-summary-row-first { border-top: 0; }\n.case-summary-label { width: 118px; color: #1a2744; font-weight: 800; }\n.case-summary-value { color: #374151; font-weight: 600; }\n.toc { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: 24px 32px; margin-bottom: 20px; }\n.toc-title { font-size: 11px; font-weight: 700; letter-spacing: 2px; color: #9ca3af; text-transform: uppercase; margin-bottom: 14px; }\n.toc-list { list-style: none; padding: 0; margin: 0; }\n.toc-item { margin-bottom: 8px; font-size: 16px; }\n.toc-link { color: #102169; font-weight: 600; text-decoration: none; }\n.toc .toc-sub { margin: 4px 0 0 18px; }\n.toc .toc-sub .toc-link { color: #4b5563; font-size: 15px; font-weight: 400; }\n.section { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: 36px 40px; margin-bottom: 20px; }\n.section-title { color: #1a2744; font-size: 22px; font-weight: 700; line-height: 1.4; margin: 0 0 18px; }\n.subsection-title { color: #2d4a8a; font-size: 18px; font-weight: 700; line-height: 1.4; margin: 24px 0 10px; }\n.case-text { color: #374151; font-size: 17px; margin: 0 0 14px; }\n.case-list { list-style-type: disc; padding-left: 1.5rem; margin: 10px 0 14px; }\n.case-list-item { color: #374151; margin-bottom: 6px; font-weight: 800; }\n.assistance-highlight { background: linear-gradient(transparent 58%, #fde68a 58%); padding: 0 2px; font-weight: 800; color: #1f2937; }\n.public-text-issue { background: #fee2e2; color: #991b1b; border: 1px solid #ef4444; border-radius: 4px; box-shadow: 0 0 0 2px rgba(239, 68, 68, 0.16); padding: 0 3px; font-weight: 900; }\n.ref-box, .def-box, .qna-box, .order-box { background: #f9fafb; border-left: 4px solid #102169; border-radius: 4px; padding: 16px 20px; margin: 16px 0; font-size: 15px; }\n.case-table { width: 100%; border-collapse: collapse; margin: 16px 0 20px; font-size: 15px; table-layout: fixed; }\n.case-table-head, .case-table-cell { border: 1px solid #dbe1ee; padding: 10px 12px; vertical-align: top; word-break: keep-all; }\n.case-table-head { background: #f3f6fb; color: #1a2744; font-weight: 700; }\n.assistance-image { margin: 24px 0 4px; aspect-ratio: 16 / 9; overflow: hidden; border-radius: 8px; border: 1px solid #e5e7eb; }\n.assistance-image-img { display: block; width: 100%; height: 100%; object-fit: cover; border: 0; }\n.result-cta { background: #15266f; border-radius: 8px; padding: 28px 36px; margin-top: 28px; margin-bottom: 0; color: #fff; }\n.result-cta-text { color: #fff; font-size: 16px; font-weight: 700; line-height: 1.65; margin: 0 0 20px; }\n.result-cta-button { display: inline-block; background: #fff; color: #15266f; text-decoration: none; font-size: 15px; font-weight: 800; padding: 12px 22px; border-radius: 7px; }\n.result-cta + .tags { margin-top: 40px; }\n.footer-note { text-align: center; font-size: 14px; color: #9ca3af; padding: 20px 24px 40px; margin: 0; }\n@page { margin: 12mm; }\n/* 모바일만: 좌우 여백을 살짝 줄여 본문 폭 확보. PC 레이아웃은 유지. */\n@media (max-width: 720px) {\n  .preview-header { padding: 28px 18px; }\n  .preview-container { padding: 20px 12px 56px; }\n  .section { padding: 26px 16px; }\n  .section-title { font-size: 20px; }\n  .subsection-title { font-size: 17px; }\n  .case-text { font-size: 16px; }\n  .toc { padding: 18px 16px; }\n  .case-summary-card { padding: 18px 16px; }\n  .case-summary-table { font-size: 14px; }\n  .case-summary-label { width: 96px; }\n  .ref-box, .def-box, .qna-box, .order-box { padding: 14px 14px; }\n  .result-cta { padding: 22px 18px; }\n}\n@media (max-width: 768px) {\n  .preview-header .preview-lead { font-size: 22px; line-height: 1.4; }\n}\n@media print {\n  .preview-result, .preview-result { background: #f8fafc !important; }\n  .preview-header, .result-cta, .case-role-label, .case-table-head, .tag, .case-role-value, .ref-box, .def-box, .qna-box, .order-box {\n    -webkit-print-color-adjust: exact !important;\n    print-color-adjust: exact !important;\n  }\n  .preview-container { padding-bottom: 40px; }\n  .section, .toc, .case-summary-card, .result-cta { break-inside: avoid; page-break-inside: avoid; }\n  .result-cta + .tags { margin-top: 42px; }\n}\n}</style><div data-embedded-case-html-root=\"\" class=\"\" style=\"display:block;width:100%;min-width:0;box-sizing:border-box;\">\n\n<article class=\"preview-result\">\n  <header class=\"preview-header\">\n    <div class=\"label\">YK SUCCESS CASE</div>\n    <p class=\"preview-lead\">의뢰인은 코인 구매대행·매도 등의 명목으로 금전과 가상화폐를 받아 편취한 혐의로 기소되어 1심에서 실형을 선고받은 뒤, 기망행위와 편취의 고의 여부 및 형량을 다투며 항소했습니다.</p>\n  </header>\n  <main class=\"preview-container\">\n    <div class=\"lead\" id=\"section-overview\">\n<p class=\"case-text\">YK 담당 변호사는 항소심에서 피해자에게 약 7억 4,000만원 전액을 지급하고 합의한 사정과 다른 피해자들의 일부 피해 회복을 감형 사유로 제시했으며, 의뢰인은 실형이 선고된 부분에 대해 집행유예를 선고받았습니다.</p></div>\n    <section class=\"case-summary-card\" aria-label=\"사건 결과 요약\"><div class=\"case-summary-title\"><span>사건 결과 요약</span><span class=\"case-role-badges\"><span class=\"case-role-badge case-role-badge-client\"><span class=\"case-role-label\">의뢰인</span><span class=\"case-role-value\">피고인</span></span></span></div><table class=\"case-summary-table\"><tbody><tr><th class=\"case-summary-label case-summary-row-first\" scope=\"row\">사건 유형</th><td class=\"case-summary-value case-summary-row-first\">일반사기</td></tr><tr><th class=\"case-summary-label\" scope=\"row\">쟁점</th><td class=\"case-summary-value\">피해금 전액 지급 및 합의, 피해자의 처벌불원 의사, 코인 반환에 따른 일부 피해 회복</td></tr><tr><th class=\"case-summary-label\" scope=\"row\">결과</th><td class=\"case-summary-value\">집행유예</td></tr><tr><th class=\"case-summary-label\" scope=\"row\">대응 포인트</th><td class=\"case-summary-value\">피해자별 피해 회복 범위와 합의·처벌불원 의사를 구분해 항소심 감형 사유로 소명</td></tr></tbody></table></section><div data-case-cta-slot=\"top\"></div>\n    <nav class=\"toc\"><div class=\"toc-title\">CONTENTS</div><ul class=\"toc-list\"><li class=\"toc-item\"><a class=\"toc-link\">가상화폐 사기로 1심 실형을 선고받은 경위</a></li><li class=\"toc-item\"><a class=\"toc-link\">일반사기 재범 항소심 판단 기준</a><ul class=\"toc-list toc-sub\"><li class=\"toc-item\"><a class=\"toc-link\">항소심의 개념</a></li><li class=\"toc-item\"><a class=\"toc-link\">항소심 판단요소</a></li></ul></li><li class=\"toc-item\"><a class=\"toc-link\">일반사기 재범 처벌 수위와 양형요소</a><ul class=\"toc-list toc-sub\"><li class=\"toc-item\"><a class=\"toc-link\">처벌 수위와 적용 법령</a></li><li class=\"toc-item\"><a class=\"toc-link\">양형기준과 감경·가중요소</a></li></ul></li><li class=\"toc-item\"><a class=\"toc-link\">가상화폐 사기 항소심 집행유예를 위한 YK 담당 변호사의 조력</a><ul class=\"toc-list toc-sub\"><li class=\"toc-item\"><a class=\"toc-link\">피해자와의 합의를 바탕으로 처벌불원 의사 소명</a></li><li class=\"toc-item\"><a class=\"toc-link\">코인 반환에 따른 피해 회복 내역 정리</a></li></ul></li><li class=\"toc-item\"><a class=\"toc-link\">일반사기 사건 결과 : 집행유예</a></li></ul></nav>\n    <section class=\"section\" id=\"section-background\"><h2 class=\"section-title\">가상화폐 사기로 1심 실형을 선고받은 경위</h2><p class=\"case-text\">의뢰인은 코인 구매대행·매도 등의 명목으로 피해자에게서 약 7억 원을, 다른 피해자들에게서 약 5,000만 원 상당의 가상화폐를 받은 뒤 사기 혐의로 기소됐습니다.</p>\n<p class=\"case-text\">1심 법원은 피해자 진술과 카카오톡 대화, 받은 돈을 당초 용도와 달리 제3자에게 송금한 사실 등을 근거로 유죄를 인정하고 <strong>실형을 선고했습니다.</strong></p>\n<p class=\"case-text\">의뢰인은 코인 가격의 상승 전망을 설명했을 뿐, 피해자들을 속이거나 금전과 코인을 가로챌 의도는 없었다고 주장했습니다.</p>\n<p class=\"case-text\">이에 <strong>기망행위와 편취의 고의 여부, 형량을 다투며 항소</strong>했고, 항소심에서 주장과 증거 및 양형 사정을 정리하기 위해 YK 담당 변호사의 조력을 구했습니다.</p><figure class=\"assistance-image\"><img class=\"assistance-image-img\" src=\"https://www.yklawfirm.co.kr/ai_case/18770/031ce335fc5a6a3d.webp\" alt=\"가상화폐사기 1심 실형 후 항소심 피해액 변제와 합의로 감형 대응\"></figure></section><section class=\"section\" id=\"section-info-1\"><h2 class=\"section-title\">일반사기 재범 항소심 판단 기준</h2><section id=\"section-info-1-sub-1\"><h3 class=\"subsection-title\">항소심의 개념</h3><p class=\"case-text\">항소심은 1심 판결에 불복해 상급 법원의 판단을 받는 절차입니다. 사실을 잘못 판단했는지, 선고한 형이 지나치게 무거운지 등 항소 이유를 중심으로 살펴봅니다.</p>\n<div class=\"ref-box\"><span class=\"ref-title\">합의의 양형상 의미는 <strong><a rel=\"noopener noreferrer\">사기죄 합의 안하면 형량은? 사기죄 합의 중요성</a></strong>에서 확인하세요.</span><span class=\"ref-body\"></span></div>\n<p class=\"case-text\">이 사건에서 의뢰인은 편취의 고의 등을 부인하면서 형량도 다퉜습니다. <strong>유죄 판단을 다투는 문제와 형량을 다투는 문제는 구분해서 살펴야 합니다.</strong></p></section><section id=\"section-info-1-sub-2\"><h3 class=\"subsection-title\">항소심 판단요소</h3><p class=\"case-text\">사기죄의 유죄 여부를 다툴 때는 돈이나 코인을 받을 당시의 설명, 약속을 이행할 의사와 능력, 거래 당시 대화와 실제 자금 사용 내역 등을 살펴봅니다.</p>\n<p class=\"case-text\">이 사건에서는 피해자들의 진술, 카카오톡 대화, 받은 돈을 당초 용도와 달리 제3자에게 송금한 사실, 손실 보상 각서가 판단 근거가 됐습니다. 항소심은 이를 토대로 의뢰인의 사실관계 주장을 받아들이지 않았습니다.</p>\n<p class=\"case-text\">형량 판단에서는 <strong>1심 이후 피해 회복이나 합의 등 달라진 사정</strong>이 중요합니다. 이 사건에서도 피해금 전액 지급과 합의, 다른 피해자들의 일부 회복이 검토됐습니다. 다만 합의가 유죄 판단까지 없애는 것은 아닙니다.</p>\n<p class=\"case-text\">이미 고려된 사정만 반복하는 경우 형이 바뀌지 않을 수 있습니다. 처벌 전력과 별도로 확정된 범죄가 있다면 함께 재판받았을 경우와의 형평도 검토합니다. 이 사건의 일부 항소는 기존 판단을 바꿀 새로운 사정이 없다는 이유로 받아들여지지 않았습니다.</p></section></section><section class=\"section\" id=\"section-info-2\"><h2 class=\"section-title\">일반사기 재범 처벌 수위와 양형요소</h2><section id=\"section-info-2-sub-1\"><h3 class=\"subsection-title\">처벌 수위와 적용 법령</h3><p class=\"case-text\">사기죄는 사람을 속여 재물이나 재산상 이익을 얻은 경우 성립합니다. 이 사건에는 행위 당시의 <strong>구 형법 제347조 제1항에 따라 10년 이하의 징역 또는 2천만 원 이하의 벌금</strong>이 적용됐습니다. 이는 개정 후 법정형과 구분해야 합니다.</p>\n<p class=\"case-text\">여러 사기 범행을 함께 처벌하는 부분에는 형법 제37조 전단, 제38조 제1항 제2호, 제50조가 적용됐습니다. 여러 죄의 형량을 단순히 더하는 것이 아니라 법에서 정한 범위 안에서 형을 정합니다.</p>\n<p class=\"case-text\">별도 사기 범행은 이미 판결이 확정된 죄와 형법 제37조 후단의 관계에 있어, 함께 재판받았을 때와의 형평이 고려됐습니다.</p></section><section id=\"section-info-2-sub-2\"><h3 class=\"subsection-title\">양형기준과 감경·가중요소</h3><table class=\"case-table\"><thead><tr><th class=\"case-table-head\">구분</th><th class=\"case-table-head\">감경요소</th><th class=\"case-table-head\">가중요소</th></tr></thead><tbody><tr><td class=\"case-table-cell\">행위</td><td class=\"case-table-cell\">참작할 만한 범행 경위, 피해나 위험이 낮은 사정</td><td class=\"case-table-cell\">위험성이나 피해가 큰 사정</td></tr><tr><td class=\"case-table-cell\">행위자·기타</td><td class=\"case-table-cell\">반성, 피해 회복, 재범 방지 노력</td><td class=\"case-table-cell\">재범, 증거은폐, 범행 후 정황이 불리한 사정</td></tr></tbody></table>\n<p class=\"case-text\">양형기준은 법원이 형량을 정할 때 참고하는 기준입니다. 일반사기에서는 피해 규모와 범행 수법, 피해 회복 정도, 처벌 이력 등을 함께 살핍니다.</p>\n<ul class=\"case-list\"><li class=\"case-list-item\"><strong>감경요소:</strong> 피해 회복, 피해자의 처벌불원, 진지한 반성 등이 고려됩니다. 실제로 피해가 얼마나 회복됐는지도 중요합니다.</li><li class=\"case-list-item\"><strong>가중요소:</strong> 불량한 범행 수법, 여러 피해자를 상대로 한 범행, 일반사기 전력 등이 불리하게 작용할 수 있습니다. 벌금형 전력과 법률상 누범은 구분해야 합니다.</li></ul>\n<p class=\"case-text\">이 사건에서는 거액의 피해와 기망 내용, 같은 범죄로 두 차례 벌금형을 받은 이력이 불리한 사정이었습니다. 반면 피해자 한 명에게 <strong>7억 3,900만 원 전액을 지급하고 합의해 피해자가 처벌을 원하지 않은 점</strong>이 고려됐습니다. 다른 피해자들이 코인을 지급받아 약 1,500만 원 상당을 회수한 점도 반영됐습니다.</p>\n<p class=\"case-text\">합의는 양형요소이며, 합의만으로 특정 결과가 보장되지는 않습니다.</p></section></section><section class=\"section\" id=\"section-assistance\"><h2 class=\"section-title\">가상화폐 사기 항소심 집행유예를 위한 YK 담당 변호사의 조력</h2><section id=\"section-assistance-sub-1\"><h3 class=\"subsection-title\">피해자와의 합의를 바탕으로 처벌불원 의사 소명</h3><p class=\"case-text\">YK 담당 변호사는 항소심에서 <mark class=\"assistance-highlight\"><strong>피해자 1명에게 피해금 약 7억 4,000만원 전액을 지급하고 합의한 사실</strong></mark>을 감형 사유로 제시했습니다. 해당 피해자가 의뢰인의 처벌을 원하지 않는다는 의사도 함께 주장했습니다. 유죄 여부와 별개로, 1심 이후 이루어진 피해 회복과 합의가 형량 판단에 반영되도록 하기 위한 조력이었습니다.</p></section><section id=\"section-assistance-sub-2\"><h3 class=\"subsection-title\">코인 반환에 따른 피해 회복 내역 정리</h3><p class=\"case-text\">YK 담당 변호사는 다른 피해자들이 코인을 지급받아 <mark class=\"assistance-highlight\"><strong>약 1,500만 원 상당을 회수한 사정</strong></mark>을 제시했습니다. 전액 지급·합의가 이루어진 피해자와 일부 회복에 그친 피해자들의 회복 범위를 구분해 설명하고, 실제 회복된 부분을 감형에 참작해 달라고 요청했습니다.</p></section></section><section class=\"section\" id=\"section-result\"><h2 class=\"section-title\">일반사기 사건 결과 : 집행유예</h2><p class=\"case-text\">항소심 법원은 의뢰인에게 1심에서 실형이 선고된 부분을 변경해 <strong>집행유예를 선고했습니다.</strong></p>\n<div class=\"circled-result\"><p class=\"case-text\">① <strong>항소심에서 피해자 1명에게 피해금 전액을 지급하고 합의한 점</strong></p><p class=\"case-text\">② <strong>합의한 피해자가 의뢰인의 처벌을 원하지 않는다는 의사를 밝힌 점</strong></p><p class=\"case-text\">③ <strong>다른 피해자들도 코인을 지급받아 일부 피해를 회복한 점</strong></p></div>\n<p class=\"case-text\">피해금 전액 지급과 합의, 코인 지급을 통한 일부 피해 회복이 항소심에서 감형 사유로 인정된 사례입니다.</p>\n<p class=\"case-text\"></p></section>\n    \n    <div class=\"tags\"><span class=\"tag\">가상화폐사기</span><span class=\"tag\">사기항소심</span><span class=\"tag\">피해자합의</span><span class=\"tag\">집행유예</span><span class=\"tag\">형사</span><span class=\"tag\">일반사기</span></div>\n  </main>\n</article>\n\n\n  \n\n</div>"}