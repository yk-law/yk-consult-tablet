x { background: #f9fafb; border-left: 4px solid #102169; border-radius: 4px; padding: 16px 20px; margin: 16px 0; font-size: 15px; }\n.case-table { width: 100%; border-collapse: collapse; margin: 16px 0 20px; font-size: 15px; table-layout: fixed; }\n.case-table-head, .case-table-cell { border: 1px solid #dbe1ee; padding: 10px 12px; vertical-align: top; word-break: keep-all; }\n.case-table-head { background: #f3f6fb; color: #1a2744; font-weight: 700; }\n.assistance-image { margin: 24px 0 4px; aspect-ratio: 16 / 9; overflow: hidden; border-radius: 8px; border: 1px solid #e5e7eb; }\n.assistance-image-img { display: block; width: 100%; height: 100%; object-fit: cover; border: 0; }\n.result-cta { background: #15266f; border-radius: 8px; padding: 28px 36px; margin-top: 28px; margin-bottom: 0; color: #fff; }\n.result-cta-text { color: #fff; font-size: 16px; font-weight: 700; line-height: 1.65; margin: 0 0 20px; }\n.result-cta-button { display: inline-block; background: #fff; color: #15266f; text-decoration: none; font-size: 15px; font-weight: 800; padding: 12px 22px; border-radius: 7px; }\n.result-cta + .tags { margin-top: 40px; }\n.footer-note { text-align: center; font-size: 14px; color: #9ca3af; padding: 20px 24px 40px; margin: 0; }\n@page { margin: 12mm; }\n/* 모바일만: 좌우 여백을 살짝 줄여 본문 폭 확보. PC 레이아웃은 유지. */\n@media (max-width: 720px) {\n  .preview-header { padding: 28px 18px; }\n  .preview-container { padding: 20px 12px 56px; }\n  .section { padding: 26px 16px; }\n  .section-title { font-size: 20px; }\n  .subsection-title { font-size: 17px; }\n  .case-text { font-size: 16px; }\n  .toc { padding: 18px 16px; }\n  .case-summary-card { padding: 18px 16px; }\n  .case-summary-table { font-size: 14px; }\n  .case-summary-label { width: 96px; }\n  .ref-box, .def-box, .qna-box, .order-box { padding: 14px 14px; }\n  .result-cta { padding: 22px 18px; }\n}\n@media (max-width: 768px) {\n  .preview-header .preview-lead { font-size: 22px; line-height: 1.4; }\n}\n@media print {\n  .preview-result, .preview-result { background: #f8fafc !important; }\n  .preview-header, .result-cta, .case-role-label, .case-table-head, .tag, .case-role-value, .ref-box, .def-box, .qna-box, .order-box {\n    -webkit-print-color-adjust: exact !important;\n    print-color-adjust: exact !important;\n  }\n  .preview-container { padding-bottom: 40px; }\n  .section, .toc, .case-summary-card, .result-cta { break-inside: avoid; page-break-inside: avoid; }\n  .result-cta + .tags { margin-top: 42px; }\n}\n}</style><div data-embedded-case-html-root=\"\" class=\"\" style=\"display:block;width:100%;min-width:0;box-sizing:border-box;\">\n\n<article class=\"preview-result\">\n  <header class=\"preview-header\">\n    <div class=\"label\">YK SUCCESS CASE</div>\n    <p class=\"preview-lead\">의뢰인은 운전 중 갓길에서 화물차의 적재물을 고정하던 피해자를 충격해 약 8주간의 치료가 필요한 상해를 입히고도 구호 조치 없이 현장을 떠나 도주치상과 사고후미조치 혐의로 재판을 받았습니다. YK 담당 변호사는 피해자와의 합의 및 처벌불원 의사, 의뢰인의 범행 인정과 반성, 뺑소니(도주치사상) 전력이 없다는 사정을 양형 사유로 소명했으며, 의뢰인은 집행유예를 선고받았습니다.</p>\n  </header>\n  <main class=\"preview-container\">\n    <section class=\"case-summary-card\" aria-label=\"사건 결과 요약\"><div class=\"case-summary-title\"><span>사건 결과 요약</span><span class=\"case-role-badges\"><span class=\"case-role-badge case-role-badge-client\"><span class=\"case-role-label\">의뢰인</span><span class=\"case-role-value\">피고인</span></span></span></div><table class=\"case-summary-table\"><tbody><tr><th class=\"case-summary-label case-summary-row-first\" scope=\"row\">사건 유형</th><td class=\"case-summary-value case-summary-row-first\">뺑소니(도주치사상)</td></tr><tr><th class=\"case-summary-label\" scope=\"row\">쟁점</th><td class=\"case-summary-value\">범행 인정과 반성, 피해자 합의와 처벌불원, 과거 처벌 이력의 양형 반영</td></tr><tr><th class=\"case-summary-label\" scope=\"row\">결과</th><td class=\"case-summary-value\">집행유예</td></tr><tr><th class=\"case-summary-label\" scope=\"row\">대응 포인트</th><td class=\"case-summary-value\">범행 인정과 반성, 합의와 처벌불원, 과거 처벌 이력을 중심으로 유리한 양형 사유 소명</td></tr></tbody></table></section><div data-case-cta-slot=\"top\"></div>\n    <nav class=\"toc\"><div class=\"toc-title\">CONTENTS</div><ul class=\"toc-list\"><li class=\"toc-item\"><a class=\"toc-link\">뺑소니 사고로 재판을 받게 된 의뢰인</a></li><li class=\"toc-item\"><a class=\"toc-link\">뺑소니(도주치사상) 처벌 수위와 양형요소</a><ul class=\"toc-list toc-sub\"><li class=\"toc-item\"><a class=\"toc-link\">처벌 수위와 적용 법령</a></li><li class=\"toc-item\"><a class=\"toc-link\">양형기준과 감경·가중요소</a></li></ul></li><li class=\"toc-item\"><a class=\"toc-link\">뺑소니 집행유예를 위한 YK 담당 변호사의 조력</a><ul class=\"toc-list toc-sub\"><li class=\"toc-item\"><a class=\"toc-link\">범행을 인정하고 반성하는 태도 소명</a></li><li class=\"toc-item\"><a class=\"toc-link\">피해자와의 합의에 따른 처벌불원 의사 정리</a></li></ul></li><li class=\"toc-item\"><a class=\"toc-link\">뺑소니(도주치사상) 사건 결과 : 집행유예</a></li></ul></nav>\n    <section class=\"section\" id=\"section-background\"><h2 class=\"section-title\">뺑소니 사고로 재판을 받게 된 의뢰인</h2><p class=\"case-text\">의뢰인은 승용차를 운전하던 중 도로 우측 갓길에서 화물차 적재물을 고정하던 피해자를 충격했습니다.</p>\n<p class=\"case-text\">이 사고로 피해자는 약 8주간의 치료가 필요한 상해를 입었고, 화물차의 사이드미러도 파손됐습니다.</p>\n<p class=\"case-text\">그러나 의뢰인은 즉시 정차해 피해자를 구호하는 등 필요한 조치를 하지 않은 채 현장을 떠났습니다.</p>\n<p class=\"case-text\">이후 <strong>사람을 다치게 하고 도주한 혐의와 사고 후 필요한 조치를 하지 않은 혐의</strong>로 재판을 받게 됐습니다.</p>\n<p class=\"case-text\">의뢰인은 사고 경위와 현장을 떠난 이후의 행동에 관해 법적 판단을 받아야 하는 상황에서, 재판에 대응하기 위해 YK 담당 변호사의 도움을 받게 됐습니다.</p><figure class=\"assistance-image\"><img class=\"assistance-image-img\" src=\"https://www.yklawfirm.co.kr/ai_case/17254/1e9acffee3660493.webp\" alt=\"뺑소니 도주치상과 사고 후 미조치 혐의 재판 대응\"></figure></section><section class=\"section\" id=\"section-info-1\"><h2 class=\"section-title\">뺑소니(도주치사상) 처벌 수위와 양형요소</h2><section id=\"section-info-1-sub-1\"><h3 class=\"subsection-title\">처벌 수위와 적용 법령</h3><p class=\"case-text\">교통사고로 사람을 다치게 한 뒤 필요한 구호 조치 없이 도주하면 특정범죄 가중처벌 등에 관한 법률이 적용될 수 있습니다. 사고를 낸 과실뿐 아니라 <strong>사고 이후 구호 의무를 이행하지 않고 도주한 행위</strong>까지 무겁게 평가하는 것입니다.</p>\n<div class=\"ref-box\"><span class=\"ref-title\">관련 쟁점은 <strong><a rel=\"noopener noreferrer\">특정범죄가중처벌법(특가법) 적용 범죄와 처벌 수위</a></strong>에서 확인하실 수 있습니다.</span><span class=\"ref-body\"></span></div>\n<p class=\"case-text\">이 사건에는 특정범죄 가중처벌 등에 관한 법률 제5조의3 제1항 제2호와 형법 제268조가 적용됐습니다. 피해자가 다친 사고이므로 도주치상에 해당합니다. 차량을 파손하고도 필요한 조치를 하지 않은 행위에는 도로교통법 제148조와 제54조 제1항이 적용됐습니다.</p>\n<p class=\"case-text\">법원은 벌금형이 아닌 징역형을 선택했습니다. 다만 형의 집행을 유예할지는 피해 정도와 합의 여부, 범죄 이력 등 여러 사정을 함께 살펴 판단했습니다.</p></section><section id=\"section-info-1-sub-2\"><h3 class=\"subsection-title\">양형기준과 감경·가중요소</h3><p class=\"case-text\">형량을 정할 때는 사고 경위, 피해 정도, 사고 후 행동을 살펴봅니다. 범행 인정과 반성, 피해자와의 합의, 과거 처벌 이력도 중요한 판단 요소입니다.</p>\n<table class=\"case-table\"><thead><tr><th class=\"case-table-head\">구분</th><th class=\"case-table-head\">유리하게 고려된 사정</th><th class=\"case-table-head\">불리하게 고려된 사정</th></tr></thead><tbody><tr><td class=\"case-table-cell\">피해 및 사고 후 행동</td><td class=\"case-table-cell\">피해자와 합의하고 피해자가 처벌을 원하지 않은 점</td><td class=\"case-table-cell\">약 8주간의 치료가 필요한 상해를 입히고도 필요한 조치 없이 도주한 점</td></tr><tr><td class=\"case-table-cell\">반성 및 범죄 이력</td><td class=\"case-table-cell\">뒤늦게나마 범행을 인정하고 반성한 점, 뺑소니(도주치사상) 전력이나 벌금형보다 무거운 처벌 이력이 없는 점</td><td class=\"case-table-cell\">범행 경위와 이후 정황</td></tr></tbody></table>\n<p class=\"case-text\"><strong>과거 처벌 이력만으로 형량이 일률적으로 정해지는 것은 아닙니다.</strong> 이전 범죄의 내용과 처벌 수준, 이번 사건의 피해와 범행 후 정황 등을 함께 살펴야 합니다.</p>\n<p class=\"case-text\">이 사건에서 법원은 사고로 발생한 피해와 아무런 조치 없이 도주한 점을 불리하게 평가했습니다. 반면 범행 인정과 반성, 피해자와의 합의 및 처벌을 원하지 않는 의사, 과거 처벌 이력은 유리하게 고려했습니다.</p>\n<p class=\"case-text\">그 결과 의뢰인에게 징역 1년 8월에 집행유예 2년을 선고하고, 사회봉사 120시간과 준법운전강의 수강 40시간을 명했습니다. 의뢰인에게 뺑소니(도주치사상) 전력이 없었다는 점에서 <strong>뺑소니 재범 사례와는 구분해 살펴봐야 합니다.</strong></p></section></section><section class=\"section\" id=\"section-assistance\"><h2 class=\"section-title\">뺑소니 집행유예를 위한 YK 담당 변호사의 조력</h2><section id=\"section-assistance-sub-1\"><h3 class=\"subsection-title\">범행을 인정하고 반성하는 태도 소명</h3><p class=\"case-text\">YK 담당 변호사는 사고 후 구호 조치 없이 도주한 잘못을 전제로, <mark class=\"assistance-highlight\"><strong>의뢰인이 뒤늦게나마 범행을 인정하고 반성하고 있다는 점</strong></mark>을 양형 사유로 소명했습니다. 뺑소니(도주치사상) 전력이 없고, 벌금형보다 무거운 처벌을 받은 이력도 없다는 사정을 함께 강조했습니다. 범행의 책임을 축소하기보다 잘못을 인정하는 태도와 과거 처벌 이력이 형을 정할 때 함께 고려되도록 하기 위한 조력이었습니다.</p></section><section id=\"section-assistance-sub-2\"><h3 class=\"subsection-title\">피해자와의 합의에 따른 처벌불원 의사 정리</h3><p class=\"case-text\">YK 담당 변호사는 <mark class=\"assistance-highlight\"><strong>피해자와 원만히 합의했고 피해자가 의뢰인의 처벌을 원하지 않는다는 점</strong></mark>을 재판에서 참작해 달라고 요청했습니다. 피해자가 약 8주간의 치료가 필요한 상해를 입은 만큼, 합의 사실과 처벌을 원하지 않는 의사를 양형 사유로 분명히 주장했습니다. 합의만으로 책임이 없어지는 것은 아니지만, 피해자와 합의에 이른 사정도 형을 정하는 데 반영될 필요가 있었기 때문입니다.</p></section></section><section class=\"section\" id=\"section-result\"><h2 class=\"section-title\">뺑소니(도주치사상) 사건 결과 : 집행유예</h2><p class=\"case-text\">법원은 다음 사정을 유리하게 참작해 의뢰인에게 <strong>집행유예 판결을 선고했습니다.</strong></p>\n<div class=\"circled-result\"><p class=\"case-text\">① <strong>의뢰인이 뒤늦게나마 범행을 인정하고 반성한 점</strong></p><p class=\"case-text\">② <strong>피해자와 원만히 합의해 피해자가 의뢰인의 처벌을 원하지 않은 점</strong></p><p class=\"case-text\">③ <strong>같은 범죄로 처벌받은 이력이 없고 벌금형보다 무거운 처벌을 받은 이력도 없는 점</strong></p></div>\n<p class=\"case-text\">이번 사건에서는 합의와 처벌불원 의사, 범행 인정과 반성, 과거 처벌 이력이 형을 정할 때 고려하는 다른 사정들과 함께 반영되었습니다.</p>\n<p class=\"case-text\"></p></section>\n    \n    <div class=\"tags\"><span class=\"tag\">뺑소니</span><span class=\"tag\">도주치상</span><span class=\"tag\">사고후미조치</span><span class=\"tag\">집행유예</span><span class=\"tag\">형사</span><span class=\"tag\">뺑소니(도주치사상)</span></div>\n  </main>\n</article>\n\n\n  \n\n</div>"}